@* A check and its words on one row of the properties window, the words a
   tap as the box is: Apply to every object, and whether a card's piece is
   shown. *@

<div class="@($"bz-dash-every {Class}")" title="@Title">
    <MudCheckBox T="bool" Value="Value" ValueChanged="ValueChanged" Size="Size.Small" Dense="true" Color="Color.Primary" aria-label="@Label" />
    <span class="bz-dash-every-words" @onclick="@(() => ValueChanged.InvokeAsync(!Value))"><MudText Typo="Typo.caption">@Label</MudText></span>
</div>

@code {
    [Parameter] public bool Value { get; set; }

    [Parameter] public EventCallback<bool> ValueChanged { get; set; }

    [Parameter, EditorRequired] public string Label { get; set; } = "";

    [Parameter] public string Title { get; set; } = "";

    [Parameter] public string Class { get; set; } = "";
}
