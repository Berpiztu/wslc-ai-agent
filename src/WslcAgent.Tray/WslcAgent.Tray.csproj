<Project Sdk="Microsoft.NET.Sdk">

  <!-- The installed agent's icon beside the clock: the agent runs with no
       console, and a click opens its own page (/agent: the System card over
       the log) in the browser. A program apart from the agent, so the agent
       stays the server it is. Windows only; installed under tray\ in the
       agent's folder, published self-contained beside it. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- A Windows 10 SDK version, for Windows' own notifications (toasts,
         WslcAgent.Toasts), which stay in the notification centre as the
         icon's balloons did not; the client's version. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>wslc-ai-agent-tray</AssemblyName>
    <RootNamespace>WslcAgent.Tray</RootNamespace>
    <ApplicationIcon>..\WslcAgent.Server\wslc-ai-agent.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- The agent's notifications, shown as Windows toasts: the same contracts
       and the same events stream the UI reads, and the toasts the Windows
       client shows too. -->
  <ItemGroup>
    <ProjectReference Include="..\WslcAgent.ApiClient\WslcAgent.ApiClient.csproj" />
    <ProjectReference Include="..\WslcAgent.Toasts\WslcAgent.Toasts.csproj" />
  </ItemGroup>

</Project>
