@* A volume or a container the agent backs up or restores: on its card, the
   ring where its avatar goes; in a table row, the bar in its first cell (Row).
   The same words and verbs in both, its log at the top and its cancel at the
   bottom; once it failed or was cancelled, red, saying why, its cross
   dismissing it. *@
@inject IDialogService Dialogs
@inject WslcAgentApi Api
@inject ISnackbar Snackbar

@if (Row)
{
    <ProgressCell Lead="Lead" Name="@(Name ?? Job.Name)" Indeterminate="true" Status="@Status" Failed="Job.Failed" Done="@(Job.State == "success")"
                  LogTitle="@LogTitle" CancelTitle="@CancelTitle" OnLog="LogAsync" OnCancel="CancelAsync" OnDismiss="DismissAsync" />
}
else
{
    <ProgressRing Pct="0" Status="@Status" Failed="Job.Failed" Done="@(Job.State == "success")"
                  LogTitle="@LogTitle" CancelTitle="@CancelTitle" OnLog="LogAsync" OnCancel="CancelAsync" OnDismiss="DismissAsync" />
}

@code {
    [Parameter, EditorRequired] public BackupKind Kind { get; set; } = default!;

    [Parameter, EditorRequired] public BackupJob Job { get; set; } = default!;

    /// <summary>In a table row's first cell, as a bar; else the ring of a card.</summary>
    [Parameter] public bool Row { get; set; }

    /// <summary>What the row's bar is named by: the volume or the container (a list of all of them), or what it does (one's own list); its name when not given.</summary>
    [Parameter] public string? Name { get; set; }

    /// <summary>What a list puts before a row's name (a project's mark), put before it here too.</summary>
    [Parameter] public RenderFragment? Lead { get; set; }

    /// <summary>After it was cancelled or dismissed: the page reads its list again.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    private string Said => BackupFlow.Said(Job.Kind).ToLowerInvariant();

    private string LogTitle => $"View the {Said} log";

    private string CancelTitle => $"Cancel the {Said}";

    private string Status => Job.Failed && Job.Error.Length > 0 ? Job.Error : $"{BackupFlow.Said(Job.Kind)}: {Job.Status}";

    private Task LogAsync() => BackupFlow.ShowLogAsync(Dialogs, Kind, Job);

    private async Task CancelAsync()
    {
        if (await BackupFlow.CancelAsync(Dialogs, Api, Snackbar, Kind, Job))
        {
            await Changed.InvokeAsync();
        }
    }

    private async Task DismissAsync()
    {
        await BackupFlow.DismissAsync(Api, Snackbar, Kind, Job);
        await Changed.InvokeAsync();
    }
}
