@* What a container's card says about it in words: its Id, its Status, its
   Ports, its Networks, when it was created and its image's tag, with the
   version its image says it is when it says one. The card's body draws them
   beside its dials (ContainerCardBody); the dashboard's details object draws
   them alone, the dials being objects of their own. *@

<div class="wslc-card-texts">
    <MudText Typo="Typo.body2" title="@Container.Id"><b>Id</b> @Container.Id</MudText>
    <MudText Typo="Typo.body2" title="@Container.Status"><b>Status</b> @Container.Status</MudText>
    <MudText Typo="Typo.body2"><b>Ports</b> <PortsLink Ports="Container.Ports" Container="@Container.Id" Publications="Container.Published" /></MudText>
    <MudText Typo="Typo.body2" title="@Container.Networks"><b>Networks</b> @Readings.Dash(Container.Networks)</MudText>
    @* When it was made and the version it runs: on the one line, which had the room, so the card keeps its
       height; one line as every line here is. *@
    <MudText Typo="Typo.caption" Class="mud-text-secondary" title="@Container.CreatedAt">Created @Container.RunningFor · @Version</MudText>
</div>

@code {
    [Parameter, EditorRequired] public ContainerSummary Container { get; set; } = default!;

    /// <summary>Its image's tag, and the version the image says it is when it says one the tag does not (<c>latest (1.4.2)</c>).</summary>
    private string Version
    {
        get
        {
            var tag = ImageReference.Split(Container.Image).Tag;
            return Container.ImageVersion is { Length: > 0 } version && version != tag ? $"{tag} ({version})" : tag;
        }
    }
}
