@* The Containers page's verbs in the round button: Run and Create, the one
   launch form in either mode. Drawn by the page, and by the dashboard while a
   container's card is selected. *@
@inherits PageVerbsBase
@using WslcAgent.UI.Components.Launch

<VerbFab StartIcon="@Icons.Material.Filled.PlayArrow" Label="Run" Color="Color.Success" OnClick="@(() => LaunchAsync(LaunchMode.Run))" Title="Run an image" />
<VerbFab StartIcon="@Icons.Material.Filled.Add" Label="Create" Color="Color.Primary" OnClick="@(() => LaunchAsync(LaunchMode.Create))" Title="Create a container" />

@code {
    private Task LaunchAsync(LaunchMode mode) =>
        OpenAsync<ContainerFormDialog>(mode == LaunchMode.Run ? "Run container" : "Create container",
            new DialogParameters<ContainerFormDialog> { { d => d.Mode, mode } }, large: true);
}
