@* The keys a phone's on-screen keyboard usually lacks, as Termux offers them
   under its terminal: rows of equal columns across the whole width (Layout,
   a terminal's two rows of seven by default), every key in sight at once.
   Ctrl and Alt are held as Termux holds them: pressed once they stay down,
   filled, for the next key — one of these or one typed on the keyboard — and
   let go after it; pressed again they let go at once. Shift, where a layout
   has it, is locked instead: it stays down, key after key, until it is
   pressed again. The keys only say what was pressed (OnKey, with the
   modifiers held) and which modifiers are down (Modifiers, which the host
   lets go of once it used them on a key typed elsewhere): what a key does is
   its host's, so they serve a terminal or any field that wants them. A press
   never takes the focus from where the user is typing, or the phone's
   keyboard would close at every key. *@

<div class="wslc-control-keys" role="toolbar" aria-label="Control keys"
     style="@($"--wslc-control-columns: {Columns}")"
     @onpointerdown:preventDefault="true" @onmousedown:preventDefault="true">
    @foreach (var row in Layout)
    {
        @foreach (var key in row)
        {
            @Key(key)
        }
    }
</div>

@code {
    /// <summary>The keys, row by row, every row on the same columns; a terminal's by default.</summary>
    [Parameter] public IReadOnlyList<IReadOnlyList<ControlKey>> Layout { get; set; } = ControlKeyNames.Terminal;

    /// <summary>The modifiers held down now.</summary>
    [Parameter] public ControlModifiers Modifiers { get; set; }

    [Parameter] public EventCallback<ControlModifiers> ModifiersChanged { get; set; }

    /// <summary>A key was pressed, with the modifiers held for it; Ctrl and Alt are let go after it, Shift stays.</summary>
    [Parameter] public EventCallback<ControlKeyPress> OnKey { get; set; }

    [Parameter] public bool Disabled { get; set; }

    private int Columns => Layout.Count == 0 ? 1 : Layout.Max(row => row.Count);

    private RenderFragment Key(ControlKey key)
    {
        var modifier = ControlKeyNames.ModifierOf(key);
        if (modifier != ControlModifiers.None)
        {
            return @<MudButton Size="Size.Small" Variant="@(Modifiers.HasFlag(modifier) ? Variant.Filled : Variant.Outlined)"
                               Color="@(Modifiers.HasFlag(modifier) ? Color.Primary : Color.Default)" Disabled="Disabled"
                               title="@ControlKeyNames.Title(key)" aria-label="@ControlKeyNames.Title(key)" aria-pressed="@Modifiers.HasFlag(modifier)"
                               OnClick="@(() => SetModifiersAsync(Modifiers ^ modifier))">@ControlKeyNames.Label(key)</MudButton>;
        }

        return @<MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" Disabled="Disabled"
                           title="@ControlKeyNames.Title(key)" aria-label="@ControlKeyNames.Title(key)"
                           OnClick="@(() => PressAsync(key))">@ControlKeyNames.Label(key)</MudButton>;
    }

    private async Task PressAsync(ControlKey key)
    {
        await OnKey.InvokeAsync(new ControlKeyPress(key, Modifiers));
        await SetModifiersAsync(Modifiers & ControlModifiers.Shift);
    }

    private async Task SetModifiersAsync(ControlModifiers modifiers)
    {
        if (modifiers == Modifiers)
        {
            return;
        }

        Modifiers = modifiers;
        await ModifiersChanged.InvokeAsync(modifiers);
    }
}
