@* The Accept window, opened from a container's or an image's Zaindari window:
   the accepting editor (AcceptEditor) as a form, Save its verb. *@

<FormDialog SubmitText="Save" BusyText="Saving…" OnSubmit="@(() => _editor.SaveAsync())">
    <AcceptEditor @ref="_editor" Report="Report" />
</FormDialog>

@code {
    [Parameter, EditorRequired] public ImageVulnerabilities Report { get; set; } = default!;

    private AcceptEditor _editor = default!;
}
