@* The Architecture window: an Archify diagram (wwwroot/archify,
   generated by the archify skill from its .architecture.json) over the whole
   window, in an iframe with Close in the title row. Its own page keeps the
   diagram's pan, zoom, search and guided views alive inside the dialog;
   nothing here touches it. It opens on the caller's diagram and the title row
   switches to the others without leaving the window: a reader of the control plane reaches the network one in one tap,
   not by closing, changing screen and opening again. *@
@inject WslcAgent.UI.Components.Styles.UiStyle Style

<MudDialog ContentClass="wslc-dialog-full">
    <TitleContent>
        <DialogTitle Title="@_current.Title">
            <Info>
                @* One key per diagram, the current one pressed: the application's own
                   choose-one control, as the table/cards keys (ViewModeToggle), in the
                   style Settings → Styles gives it. *@
                <MudToggleGroup T="string" Value="_current.File" ValueChanged="Show" Size="Style.Applied.ToggleSize" Color="Style.Applied.ToggleColor"
                                Outlined="Style.Applied.ToggleOutlined" Delimiters="Style.Applied.ToggleDelimiters"
                                Class="@(Style.Applied.ToggleRounded ? "rounded-pill" : null)" CheckMark="Style.Applied.ToggleCheckMark">
                    @foreach (var diagram in ArchitectureDiagrams.All)
                    {
                        <MudToggleItem @key="diagram.File" Value="@diagram.File" title="@diagram.Title">@diagram.Short</MudToggleItem>
                    }
                </MudToggleGroup>
            </Info>
            <ChildContent>
                <MudButton Size="Size.Small" Variant="Variant.Filled" OnClick="@(() => Dialog.Cancel())">Close</MudButton>
            </ChildContent>
        </DialogTitle>
    </TitleContent>
    <DialogContent>
        <iframe class="wslc-architecture-frame" src="@Source" title="@_current.Title" loading="lazy"></iframe>
    </DialogContent>
</MudDialog>

@code {
    private ArchitectureDiagrams.Diagram _current = ArchitectureDiagrams.Main;

    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    /// <summary>The diagram's file name under wwwroot/archify, without extension.</summary>
    [Parameter, EditorRequired] public string Diagram { get; set; } = "";

    /// <summary>
    /// present=1 is Archify's Presentation Stage: the diagram takes the whole
    /// frame and fits its height, where the default reader centres a fixed
    /// column. v=&lt;version&gt; makes a browser (and the client's WebView) fetch
    /// a regenerated diagram instead of replaying its cached copy: the file
    /// ships inside the UI assembly, so it changes only when that version does.
    /// </summary>
    private string Source =>
        $"_content/WslcAgent.UI/archify/{_current.File}.html?present=1&v={Uri.EscapeDataString(UiVersion.Current)}";

    protected override void OnParametersSet() => _current = ArchitectureDiagrams.ByFile(Diagram);

    /// <summary>The title row is MudBlazor's own tree: it repaints only when told (docs/ui-controls.md).</summary>
    private void Show(string file)
    {
        _current = ArchitectureDiagrams.ByFile(file);
        Dialog.StateHasChanged();
    }
}
