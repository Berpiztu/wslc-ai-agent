@* The window of backups, of volumes or of containers (BackupsView): one's own
   (its card's or its row's Backup & restore) that one alone, a page's every
   one, the list at the left. The title row holds the open tab's verbs and
   Close, which asks while a setting is not saved. Sized when it opens and
   never changes. *@

<MudDialog ContentClass="wslc-dialog-action wslc-dialog-tall">
    <TitleContent>
        <DialogTitle Title="@Dialog.Title">
            @_view?.Verbs
            <MudButton Size="Size.Small" Variant="Variant.Filled" OnClick="CloseAsync">Close</MudButton>
        </DialogTitle>
    </TitleContent>
    <DialogContent>
        <BackupsView @ref="_view" Kind="Kind" Name="@Name" Changed="@(() => Dialog.StateHasChanged())" />
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter, EditorRequired] public BackupKind Kind { get; set; } = default!;

    /// <summary>Whose window it is, alone; empty for all of them.</summary>
    [Parameter] public string Name { get; set; } = "";

    private BackupsView? _view;

    private async Task CloseAsync()
    {
        if (_view is null || await _view.LeavingAsync())
        {
            Dialog.Cancel();
        }
    }
}
