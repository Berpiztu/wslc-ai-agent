@* Build image: one dialog with two faces, the form and then the
   live output of the build the agent runs. Build and Close sit on the title
   line in every state; once a build runs Close becomes Cancel, which asks and
   then stops it. It cannot be left by Escape or a click outside while a build
   is under way. A Dockerfile can come instead of a folder: pasted in its field,
   or loaded into it from this device, as the launch form's Fill and Load JSON
   do; the agent writes it in a folder of its own and builds it (FROM and RUN,
   no COPY), which needs nothing on the agent's machine: an emergency's patch
   from a phone. *@
@implements IDisposable
@inject WslcAgentApi Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <DialogTitle Title="Build image">
            @if (!_finished)
            {
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="BuildAsync" Disabled="@(_job is not null)">Build</MudButton>
            }
            <MudButton Size="Size.Small" Variant="Variant.Filled" OnClick="CloseAsync">@(_job is null ? "Close" : "Cancel")</MudButton>
        </DialogTitle>
    </TitleContent>
    <DialogContent>
        @if (!_started)
        {
            <MudForm @ref="_form">
                <div class="wslc-field-pick has-note">
                    <MudTextField T="string" @bind-Value="_path" Label="Build context" Placeholder="folder containing the Dockerfile" Immediate="true"
                                  Required="@(!FromText)" RequiredError="A build context is required, or a Dockerfile below" Disabled="FromText"
                                  Variant="Variant.Filled" Margin="Margin.Dense" />
                    <MudFab Color="Color.Success" StartIcon="@Icons.Material.Filled.MoreVert" Size="Size.Small" title="Pick context folder" OnClick="PickContextAsync" Disabled="FromText" />
                </div>
                @* Or the Dockerfile itself: pasted here, or loaded into the field from this device. *@
                <div class="wslc-field-pick has-note mt-2">
                    <MudTextField T="string" @bind-Value="_dockerfileText" Label="Or a Dockerfile, pasted or loaded" Lines="6" Immediate="true"
                                  Placeholder="@DockerfileExample" HelperText="Built without a folder: FROM and RUN, no COPY. Paste it here, or load it from this device with the button."
                                  HelperTextOnFocus="true" Variant="Variant.Filled" Margin="Margin.Dense"
                                  autocapitalize="none" autocorrect="off" spellcheck="false" />
                    @* The field's own button, as every picker's: a direct child, so the field holds it. It opens the file picker kept hidden below. *@
                    <MudFab Color="Color.Success" StartIcon="@Icons.Material.Filled.UploadFile" Size="Size.Small" title="Load a Dockerfile from this device"
                            OnClick="@(() => _upload?.OpenFilePickerAsync() ?? Task.CompletedTask)" />
                </div>
                <MudFileUpload @ref="_upload" T="IBrowserFile" FilesChanged="LoadDockerfileAsync" Class="d-none">
                    <CustomContent></CustomContent>
                    <SelectedTemplate></SelectedTemplate>
                </MudFileUpload>
                <MudTextField T="string" @bind-Value="_tag" Label="Tag" Placeholder="myapp:latest" Variant="Variant.Filled" Margin="Margin.Dense" Class="mt-2" />
                <MudTextField T="string" @bind-Value="_dockerfile" Label="Dockerfile" Placeholder="Dockerfile" HelperText="Relative to the context, or an absolute path"
                              HelperTextOnFocus="true" Variant="Variant.Filled" Margin="Margin.Dense" Class="mt-2" />
                <MudTextField T="string" @bind-Value="_target" Label="Target stage" Placeholder="builder" HelperText="Multi-stage builds only"
                              HelperTextOnFocus="true" Variant="Variant.Filled" Margin="Margin.Dense" Class="mt-2" />
                <MudTextField T="string" @bind-Value="_buildArgs" Label="Build args" Placeholder="KEY=VALUE (one per line)" Lines="2" Sizing="InputSizing.Auto"
                              Variant="Variant.Filled" Margin="Margin.Dense" Class="mt-2" />
                <MudTextField T="string" @bind-Value="_labels" Label="Labels" Placeholder="key=value (one per line)" Lines="2" Sizing="InputSizing.Auto"
                              Variant="Variant.Filled" Margin="Margin.Dense" Class="mt-2" />
                <SquareCheckBox @bind-Value="_noCache" Label="No cache" />
                <SquareCheckBox @bind-Value="_pull" Label="Pull newer base images" />
            </MudForm>
        }
        else
        {
            @if (_finished)
            {
                <MudProgressLinear Value="100" Color="@(_state == "done" ? Color.Success : Color.Error)" />
            }
            else
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            <MudText Typo="Typo.body2" Class="my-1" role="status">@_status</MudText>
            <pre class="wslc-logs-output wslc-logs-pre wslc-logs-wrap">@((_truncated ? "… earlier output trimmed …\n" : "") + string.Join('\n', _output))</pre>
        }
    </DialogContent>
</MudDialog>

@code {
    private static readonly TimeSpan PollEvery = TimeSpan.FromMilliseconds(700);

    private MudForm? _form;

    /// <summary>The file picker the Dockerfile field's button opens; drawn nowhere.</summary>
    private MudFileUpload<IBrowserFile>? _upload;
    private string _path = "";

    /// <summary>A Dockerfile pasted or loaded from this device; when it has text, it is what is built and the folder is not asked for.</summary>
    private string _dockerfileText = "";

    private bool FromText => _dockerfileText.Trim().Length > 0;

    private const string DockerfileExample = "FROM ia-analys-analys\nUSER root\nRUN uv pip install --system --no-cache -U \"aiohttp>=3.13.6\"";
    private string _tag = "";
    private string _dockerfile = "";
    private string _target = "";
    private string _buildArgs = "";
    private string _labels = "";
    private bool _noCache;
    private bool _pull;

    private readonly CancellationTokenSource _stop = new();
    private string? _job;
    private bool _started;
    private bool _finished;
    private bool _built;
    private string _state = "";
    private string _status = "";
    private IReadOnlyList<string> _output = [];
    private bool _truncated;

    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    private async Task PickContextAsync()
    {
        if (await Pickers.HostFolderAsync(Dialogs, _path) is { } folder)
        {
            _path = folder;
        }
    }

    /// <summary>A Dockerfile from this device into its field, as Load JSON fills the launch form: seen, and changeable, before it is built.</summary>
    private async Task LoadDockerfileAsync(IBrowserFile? file)
    {
        if (file is null)
        {
            return;
        }

        try
        {
            using var reader = new StreamReader(file.OpenReadStream(maxAllowedSize: 1024 * 1024));
            _dockerfileText = await reader.ReadToEndAsync();
            Snackbar.Add($"Loaded {file.Name}", Severity.Success);
        }
        catch (IOException ex)
        {
            Snackbar.Add($"{file.Name} could not be read: {ex.Message}", Severity.Error);
        }
    }

    private async Task BuildAsync()
    {
        if (_form is null)
        {
            return;
        }

        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        _started = true;
        _status = "Starting…";
        try
        {
            var job = await Api.StartImageBuildAsync(FromText
                ? new BuildImageRequest("", _tag, "", _target, _buildArgs, _labels, _noCache, _pull, _dockerfileText)
                : new BuildImageRequest(_path, _tag, _dockerfile, _target, _buildArgs, _labels, _noCache, _pull));
            _job = job.Job;
            Repaint();
            _ = PollAsync(job.Job, _stop.Token);
        }
        catch (Exception ex) when (ex is AgentApiException or HttpRequestException)
        {
            Finish("error", ex.Message);
            Repaint();
        }
    }

    private async Task PollAsync(string job, CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(PollEvery);
        try
        {
            do
            {
                var state = await Api.GetImageBuildAsync(job, cancellationToken);
                _output = state.Output;
                _truncated = state.Truncated;
                if (state.State == "running")
                {
                    _status = $"Building{(state.Tag.Length > 0 ? " " + state.Tag : "")}…";
                }
                else if (state.State == "done")
                {
                    Finish("done", state.Tag.Length > 0 ? $"Built {state.Tag}" : "Build finished");
                }
                else
                {
                    Finish(state.State, state.Error.Length > 0 ? state.Error : $"Build {state.State}");
                }

                await InvokeAsync(Repaint);
            }
            while (!_finished && await timer.WaitForNextTickAsync(cancellationToken));
        }
        catch (OperationCanceledException)
        {
            // The dialog closed.
        }
        catch (Exception ex) when (ex is AgentApiException or HttpRequestException)
        {
            Finish("error", ex.Message);
            await InvokeAsync(Repaint);
        }
    }

    /// <summary>The title line (Build, Close or Cancel) is the dialog's own tree: it is repainted with the content.</summary>
    private void Repaint()
    {
        StateHasChanged();
        Dialog.StateHasChanged();
    }

    /// <summary>The job is dropped once it ends, so Close no longer offers to cancel a build that is over.</summary>
    private void Finish(string state, string message)
    {
        _state = state;
        _status = message;
        _finished = true;
        _job = null;
        if (state == "done")
        {
            _built = true;
            Snackbar.Add("Image built", Severity.Success);
        }
    }

    private async Task CloseAsync()
    {
        if (_job is { } job)
        {
            if (!await DialogFlow.ConfirmAsync(Dialogs, "Cancel build", "Cancel this build? The partial image layers are discarded.", "Cancel build", destructive: true))
            {
                return;
            }

            _job = null;
            await _stop.CancelAsync();
            try
            {
                await Api.CancelImageBuildAsync(job);
            }
            catch (Exception ex) when (ex is AgentApiException or HttpRequestException)
            {
                // The dialog is closing; the build ended on its own or is already gone.
            }
        }

        Dialog.Close(_built ? DialogResult.Ok(true) : DialogResult.Cancel());
    }

    public void Dispose()
    {
        _stop.Cancel();
        _stop.Dispose();
    }
}
