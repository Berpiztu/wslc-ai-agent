@* The log of a patch's build (any build job of the agent's), in the window a
   project's save log opens in (ProjectLogDialog) and drawn by the same view:
   what the build prints and what the check and the move say, the lines
   coloured by level, with the view's rail (search, levels, wrap, autorefresh,
   refresh, jump to end, copy). Close leaves the build running; Cancel, there
   while it runs, stops it, after asking: the containers it was to move run on
   as they were. *@
@inject WslcAgentApi Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<MudDialog ContentClass="wslc-dialog-action">
    <TitleContent>
        <DialogTitle Title="@Dialog.Title">
            @if (_running)
            {
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" OnClick="CancelAsync">Cancel</MudButton>
            }
            <MudButton Size="Size.Small" Variant="Variant.Filled" OnClick="@(() => Dialog.Cancel())">Close</MudButton>
        </DialogTitle>
    </TitleContent>
    <DialogContent>
        <LogsView Read="ReadAsync" />
    </DialogContent>
</MudDialog>

@code {
    private bool _running;

    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    /// <summary>The build job on the agent (<c>/images/build/{job}</c>).</summary>
    [Parameter, EditorRequired] public string Job { get; set; } = "";

    /// <summary>What the view shows: the job's lines as they are now. Each read also says whether it still runs, which is when Cancel is offered.</summary>
    private async Task<string> ReadAsync()
    {
        BuildJob job;
        try
        {
            job = await Api.GetImageBuildAsync(Job);
        }
        catch (AgentApiException ex) when (ex.StatusCode == 404)
        {
            return "This build is no longer kept by the agent: its end is in the agent's log (Logs).";
        }

        var running = job.State == "running";
        if (running != _running)
        {
            _running = running;
            // Cancel lives in the title line, the dialog's own tree.
            await InvokeAsync(Dialog.StateHasChanged);
        }

        var lines = (job.Truncated ? ["… earlier output trimmed …"] : Array.Empty<string>()).Concat(job.Output);
        return string.Join('\n', job.Error.Length > 0 ? lines.Append($"ERROR: {job.Error}") : lines);
    }

    /// <summary>The window stays open on a cancelled build: its last lines say where it stopped.</summary>
    private Task CancelAsync() => PullFlow.CancelBuildAsync(Dialogs, Api, Snackbar, Job);
}
