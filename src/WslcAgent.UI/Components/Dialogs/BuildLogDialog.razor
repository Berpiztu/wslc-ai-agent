@* The window of a patch's build (any build job of the agent's): its log
   (BuildConsole), in the window a project's save log opens in
   (ProjectLogDialog). Close leaves the build running; Cancel, there while it
   runs, stops it, after asking: the containers it was to move run on as they
   were. *@
@inject WslcAgentApi Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<MudDialog ContentClass="wslc-dialog-action">
    <TitleContent>
        <DialogTitle Title="@Dialog.Title">
            @if (_running)
            {
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" OnClick="CancelAsync">Cancel</MudButton>
            }
            <MudButton Size="Size.Small" Variant="Variant.Filled" OnClick="@(() => Dialog.Cancel())">Close</MudButton>
        </DialogTitle>
    </TitleContent>
    <DialogContent>
        <BuildConsole Job="@Job" RunningChanged="RunningChanged" />
    </DialogContent>
</MudDialog>

@code {
    private bool _running;

    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    /// <summary>The build job on the agent (<c>/images/build/{job}</c>).</summary>
    [Parameter, EditorRequired] public string Job { get; set; } = "";

    /// <summary>Cancel lives in the title line, the dialog's own tree.</summary>
    private void RunningChanged(bool running)
    {
        _running = running;
        Dialog.StateHasChanged();
    }

    /// <summary>The window stays open on a cancelled build: its last lines say where it stopped.</summary>
    private Task CancelAsync() => PullFlow.CancelBuildAsync(Dialogs, Api, Snackbar, Job);
}
