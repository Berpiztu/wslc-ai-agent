@* The launch form as a dialog: Run and Create from the Containers page, View & edit
   from a row. The content is a fixed-height column: the fields scroll, the
   rail at the right stays where it is. The title carries the image as a badge
   and Close, which leaves the window, asking first when something was typed.
   A pull the form asked for (to show what the image sets) is drawn beside
   Close while it lasts: the ring with its percentage, its output and its
   cancel, as Containers and Images draw a pull. The rail's Cancel is the other
   thing: it puts the edits back and stays here. *@
@using WslcAgent.UI.Components.Launch

<MudDialog ContentClass="wslc-dialog-action">
    <TitleContent>
        <DialogTitle Title="@Dialog.Title">
            <Info>
                @if (Form.Image.Length > 0)
                {
                    <MudChip T="string" Size="Size.Small" Class="my-0">@Form.Image</MudChip>
                }
            </Info>
            <ChildContent>
                @* The slot is as tall as the ring from the start, so the window is the same
                   size with the ring and without it. *@
                @if (Mode != LaunchMode.Edit)
                {
                    <div class="wslc-title-ring-slot">
                        @if (_form?.Pull is { } pull)
                        {
                            <ProgressRing Pct="pull.Pct" Status="@ContainerForm.PullStatus(pull)" Failed="@(pull.State is "error" or "cancelled")" Done="@(pull.State == "success")"
                                          OnLog="@(() => _form.ShowPullLogAsync())" OnCancel="@(() => _form.CancelPullAsync())" OnDismiss="@(() => _form.DismissPullAsync())" />
                        }
                    </div>
                }
                <MudButton Size="Size.Small" Variant="Variant.Filled" OnClick="CloseAsync">Close</MudButton>
            </ChildContent>
        </DialogTitle>
    </TitleContent>
    <DialogContent>
        <ContainerForm @ref="_form" Mode="Mode" Form="Form" SourceId="@SourceId" MainClass="wslc-fill-scroll" OnImageChanged="@(() => Dialog.StateHasChanged())" OnPullChanged="@(() => Dialog.StateHasChanged())"
                       OnDone="@(id => Dialog.Close(DialogResult.Ok(id)))" />
    </DialogContent>
</MudDialog>

@code {
    private ContainerForm _form = default!;

    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter, EditorRequired] public LaunchMode Mode { get; set; }

    [Parameter] public LaunchForm Form { get; set; } = new();

    [Parameter] public string SourceId { get; set; } = "";

    /// <summary>Close leaves the window; what was typed and not saved is asked about first.</summary>
    private async Task CloseAsync()
    {
        if (await _form.ConfirmLeaveAsync())
        {
            Dialog.Cancel();
        }
    }
}
