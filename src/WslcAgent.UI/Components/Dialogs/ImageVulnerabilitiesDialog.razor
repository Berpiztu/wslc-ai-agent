@* Zaindari, the image check, in the window logs open in and drawn by the same
   view (LogsView: search, levels, wrap, copy). Opening it checks each image now,
   reading OSV.dev, so it says "Checking Zaindari - Vulnerabilities for …" beside a turning wheel
   until it is done, and the containers made from the image are marked again by
   what it finds. Only vulnerabilities: every one a line, from the low to the
   critical, coloured by its severity (ImageRemedies.LevelOf), each with its
   advisory, its CVE and the version that fixes it; then a line per library with
   the version that fixes all of its own, red when its worst is high or critical;
   and last what the image is, how many vulnerabilities there are and whether the
   agent refuses it: the view stands at the end, where the worst is read first.
   Opened for one container or one image whose system packages have a fix
   published, Patch on the title line builds the image's patch (ImagePatches).
   Accept… beside it opens the vulnerabilities no version fixes, to accept the
   ones in a part the image does not use: shown here in grey with their reason,
   they colour nothing (AcceptVulnerabilitiesDialog). The report is its
   Vulnerabilities tab; Changes, pressed when an image shown is a patch, says
   what the patch changed from the image it was built from, package by
   package, and why (PatchChangesView). *@
@inject WslcAgentApi Api
@inject IDialogService Dialogs
@inject WslcAgent.UI.Components.Styles.UiStyle Style

<MudDialog ContentClass="wslc-dialog-action">
    <TitleContent>
        <DialogTitle Title="@Dialog.Title">
            @if (_accept is { } accept)
            {
                <MudButton Size="Size.Small" Variant="Variant.Filled" OnClick="@(() => AcceptAsync(accept))">Accept…</MudButton>
            }
            @if (_patch is { } patch)
            {
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => PatchAsync(patch))">Patch</MudButton>
            }
            <MudButton Size="Size.Small" Variant="Variant.Filled" OnClick="@(() => Dialog.Cancel())">Close</MudButton>
        </DialogTitle>
    </TitleContent>
    <DialogContent>
        <MudTabs Elevation="Style.Applied.TabsElevation" Rounded="Style.Applied.TabsRounded" Border="Style.Applied.TabsBorder"
                 Centered="Style.Applied.TabsCentered" TabPanelsClass="wslc-tab-panels" Class="wslc-fill"
                 MinimumTabWidth="@($"{Style.Applied.TabsMinWidth}px")" @bind-ActivePanelIndex="_tab">
            <MudTabPanel Text="Vulnerabilities">
                <LogsView Read="ReadAsync" Waiting="@($"Checking {ImageSecurityFlow.Label} for {About}…")" />
            </MudTabPanel>
            <MudTabPanel Text="Changes" Disabled="@(Patched is null)">
                @if (_tab == ChangesTab && Patched is { } patched)
                {
                    <PatchChangesView @key="patched" Image="@patched" />
                }
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    /// <summary>The images to show, one after the other: a container's own, or an image; a project's window is its own (ZaindariTab).</summary>
    [Parameter, EditorRequired] public IReadOnlyList<string> Images { get; set; } = [];

    /// <summary>What is checked, as the window's title names it: a container, a project, an image.</summary>
    [Parameter] public string About { get; set; } = "";

    /// <summary>Opened for one container or one image: the patch is offered.</summary>
    [Parameter] public bool Patchable { get; set; }

    private const int ChangesTab = 1;

    private int _tab;

    /// <summary>The first image shown that is a patch Zaindari built: whose changes Changes shows.</summary>
    private string? Patched => Images.FirstOrDefault(ImageReference.IsPatched);

    /// <summary>The report as read the first time: the check is made once per opening, not at each refresh of the view.</summary>
    private string? _text;

    /// <summary>The image and its patch, when the check found one to build and the window offers it.</summary>
    private ImageVulnerabilities? _patch;

    /// <summary>The image, when it has vulnerabilities to accept (or accepted) and the window is one image's.</summary>
    private ImageVulnerabilities? _accept;

    private async Task<string> ReadAsync()
    {
        if (_text is not null)
        {
            return _text;
        }

        var lines = new List<string>();
        foreach (var image in Images.Where(image => image.Trim().Length > 0).Distinct(StringComparer.OrdinalIgnoreCase))
        {
            if (lines.Count > 0)
            {
                lines.Add("");
            }

            try
            {
                var report = await Api.GetImageVulnerabilitiesAsync(image);
                lines.AddRange(ImageReportLines.Of(report));
                if (Patchable && ImageSecurityFlow.Acceptable(report).Count > 0)
                {
                    _accept = report;
                    StateHasChanged();
                    Dialog.StateHasChanged();
                }
                if (Patchable && report.Patch.Length > 0)
                {
                    _patch = report;
                    lines.Add(ImageReportLines.PatchOffered(report));
                    // The title line is drawn by the dialog's own container: it is told too, or Patch never shows.
                    StateHasChanged();
                    Dialog.StateHasChanged();
                }
            }
            catch (Exception ex) when (ex is AgentApiException or HttpRequestException)
            {
                lines.Add(ImageReportLines.Line("ERROR", $"{image}: {ex.Message}"));
            }
        }

        return _text = string.Join('\n', lines);
    }

    /// <summary>The accepting window; saved, the image is checked again, so its colour and these lines follow at the view's next read.</summary>
    private async Task AcceptAsync(ImageVulnerabilities report)
    {
        if (await ImageSecurityFlow.ShowAcceptAsync(Dialogs, report))
        {
            _text = null;
        }
    }

    /// <summary>The patch's window; once it has started, the agent builds it and this window closes.</summary>
    private async Task PatchAsync(ImageVulnerabilities patch)
    {
        if (await ImageSecurityFlow.ShowPatchAsync(Dialogs, patch, []))
        {
            Dialog.Close();
        }
    }
}
