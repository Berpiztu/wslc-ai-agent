@* Zaindari's patch window, opened from a container's or an image's Zaindari
   window, Update image and View & edit: the patch editor (PatchEditor) as a
   form, Patch its verb, not offered while the patch has nothing to do. Started,
   the window closes and the agent builds it. *@

<FormDialog SubmitText="Patch" BusyText="Starting…" OnSubmit="@(() => _editor.StartAsync())" Waiting="_nothing"
            WaitingTitle="@(_nothing ? "Nothing to patch: the Dockerfile adds no step to the image" : null)">
    <PatchEditor @ref="_editor" Report="Report" Only="Only" NothingToDoChanged="@(nothing => _nothing = nothing)" />
</FormDialog>

@code {
    /// <summary>What Zaindari found on the image, its patch, its system upgrade, its requirements files and its Python fixes among it.</summary>
    [Parameter, EditorRequired] public ImageVulnerabilities Report { get; set; } = default!;

    /// <summary>Opened from one container (Update image, View &amp; edit): that one alone ticked, by id or name; empty, every one of the image's.</summary>
    [Parameter] public IReadOnlyList<string> Only { get; set; } = [];

    private PatchEditor _editor = default!;

    /// <summary>The editor's Dockerfile adds no step: Patch is not offered, and the editor says why.</summary>
    private bool _nothing;
}
