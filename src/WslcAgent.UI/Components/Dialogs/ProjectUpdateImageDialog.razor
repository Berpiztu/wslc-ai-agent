@* A project's Update image window (its body ProjectMemberPanes): the
   project's containers at the left, and at the right the update of the one
   chosen, the very one its own Update image opens (UpdateImageEditor), so
   the project's window does what going container by container does, and
   nothing else. Update starts it: the agent pulls the image and recreates
   the container, which turns its wheel in the menu until it is done; the
   window stays, for the next container. A container already on its way (an
   update, a patch, a recreate) has its Update wait. The window is sized
   when it opens, as wide and as tall as the screen lets it, and never
   changes. *@
@inject ActivityLine Activity

<MudDialog ContentClass="wslc-dialog-action wslc-dialog-tall">
    <TitleContent>
        <DialogTitle Title="@Dialog.Title">
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_verb.Busy || !CanUpdate)" OnClick="UpdateAsync">@(_verb.Busy ? "Starting…" : "Update")</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Filled" Disabled="_verb.Busy" OnClick="@(() => Dialog.Cancel())">Close</MudButton>
        </DialogTitle>
    </TitleContent>
    <DialogContent>
        <ProjectMemberPanes @ref="_panes" Project="@Project" Members="Members" ChosenChanged="Chosen" Busy="_verb.Busy" BusyText="Starting the update…">
            @if (_chosen is { } chosen)
            {
                @* In a main column, as the Zaindari window's steps: the window keeps one frame. *@
                <div class="wslc-action-body">
                    <div class="wslc-action-main">
                        <div class="wslc-fill-scroll wslc-member-step">
                            @if (_verb.Error is { } error)
                            {
                                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">@error</MudAlert>
                            }
                            <MudForm @ref="_form">
                                <UpdateImageEditor @key="@($"{chosen.Id} {chosen.Image}")" @ref="_editor" Container="@chosen.Id" Current="@chosen.Image"
                                                   CheckingChanged="CheckingChanged" Patched="ReadAgainAsync" />
                            </MudForm>
                        </div>
                    </div>
                </div>
            }
        </ProjectMemberPanes>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    /// <summary>The project's name.</summary>
    [Parameter, EditorRequired] public string Project { get; set; } = "";

    /// <summary>Its containers as the list showed them: drawn at once, then read again from the agent as it says they change.</summary>
    [Parameter] public IReadOnlyList<ContainerSummary> Members { get; set; } = [];

    private ProjectMemberPanes? _panes;
    private ContainerSummary? _chosen;
    private PaneVerb _verb = default!;
    private MudForm? _form;
    private UpdateImageEditor? _editor;

    /// <summary>Zaindari is being asked about the image named: Update waits, as the container's own window does.</summary>
    private bool _checking;

    /// <summary>The container chosen is at rest (as its own Update image asks) and Zaindari has answered.</summary>
    private bool CanUpdate => _chosen is { PatchingTo: null, IsUpdating: false, IsRecreating: false } && !_checking;

    protected override void OnInitialized() => _verb = new PaneVerb(Repaint);

    private void Repaint()
    {
        StateHasChanged();
        Dialog.StateHasChanged();
    }

    /// <summary>The container chosen, as the menu has it now; another one forgets the last refusal.</summary>
    private void Chosen(ContainerSummary? chosen)
    {
        if (chosen?.Id != _chosen?.Id)
        {
            _verb.Clear();
        }

        _chosen = chosen;
        Dialog.StateHasChanged();
    }

    private void CheckingChanged(bool checking)
    {
        _checking = checking;
        Dialog.StateHasChanged();
    }

    /// <summary>Started, the agent pulls and recreates it, and the menu says so; the title bar's activity line too, as a container's own update does.</summary>
    private async Task UpdateAsync()
    {
        if (_form is not { } form || _editor is not { } editor || _chosen is not { } chosen)
        {
            return;
        }

        string? pulling = null;
        if (await _verb.RunAsync(async () =>
            {
                await form.ValidateAsync();
                if (!form.IsValid)
                {
                    return false;
                }

                pulling = await editor.StartAsync();
                return true;
            }) && pulling is not null)
        {
            Activity.Say($"{chosen.Name}: updating to {pulling}. The container is recreated once the pull ends.");
            await ReadAgainAsync();
        }
    }

    private Task ReadAgainAsync() => _panes?.ReadAsync() ?? Task.CompletedTask;
}
