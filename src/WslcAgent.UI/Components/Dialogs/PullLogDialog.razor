@* The window of a pull or a push the agent runs: its console (PullConsole).
   Close leaves it running; Cancel stops it, after asking. *@
@inject WslcAgentApi Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<MudDialog ContentClass="wslc-dialog-action">
    <TitleContent>
        <DialogTitle Title="@($"{(Push ? "Push" : "Pull")} progress")">
            <Info>
                <MudChip T="string" Size="Size.Small" Class="my-0">@Image</MudChip>
            </Info>
            <ChildContent>
                @if (_showCancel)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" OnClick="CancelAsync">Cancel</MudButton>
                }
                <MudButton Size="Size.Small" Variant="Variant.Filled" OnClick="@(() => Dialog.Close())">Close</MudButton>
            </ChildContent>
        </DialogTitle>
    </TitleContent>
    <DialogContent>
        <PullConsole Image="@Image" Finished="Finished" Push="Push" ActiveChanged="ActiveChanged" />
    </DialogContent>
</MudDialog>

@code {
    private bool _showCancel = true;

    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter, EditorRequired] public string Image { get; set; } = "";

    /// <summary>Opened from a row that already knows the pull has ended: its output is painted at once, and there is nothing to cancel.</summary>
    [Parameter] public bool Finished { get; set; }

    /// <summary>The push of <see cref="Image"/>, not its pull.</summary>
    [Parameter] public bool Push { get; set; }

    protected override void OnInitialized() => _showCancel = !Finished;

    /// <summary>Cancel lives in the title line, the dialog's own tree: it is told too.</summary>
    private void ActiveChanged(bool active)
    {
        if (active != _showCancel)
        {
            _showCancel = active;
            Dialog.StateHasChanged();
        }
    }

    private async Task CancelAsync()
    {
        if (await PullFlow.CancelAsync(Dialogs, Api, Snackbar, Image, Push))
        {
            Dialog.Close();
        }
    }
}
