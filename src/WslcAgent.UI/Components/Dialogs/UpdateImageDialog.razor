@* A container's Update image window: the update editor (UpdateImageEditor)
   as a form, Update its verb, waiting while Zaindari is asked. Started, the
   dialog closes and the container's row shows the pull; a patch begun from
   its Patch… closes it too. *@

<FormDialog SubmitText="Update" BusyText="Starting…" OnSubmit="UpdateAsync" Waiting="_checking">
    <UpdateImageEditor @ref="_editor" Container="@Container" Current="@Current"
                       CheckingChanged="@(checking => _checking = checking)" Patched="@(() => Dialog.Cancel())" />
</FormDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter, EditorRequired] public string Container { get; set; } = "";

    /// <summary>The image the container runs now.</summary>
    [Parameter, EditorRequired] public string Current { get; set; } = "";

    /// <summary>Told the image being pulled, once the update has started.</summary>
    [Parameter, EditorRequired] public Action<string> Started { get; set; } = default!;

    private UpdateImageEditor _editor = default!;

    private bool _checking;

    private async Task UpdateAsync() => Started(await _editor.StartAsync());
}
