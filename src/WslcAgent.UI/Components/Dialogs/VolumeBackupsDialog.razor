@* The window of volume backups. A volume's own (its card's Backup &
   restore) is that volume alone: its tabs, no list. The Volumes page's is
   built as a project's window is (ProjectPanesDialog, ProjectMemberPanes):
   the volumes at the left, All first, then each volume, with those only the
   history still names (removed since); at the right the same tabs for the
   one chosen. Backups: a
   volume's backups (VolumeBackupPane), All's every volume's, with those under
   way above them (VolumeAllBackups). Logs: the lines of a volume's backups and
   restores in the agent's log, All's every volume's, a line each said by its
   volume. Settings:
   a volume's own backup folder, All's the folder of every volume; the place
   a schedule goes when backups are scheduled. The title row holds the open
   tab's verbs and Close: Back up and Restore in Backups, Save in Settings;
   Close asks while a folder is not saved. A volume under way turns a wheel in
   its slot of the list; its ring is on its card. Read again as the agent
   says the volumes change; sized when it opens and never changes. *@
@inject WslcAgentApi Api
@inject AgentChanges Changes
@inject IDialogService Dialogs
@inject WslcAgent.UI.Components.Styles.UiStyle Style
@implements IDisposable

<MudDialog ContentClass="wslc-dialog-action wslc-dialog-tall">
    <TitleContent>
        <DialogTitle Title="@Dialog.Title">
            @if (_tab == BackupsTab)
            {
                @if (_chosen is { } volume)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Backup"
                               Disabled="@(!_volumes.Contains(volume) || Running(volume))" OnClick="BackupAsync">Back up</MudButton>
                }
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.CloudDownload"
                           Disabled="@(_chosen is { } busy && Running(busy))" OnClick="RestoreAsync">Restore</MudButton>
            }
            else if (_tab == SettingsTab)
            {
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                           Disabled="@(!Unsaved)" OnClick="SaveAsync">Save</MudButton>
            }
            <MudButton Size="Size.Small" Variant="Variant.Filled" OnClick="CloseAsync">Close</MudButton>
        </DialogTitle>
    </TitleContent>
    <DialogContent>
        @* A volume's own Backup & restore is that volume alone, its tabs and nothing else, as a container's own Update
           image is; the Volumes page's opens on All, with the list. *@
        @if (Alone)
        {
            @Tabs
        }
        else
        {
            <div class="wslc-member-panes">
                <MudPaper Outlined="true" Class="wslc-member-menu">
                    <MudList T="string" SelectedValue="@(_chosen ?? AllVolumes)" SelectedValueChanged="Choose" Dense="true" role="list">
                        <MudListItem T="string" @key="AllVolumes" Value="@AllVolumes" role="listitem">
                            <div class="d-flex align-center gap-2">
                                <span class="wslc-member-mark">
                                    <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" />
                                </span>
                                <div class="wslc-member-text">
                                    <MudText Typo="Typo.body2" Class="wslc-member-line">All</MudText>
                                    <MudText Typo="Typo.caption" Class="wslc-member-line mud-text-secondary">every volume's backups, logs and settings</MudText>
                                </div>
                            </div>
                        </MudListItem>
                        @foreach (var volume in Volumes)
                        {
                            <MudListItem T="string" @key="volume" Value="@volume" role="listitem">
                                <div class="d-flex align-center gap-2">
                                    @* One slot for the mark or the turning wheel, so a volume under way moves nothing. *@
                                    <span class="wslc-member-mark">
                                        @if (Running(volume))
                                        {
                                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Info" />
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Storage" Size="Size.Small" />
                                        }
                                    </span>
                                    <div class="wslc-member-text">
                                        <MudText Typo="Typo.body2" Class="wslc-member-line">@volume</MudText>
                                        <MudText Typo="Typo.caption" Class="wslc-member-line mud-text-secondary">@Caption(volume)</MudText>
                                    </div>
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                </MudPaper>

                <div class="wslc-member-pane">
                    @Tabs
                </div>
            </div>
        }
    </DialogContent>
</MudDialog>

@code {
    private const int BackupsTab = 0;
    private const int SettingsTab = 2;

    /// <summary>All's entry in the list, which no volume's name can be.</summary>
    private const string AllVolumes = "\u0001all";

    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    /// <summary>The volume whose window it is, alone; empty for every volume, the list at the left and All chosen first.</summary>
    [Parameter] public string Volume { get; set; } = "";

    /// <summary>A volume's own window: its tabs alone, no list.</summary>
    private bool Alone => Volume.Length > 0;

    /// <summary>The tabs of what is chosen, the same whether the window is a volume's alone or every volume's.</summary>
    private RenderFragment Tabs => __builder =>
    {
        <MudTabs Elevation="Style.Applied.TabsElevation" Rounded="Style.Applied.TabsRounded" Border="Style.Applied.TabsBorder"
                 Centered="Style.Applied.TabsCentered" TabPanelsClass="wslc-tab-panels" Class="wslc-fill"
                 MinimumTabWidth="@($"{Style.Applied.TabsMinWidth}px")" ActivePanelIndex="_tab" ActivePanelIndexChanged="TabChanged">
            <MudTabPanel Text="Backups">
                @if (_chosen is { } volume)
                {
                    <VolumeBackupPane @key="volume" Volume="@volume" Job="@VolumeBackupFlow.For(_backups.Jobs, volume)" Backups="@Backups(volume)" Changed="ReadAsync" />
                }
                else
                {
                    <VolumeAllBackups List="_backups" Changed="ReadAsync" />
                }
            </MudTabPanel>
            <MudTabPanel Text="Logs">
                <LogsView @key="@(_chosen ?? AllVolumes)" Read="ReadLogsAsync" />
            </MudTabPanel>
            <MudTabPanel Text="Settings">
                @* In a row, as a form holds it: the field takes the width, never the window's height. *@
                <MudStack Row="true">
                    <div class="wslc-field-pick has-note">
                        @if (_chosen is { } volume)
                        {
                            <MudTextField T="string" @key="volume" Value="@FolderOf(volume)" ValueChanged="@((string folder) => EditFolder(volume, folder))"
                                          Label="Backup folder" Placeholder="default" Immediate="true" HelperTextOnFocus="true"
                                          Variant="Variant.Filled" Margin="Margin.Dense" HelperText="Empty: default, a folder named after the volume in the folder of every volume."
                                          autocapitalize="none" autocorrect="off" spellcheck="false" />
                        }
                        else
                        {
                            <MudTextField T="string" Value="_volumesFolder" ValueChanged="EditVolumesFolder"
                                          Label="Backup folder of every volume" Placeholder="default" Immediate="true" HelperTextOnFocus="true"
                                          Variant="Variant.Filled" Margin="Margin.Dense" HelperText="Empty: default, the folder of Settings → Defaults. A volume with its own keeps it."
                                          autocapitalize="none" autocorrect="off" spellcheck="false" />
                        }
                        <MudFab Color="Color.Success" StartIcon="@Icons.Material.Filled.MoreVert" Size="Size.Small" title="Pick a folder" OnClick="PickFolderAsync" />
                    </div>
                </MudStack>
            </MudTabPanel>
        </MudTabs>
    };

    private IReadOnlyList<string> _volumes = [];
    private VolumeBackupList _backups = new([], []);

    /// <summary>The volume chosen; null for All.</summary>
    private string? _chosen;

    private int _tab;

    /// <summary>The folder of every volume as edited; empty for the default of Settings.</summary>
    private string _volumesFolder = "";

    /// <summary>Each volume's own folder as edited, by the volume, for those touched since the last save.</summary>
    private readonly Dictionary<string, string> _folders = new(StringComparer.Ordinal);

    /// <summary>Where backups go, as the agent last said; empty until read.</summary>
    private VolumeBackupSettings Settings => _backups.Settings ?? new VolumeBackupSettings("", []);

    /// <summary>A volume's own folder as it stands in the window: edited, else saved.</summary>
    private string FolderOf(string volume) =>
        _folders.TryGetValue(volume, out var edited) ? edited : Settings.HasOwnFolder(volume) ? Settings.FolderOf(volume) : "";

    /// <summary>Where a volume with no folder of its own backs up, as the window stands.</summary>
    private string VolumesFolder => _volumesFolder.Trim().Length > 0 ? _volumesFolder.Trim() : Settings.DefaultFolder;

    /// <summary>A folder edited and not saved.</summary>
    private bool Unsaved =>
        _volumesFolder.Trim() != Settings.VolumesFolder
        || _folders.Any(edited => edited.Value.Trim() != (Settings.HasOwnFolder(edited.Key) ? Settings.FolderOf(edited.Key) : ""));

    /// <summary>The machine's volumes, then those only the history still names, each once, by name.</summary>
    private IEnumerable<string> Volumes =>
        _volumes.Concat(_backups.History.Select(backup => backup.Volume)).Distinct(StringComparer.Ordinal).Order(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        Changes.Changed += OnAgentChanged;
        Changes.Start();
        _chosen = Volume.Length > 0 ? Volume : null;
        await ReadAsync();
        _volumesFolder = Settings.VolumesFolder;
    }

    public void Dispose() => Changes.Changed -= OnAgentChanged;

    private void OnAgentChanged(ChangeNotice notice)
    {
        if (notice.Touches(ChangeNotice.Volume))
        {
            _ = InvokeAsync(ReadAsync);
        }
    }

    /// <summary>The volumes, the jobs, the history and the settings read again; the folders being edited stay as they are.</summary>
    private async Task ReadAsync()
    {
        try
        {
            var volumes = Api.GetVolumesAsync();
            _backups = await Api.GetVolumeBackupsAsync();
            _volumes = [.. (await volumes).Volumes.Select(v => v.Name)];
        }
        catch (Exception ex) when (ex is AgentApiException or HttpRequestException)
        {
            // Kept as last read: the next change notice reads them again.
        }

        StateHasChanged();
        Dialog.StateHasChanged();
    }

    private void Choose(string? chosen)
    {
        _chosen = chosen is null or AllVolumes ? null : chosen;
        Dialog.StateHasChanged();
    }

    /// <summary>MudTabs reports the index it settles on after every render: only a real change is taken, and the title row's verbs follow it.</summary>
    private void TabChanged(int index)
    {
        if (index == _tab)
        {
            return;
        }

        _tab = index;
        Dialog.StateHasChanged();
    }

    /// <summary>The title row is MudBlazor's own tree: Save is repainted at every key, or it stays off until a click elsewhere.</summary>
    private void EditVolumesFolder(string folder)
    {
        _volumesFolder = folder;
        Dialog.StateHasChanged();
    }

    private void EditFolder(string volume, string folder)
    {
        _folders[volume] = folder;
        Dialog.StateHasChanged();
    }

    private bool Running(string volume) => VolumeBackupFlow.For(_backups.Jobs, volume) is { Running: true };

    private List<VolumeBackup> Backups(string volume) => [.. _backups.History.Where(backup => backup.Volume == volume)];

    /// <summary>Under a volume's name: what it is doing, else how many backups it has and the last; a removed one says so.</summary>
    private string Caption(string volume)
    {
        if (VolumeBackupFlow.For(_backups.Jobs, volume) is { Running: true } job)
        {
            return $"{VolumeBackupFlow.Said(job.Kind)}: {job.Status}";
        }

        var backups = Backups(volume);
        var said = backups.Count switch
        {
            0 => "no backup",
            1 => $"1 backup, {backups[0].CreatedAt.ToLocalTime():yyyy-MM-dd HH:mm}",
            _ => $"{backups.Count} backups, the last {backups[0].CreatedAt.ToLocalTime():yyyy-MM-dd HH:mm}",
        };
        return _volumes.Contains(volume) ? said : $"removed; {said}";
    }

    /// <summary>
    /// What Logs shows: the chosen volume's backup and restore lines as the
    /// agent's log keeps them (the Logs page's Backups group), the oldest
    /// first, every one it holds; All's every volume's, each line said by its
    /// volume, the names in a column, as a project's All says its containers.
    /// </summary>
    private async Task<string> ReadLogsAsync()
    {
        var lines = await Api.GetVolumeBackupLogAsync(_chosen ?? "");
        return lines.Count > 0 ? string.Join("\n", lines) : $"No backup or restore of {_chosen ?? "any volume"} in the agent's log.";
    }

    private async Task PickFolderAsync()
    {
        var current = _chosen is { } volume ? (FolderOf(volume) is { Length: > 0 } own ? own : VolumesFolder) : VolumesFolder;
        if (await Pickers.HostFolderAsync(Dialogs, current) is not { } folder)
        {
            return;
        }

        if (_chosen is { } chosen)
        {
            EditFolder(chosen, folder);
        }
        else
        {
            EditVolumesFolder(folder);
        }
    }

    /// <summary>The folders edited, saved: every volume's, and each volume's own, empty for default.</summary>
    private async Task<bool> SaveAsync()
    {
        var settings = _folders.Aggregate(Settings with { VolumesFolder = _volumesFolder.Trim() }, (saved, edited) => saved.WithFolder(edited.Key, edited.Value));
        if (!await VolumeBackupFlow.SaveSettingsAsync(Dialogs, Api, settings))
        {
            return false;
        }

        _folders.Clear();
        await ReadAsync();
        _volumesFolder = Settings.VolumesFolder;
        return true;
    }

    /// <summary>A backup is written where the volume's folder says once it is saved: one edited and not saved is saved first, or the backup waits.</summary>
    private async Task BackupAsync()
    {
        if (_chosen is not { } volume || (Unsaved && !await SaveFirstAsync()))
        {
            return;
        }

        if (await VolumeBackupFlow.BackupAsync(Dialogs, Api, volume))
        {
            await ReadAsync();
        }
    }

    /// <summary>A backup file into the chosen volume, or, from All, into the volume named; the picker opens on the volume's last backup, or its backup folder.</summary>
    private async Task RestoreAsync()
    {
        var start = _chosen is { } volume
            ? Backups(volume).FirstOrDefault(backup => backup.Exists)?.Path ?? Settings.FolderOf(volume)
            : Settings.FolderOfVolumes;
        if (await VolumeBackupFlow.RestoreAsync(Dialogs, Api, _chosen ?? "", start))
        {
            await ReadAsync();
        }
    }

    /// <summary>Unsaved folders: saved, left as they are, or the verb waits.</summary>
    private async Task<bool> SaveFirstAsync() =>
        await DialogFlow.LeaveUnsavedAsync(Dialogs, "A backup folder is edited and not saved.") switch
        {
            UnsavedChoice.Save => await SaveAsync(),
            UnsavedChoice.Discard => Discard(),
            _ => false,
        };

    private bool Discard()
    {
        _folders.Clear();
        _volumesFolder = Settings.VolumesFolder;
        return true;
    }

    private async Task CloseAsync()
    {
        if (!Unsaved || await SaveFirstAsync())
        {
            Dialog.Cancel();
        }
    }
}
