@* The one card for list pages in cards view. Header (EntityCardHeader: avatar,
   title, subtitle, an optional badge on the right) and the actions row share
   the tinted tone of the table header and pager; the body carries the data,
   on the card's own surface unless the page gives it a soft tone (BodyTone).
   The header is a component of its own so a resource's card on the
   dashboard wears the same one. *@
@implements IDisposable
@inject WslcAgent.UI.Components.Styles.UiStyle Style

<MudCard Elevation="Style.Applied.CardElevation" Outlined="Style.Applied.CardOutlined" Square="Style.Applied.CardSquare" Class="wslc-card d-flex flex-column" Style="height: 100%">
    <EntityCardHeader Title="@Title" Subtitle="@Subtitle" AvatarText="@AvatarText" AvatarColor="AvatarColor" Avatar="Avatar" Key="@Key" HeaderActions="HeaderActions" Tone="Tone" />
    @* A failure is said at the rows' own share, a kind of card at the soft one: an alarm has to be louder than a label. *@
    <MudCardContent Class="flex-grow-1" Style="@CardTone.Style(BodyTone, BodyTone == Color.Error ? CardTone.Share : CardTone.Soft)" title="@BodyTitle">
        @ChildContent
    </MudCardContent>
    @if (Actions is not null)
    {
        <MudCardActions Class="py-1 justify-end" Style="@CardTone.Style(Tone)">
            @Actions
        </MudCardActions>
    }
</MudCard>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter] public string Subtitle { get; set; } = "";

    /// <summary>Avatar letter; defaults to the first character of the title.</summary>
    [Parameter] public string? AvatarText { get; set; }

    [Parameter] public Color AvatarColor { get; set; } = Color.Primary;

    /// <summary>Drawn instead of the avatar: a row on its way shows its progress there.</summary>
    [Parameter] public RenderFragment? Avatar { get; set; }

    /// <summary>The row's key, the one its actions component reports busy with.</summary>
    [Parameter] public string? Key { get; set; }

    [Parameter] public RenderFragment? HeaderActions { get; set; }

    /// <summary>The header's and the actions row's background, saying the row's state (<see cref="CardTone"/>); null for the card's own tone.</summary>
    [Parameter] public Color? Tone { get; set; }

    /// <summary>The body's background, a soft tone of a palette colour that says what kind of card it is (a project's, among its containers'); null for the card's own.</summary>
    [Parameter] public Color? BodyTone { get; set; }

    /// <summary>What the body's tone says, in words, for whoever rests the pointer on it: why a container did not start.</summary>
    [Parameter] public string BodyTitle { get; set; } = "";

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public RenderFragment? Actions { get; set; }

    protected override void OnInitialized() => Style.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Style.Changed -= OnChanged;
}
