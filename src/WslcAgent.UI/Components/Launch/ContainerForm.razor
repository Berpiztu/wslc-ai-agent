    /// <summary>Ticked: the command becomes sleep infinity (the previous one kept aside); unticked: it comes back.</summary>
    private void ToggleKeepRunning(bool on)
    {
        if (on)
        {
            _commandBeforeKeepRunning = Form.Command;
            Form.Command = LaunchForm.KeepRunningCommand;
        }
        else
        {
            Form.Command = _commandBeforeKeepRunning == LaunchForm.KeepRunningCommand ? "" : _commandBeforeKeepRunning;
        }
