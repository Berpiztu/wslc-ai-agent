@* The one launch form, in three uses: Run (with the Fill bar),
   Create and View & edit (the same fields pre-filled from inspect; saving
   removes and recreates). The fields are in one order for the
   three: what the container is (image, tag, name), what it exposes and mounts,
   its variables and networks, what it runs, where and as whom, its policies,
   and the short numbers together at the end; the two commands span the width,
   since a port hidden past the edge of a narrow Command field is how a wrong
   port went unseen. The actions are a rail, with two verbs in
   every use: Save (create, or recreate, stopped) and Run (create and start).
   Neither closes the window before the agent has said the container is there:
   a veil over the fields says what is being done meanwhile, and a failure
   comes back into the fields it is about, the rest above them, where a small
   screen still shows it. Run and Create show what the image itself sets
   (variables, command, user) as soon as the image is known, since those are
   what the container will run with; an image that is not on the machine has
   to be pulled for that, and the form asks before it does. *@
@using System.Text.Json
@using WslcAgent.ApiClient
@implements IDisposable
@inject WslcAgentApi Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject ActivityLine Activity
@inject IClientFiles Files
@inject PullActivity Pulls

<div class="wslc-action-body">
<div class="wslc-action-main @MainClass">
@Above
@* What is not about one field: above the fields, where every screen shows it. *@
@foreach (var (severity, text) in _general)
{
    <MudAlert Severity="@severity" Dense="true" Class="mb-2">@text</MudAlert>
}
<MudForm @ref="_form" Class="wslc-form-grid">
    @if (Mode == LaunchMode.Run)
    {
        <div class="wslc-span2">
            @* Fill acts on its own field, so its button is inside it, as a picker's is. *@
            <div class="wslc-field-pick has-note">
                <MudTextField Margin="Margin.Dense" T="string" @bind-Value="_fill" Label="Fill" Immediate="true" HelperTextOnFocus="true"
                              Variant="Variant.Filled" OnKeyDown="OnFillKey"
                              HelperText="Example: paste a wslc run command (or a docker run one, including \ or ` line breaks) and press Fill." />
                <MudFab Color="Color.Success" StartIcon="@Icons.Material.Filled.AutoFixHigh" Size="Size.Small" title="Fill the form from the command" OnClick="Fill" />
            </div>
            @if (_fillStatus.Length > 0)
            {
                <MudText Typo="Typo.caption" Class="@(_fillFlagged ? "mud-error-text" : "mud-text-secondary")">@_fillStatus</MudText>
            }
        </div>
    }

    @* What the image sets, or why it cannot be shown yet: said above the fields it filled.
       Its pull is drawn by the window's title (the ring with its percentage, its output
       and its cancel, as Containers and Images draw theirs); here it is said in words. *@
    @if (_pull is { } pull)
    {
        <div class="wslc-span2">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@PullNote(pull)</MudText>
        </div>
    }
    else if (_imageNote.Length > 0)
    {
        <div class="wslc-span2">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@_imageNote</MudText>
            @if (_imageMissing)
            {
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudDownload" OnClick="PullForDefaultsAsync">Pull it now</MudButton>
            }
        </div>
    }

    @* What the container is. *@
    <div class="wslc-field-pick has-note">
        <MudTextField Margin="Margin.Dense" T="string" @bind-Value="Form.ImageName" Label="Image" Immediate="true" HelperTextOnFocus="true" Required="true" RequiredError="Image is required"
                      Variant="Variant.Filled" HelperText="Repository. Type a name that is not local; Run and Save pull it." Error="@Has(LaunchFields.Image)" ErrorText="@Error(LaunchFields.Image)" OnBlur="OnImageBlurAsync" />
        <MudFab Color="Color.Success" StartIcon="@Icons.Material.Filled.MoreVert" Size="Size.Small" title="Pick a local image" OnClick="PickImageAsync" />
    </div>
    <MudTextField Margin="Margin.Dense" T="string" @bind-Value="Form.ImageTag" Label="Tag" Immediate="true" HelperTextOnFocus="true" Variant="Variant.Filled"
                  HelperText="Example: latest. Leave empty if the image has no tag." Error="@Has(LaunchFields.Image)" ErrorText="@Error(LaunchFields.Image)" OnBlur="OnImageBlurAsync" />
    @* Name is the filled field as MudBlazor gives it, with nothing added. *@
    <MudTextField Margin="Margin.Dense" T="string" @bind-Value="Form.Name" Label="Name" Immediate="true" HelperTextOnFocus="true" Variant="Variant.Filled" HelperText="Example: my-app"
                  Error="@Has(LaunchFields.Name)" ErrorText="@Error(LaunchFields.Name)" />
    @* Ports, with its popup: one row per port pair, the Reverse proxy check and the
       name the port is published under. The names
       are the agent's, not a flag; saving the form publishes the difference. *@
    <PortsField Publish="Form.Publish" PublicNames="Form.PublicNames" ContainerName="@Form.Name" Error="@(Error(LaunchFields.Publish) ?? Error(LaunchFields.PublicNames))" />

    @* What it mounts, its variables, its networks. *@
    <div class="wslc-span2"><MountRows Rows="Form.Mounts" Error="@Error(LaunchFields.Volumes)" /></div>
    <div class="wslc-span2">
        <MultiValueField Values="Form.Env" Label="Env" Split="ValueList.SplitPairs" Placeholder="KEY=value"
                         HelperText="Example: KEY=value. Several separated by commas, or edited as rows with ⋮."
                         Hint="One variable per row: KEY=value. A comma inside a value (MSG=hello, world) stays part of it." Error="@Error(LaunchFields.Env)" />
    </div>
    <div class="wslc-span2"><NetworkRows Rows="Form.Networks" Error="@Error(LaunchFields.Networks)" /></div>

    @* What it runs: the two commands take the whole width, so every flag is seen. *@
    <div class="wslc-span2">
        <MudTextField Margin="Margin.Dense" T="string" @bind-Value="Form.Entrypoint" Label="Entrypoint" Immediate="true" HelperTextOnFocus="true" Variant="Variant.Filled"
                      HelperText="Example: /bin/sh. Its arguments (tini -s --) go before the command." Error="@Has(LaunchFields.Entrypoint)" ErrorText="@Error(LaunchFields.Entrypoint)" />
    </div>
    @* Keep running is a switch on this field, so it rides inside it: green while on,
       and the field keeps the grid's width. *@
    <div class="wslc-span2 wslc-field-pick has-note">
        <MudTextField Margin="Margin.Dense" T="string" @bind-Value="Form.Command" Label="Command" Immediate="true" HelperTextOnFocus="true" Variant="Variant.Filled"
                      HelperText="Empty runs the image ENTRYPOINT/CMD. Example: python app.py. ∞ keeps a bare base image running."
                      Error="@Has(LaunchFields.Command)" ErrorText="@Error(LaunchFields.Command)" />
        <MudFab Color="@(Form.KeepRunning ? Color.Success : Color.Default)" StartIcon="@Icons.Material.Filled.AllInclusive" Size="Size.Small"
                title="@(Form.KeepRunning ? "Keep running: on (sleep infinity) — click to turn off" : "Keep running: run sleep infinity so a bare base image stays alive")"
                OnClick="@(() => ToggleKeepRunning(!Form.KeepRunning))" />
    </div>

    @* Where and as whom. *@
    <div class="wslc-field-pick has-note">
        <MudTextField Margin="Margin.Dense" T="string" @bind-Value="Form.Workdir" Label="Workdir" Immediate="true" HelperTextOnFocus="true" Variant="Variant.Filled" HelperText="Container path. Example: /workspace"
                      Error="@Has(LaunchFields.Workdir)" ErrorText="@Error(LaunchFields.Workdir)" />
        <MudFab Color="Color.Success" StartIcon="@Icons.Material.Filled.MoreVert" Size="Size.Small" title="Pick a host folder as workdir (bound at /workspace)" OnClick="PickWorkdirAsync" />
    </div>
    <MudTextField Margin="Margin.Dense" T="string" @bind-Value="Form.User" Label="User" Immediate="true" HelperTextOnFocus="true" Variant="Variant.Filled" HelperText="Example: 1000 or www-data"
                  Error="@Has(LaunchFields.User)" ErrorText="@Error(LaunchFields.User)" />

    @* Its policies and limits: short values, two to a column. *@
    <div class="wslc-form-pair">
        <MudSelect Margin="Margin.Dense" T="string" @bind-Value="Form.RestartPolicy" Label="Restart policy" Dense="true" HelperTextOnFocus="true" Variant="Variant.Filled" HelperText="Dashboard-owned; production container"
                   Error="@Has(LaunchFields.RestartPolicy)" ErrorText="@Error(LaunchFields.RestartPolicy)">
            <MudSelectItem T="string" Value="@RestartPolicyInfo.No">No</MudSelectItem>
            <MudSelectItem T="string" Value="@RestartPolicyInfo.UnlessStopped">Unless stopped</MudSelectItem>
            <MudSelectItem T="string" Value="@RestartPolicyInfo.Always">Always</MudSelectItem>
        </MudSelect>
        <MudTextField Margin="Margin.Dense" T="string" @bind-Value="Form.StopTimeout" Label="Stop timeout" Immediate="true" HelperTextOnFocus="true" Variant="Variant.Filled" HelperText="Example: 10 (0 immediate, -1 infinite)"
                      Error="@Has(LaunchFields.StopTimeout)" ErrorText="@Error(LaunchFields.StopTimeout)" />
    </div>
    <div class="wslc-form-pair">
        <MudTextField T="string" @bind-Value="Form.Memory" Label="Memory" Immediate="true" HelperTextOnFocus="true" Variant="Variant.Filled" Margin="Margin.Dense" HelperText="Example: 512m"
                      Error="@Has(LaunchFields.Memory)" ErrorText="@Error(LaunchFields.Memory)" />
        <MudTextField T="string" @bind-Value="Form.Cpus" Label="CPUs" Immediate="true" HelperTextOnFocus="true" Variant="Variant.Filled" Margin="Margin.Dense" HelperText="Example: 1.5"
                      Error="@Has(LaunchFields.Cpus)" ErrorText="@Error(LaunchFields.Cpus)" />
    </div>
    @* Beside the memory and the CPUs it is given: what of the machine the container may use. *@
    <div class="wslc-span2">
        <SquareCheckBox @bind-Value="Form.Gpus" Label="GPU (all GPUs, --gpus all)" />
    </div>

    @* Its health check: the switch, the command across the width, the four times two to a column. *@
    <div class="wslc-span2">
        <SquareCheckBox @bind-Value="Form.NoHealthcheck" Label="Disable healthcheck" />
    </div>
    <div class="wslc-span2">
        <MudTextField Margin="Margin.Dense" T="string" @bind-Value="Form.HealthCmd" Label="Health cmd" Immediate="true" HelperTextOnFocus="true" Variant="Variant.Filled" Disabled="Form.NoHealthcheck" HelperText="Example: curl -f http://localhost/"
                      Error="@Has(LaunchFields.HealthCmd)" ErrorText="@Error(LaunchFields.HealthCmd)" />
    </div>
    <div class="wslc-form-pair">
        <MudTextField Margin="Margin.Dense" T="string" @bind-Value="Form.HealthInterval" Label="Health interval" Immediate="true" HelperTextOnFocus="true" Variant="Variant.Filled" Disabled="Form.NoHealthcheck" HelperText="Example: 30s"
                      Error="@Has(LaunchFields.HealthInterval)" ErrorText="@Error(LaunchFields.HealthInterval)" />
        <MudTextField Margin="Margin.Dense" T="string" @bind-Value="Form.HealthTimeout" Label="Health timeout" Immediate="true" HelperTextOnFocus="true" Variant="Variant.Filled" Disabled="Form.NoHealthcheck" HelperText="Example: 5s"
                      Error="@Has(LaunchFields.HealthTimeout)" ErrorText="@Error(LaunchFields.HealthTimeout)" />
    </div>
    <div class="wslc-form-pair">
        <MudTextField Margin="Margin.Dense" T="string" @bind-Value="Form.HealthRetries" Label="Health retries" Immediate="true" HelperTextOnFocus="true" Variant="Variant.Filled" Disabled="Form.NoHealthcheck" HelperText="Example: 3"
                      Error="@Has(LaunchFields.HealthRetries)" ErrorText="@Error(LaunchFields.HealthRetries)" />
        <MudTextField Margin="Margin.Dense" T="string" @bind-Value="Form.HealthStartPeriod" Label="Health start period" Immediate="true" HelperTextOnFocus="true" Variant="Variant.Filled" Disabled="Form.NoHealthcheck" HelperText="Example: 10s"
                      Error="@Has(LaunchFields.HealthStartPeriod)" ErrorText="@Error(LaunchFields.HealthStartPeriod)" />
    </div>
</MudForm>
@Below
</div>

@* The action rail, drawn as the Files rail: MudBlazor's filled small
   icon buttons with its own Material icons, in the app's verb colours — green
   puts something in or starts, light blue takes a copy out, blue creates, amber
   takes back, red destroys. Every button is always there; one that cannot act
   greys out, so the rail never moves. *@
<div class="wslc-action-rail wslc-files-rail" role="toolbar">
    @* Load JSON file: an inspect output or an exported launch request fills the fields. The
       file chosen is not shown here (MudBlazor's own chip would push the rail out of line):
       the fill status and the snackbar name it. *@
    <MudFileUpload T="IBrowserFile" FilesChanged="LoadJsonAsync" Accept=".json,application/json">
        <CustomContent>
            <MudIconButton Color="Color.Success" Icon="@Icons.Material.Filled.UploadFile" Size="Size.Small" Variant="Variant.Filled"
                           title="Load JSON file" Disabled="_busy" OnClick="@context.OpenFilePickerAsync" />
        </CustomContent>
        <SelectedTemplate></SelectedTemplate>
    </MudFileUpload>
    @* Full variables: a switch on Export, green while on. Off, the export is what wslc knows
       (View & edit: the inspect JSON; Run and Create: the form without the agent's fields). On,
       the form as a launch request with what only the agent keeps, the restart policy and the
       public names, for another WSLC AI Agent. Load JSON reads both. *@
    <MudIconButton Color="@(_fullVariables ? Color.Success : Color.Default)" Icon="@Icons.Material.Filled.DataObject" Size="Size.Small" Variant="Variant.Filled"
                   title="@(_fullVariables ? "Full variables (WSLC AI Agent compatible): on — Export carries the restart policy and the public names" : "Full variables (WSLC AI Agent compatible): off — Export is what wslc knows")"
                   Disabled="_busy" OnClick="@(() => _fullVariables = !_fullVariables)" />
    @* Export JSON: in View & edit the container's inspect JSON from the agent; otherwise the form as a
       launch request. The browser downloads the link; a native client writes the file itself. *@
    @if (Files.Supported)
    {
        <MudIconButton Color="Color.Info" Icon="@Icons.Material.Filled.FileDownload" Size="Size.Small" Variant="Variant.Filled"
                       title="@ExportTitle" Disabled="_busy" OnClick="SaveExportAsync" />
    }
    else
    {
        <MudIconButton Color="Color.Info" Icon="@Icons.Material.Filled.FileDownload" Size="Size.Small" Variant="Variant.Filled"
                       title="@ExportTitle" Disabled="_busy" Href="@ExportHref" Target="_blank" download="@ExportName" />
    }
    @* Save creates (or recreates) and leaves the container stopped; Run creates and starts it.
       In View & edit both remove the container first, so both wear the destroying colour. *@
    <MudIconButton Color="@(Mode == LaunchMode.Edit ? Color.Error : Color.Primary)" Icon="@Icons.Material.Filled.Save" Size="Size.Small" Variant="Variant.Filled"
                   title="@SaveTitle" Disabled="_busy" OnClick="@(() => SubmitAsync(start: false))" />
    <MudIconButton Color="@(Mode == LaunchMode.Edit ? Color.Error : Color.Success)" Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" Variant="Variant.Filled"
                   title="@RunTitle" Disabled="_busy" OnClick="@(() => SubmitAsync(start: true))" />
    <MudIconButton Color="Color.Warning" Icon="@Icons.Material.Filled.Close" Size="Size.Small" Variant="Variant.Filled"
                   title="Cancel the changes made in this form" Disabled="_busy" OnClick="CancelAsync" />
</div>

@* The veil while the agent works: what is being done. Nothing here is clickable. A run or
   a create holds it only until the agent has taken the job: the form closes then, and the
   Containers table follows the pull and the start. *@
<MudOverlay Visible="_busy" Absolute="true" DarkBackground="true" AutoClose="false" LockScroll="false" ZIndex="10">
    <MudPaper Class="pa-4" Elevation="4">
        <MudStack AlignItems="AlignItems.Center" Spacing="2">
            <MudProgressCircular Color="Color.Info" Size="Size.Large" Indeterminate="true" />
            <MudText Typo="Typo.subtitle1" role="status">@_busyTitle</MudText>
        </MudStack>
    </MudPaper>
</MudOverlay>
</div>

@code {
    private MudForm _form = default!;
    private string _fill = "";
    private string _fillStatus = "";

    /// <summary>The status says something was not used: shown as an error line.</summary>
    private bool _fillFlagged;

    private bool _busy;
    private string _busyTitle = "";

    /// <summary>What the check or the failed launch said about one field: shown in that field instead of its example.</summary>
    private readonly Dictionary<string, string> _fields = new(StringComparer.Ordinal);

    /// <summary>What is about no field in particular: shown above the fields.</summary>
    private readonly List<(Severity Severity, string Text)> _general = [];

    private string _commandBeforeKeepRunning = "";

    /// <summary>Export carries the agent's own fields as well; off by default, the export is wslc's.</summary>
    private bool _fullVariables;

    /// <summary>What the form was opened with: Cancel puts the fields back to it, and it tells whether anything was changed.</summary>
    private ContainerLaunchRequest _opened = default!;

    private string _openedJson = "";
    private LaunchForm? _snapshotOf;

    /// <summary>What the image last read put into the fields: taken back when the image changes.</summary>
    private ContainerLaunchRequest? _imageDefaults;

    /// <summary>The image the fields were last read for, so leaving its field asks only when it changed.</summary>
    private string _defaultsOf = "";

    /// <summary>What the image set, or that it is not on the machine.</summary>
    private string _imageNote = "";

    /// <summary>The pull the form asked for, while it runs and once it failed: the host draws it as the ring, and the note says what it is about.</summary>
    private ImagePullState? _pull;

    /// <summary>The pull the form asked for, for the window's title to draw; null when there is none.</summary>
    public ImagePullState? Pull => _pull;

    /// <summary>The image is not on the machine and no pull of it is on its way: the note offers one.</summary>
    private bool _imageMissing;

    private bool _disposed;

    [Parameter, EditorRequired] public LaunchMode Mode { get; set; }

    /// <summary>The fields, pre-filled for Edit from the container's details.</summary>
    [Parameter] public LaunchForm Form { get; set; } = new();

    /// <summary>Edit only: the container to remove and recreate.</summary>
    [Parameter] public string SourceId { get; set; } = "";

    /// <summary>What the main column shows above the fields (the details page's summary card).</summary>
    [Parameter] public RenderFragment? Above { get; set; }

    /// <summary>What the main column shows below the fields (the raw inspect JSON).</summary>
    [Parameter] public RenderFragment? Below { get; set; }

    /// <summary>Extra classes for the main column: the details page hands it the panel's scroll.</summary>
    [Parameter] public string MainClass { get; set; } = "";

    /// <summary>Raised when Fill, Load JSON or the image picker changed the image, for a title that shows it.</summary>
    [Parameter] public EventCallback OnImageChanged { get; set; }

    /// <summary>Raised when the pull the form asked for starts, moves or ends, for the host that draws it (<see cref="Pull"/>).</summary>
    [Parameter] public EventCallback OnPullChanged { get; set; }

    /// <summary>Raised with the new container's id once the agent said it is there (created, or created and started).</summary>
    [Parameter] public EventCallback<string> OnDone { get; set; }

    /// <summary>Raised after the rail's Cancel put the fields back, for a host that shows the same data elsewhere.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>
    /// The fields as they were handed over are the mark: a form opened again on
    /// another container takes a new one. A form opened on an image (Run from
    /// its row) takes what the image sets as part of what it opened with, not
    /// as an edit to ask about on the way out.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (ReferenceEquals(_snapshotOf, Form))
        {
            return;
        }

        _snapshotOf = Form;
        Snapshot();
        await LoadImageDefaultsAsync(replaced: true, ask: false);
        Snapshot();
    }

    private void Snapshot()
    {
        _opened = Form.ToRequest();
        _openedJson = JsonSerializer.Serialize(_opened, ExportJson);
    }

    public void Dispose() => _disposed = true;

    /// <summary>
    /// What the image sets, into the fields: its variables, command,
    /// entrypoint, working folder, user and health check, under whatever the
    /// form already says. View &amp; edit has them from the container itself.
    /// An image that is not on the machine cannot be read: the note says so and
    /// offers the pull, and <paramref name="ask"/> asks at once, for a Fill or
    /// a loaded file, which name an image on purpose.
    /// </summary>
    /// <param name="replaced">The fields were just written whole (Fill, Load JSON, Cancel, a new form): nothing of the image read before is left in them to take back.</param>
    private async Task LoadImageDefaultsAsync(bool replaced, bool ask)
    {
        if (Mode == LaunchMode.Edit)
        {
            return;
        }

        var image = Form.Image;
        if (_imageDefaults is not null && !replaced)
        {
            Form.DropImageDefaults(_imageDefaults);
        }

        _imageDefaults = null;
        _defaultsOf = image;
        _imageNote = "";
        _imageMissing = false;
        await ShowPullAsync(null);
        if (image.Length == 0 || await ImageDefaultsAsync(image) is not { } defaults)
        {
            return;
        }

        if (defaults.Local)
        {
            Apply(defaults.Form);
            return;
        }

        await MissingAsync(image);
        if (ask && await DialogFlow.ConfirmAsync(Dialogs, "Image not on this machine",
                $"{image} is not on this machine, so the form cannot show what it sets: its variables, command and user.\n\n"
                + "Pull it now? It can take minutes and gigabytes. Without it the form stays as it is, and Run or Save pull the image when you go on.", "Pull"))
        {
            await PullForDefaultsAsync();
        }
    }

    /// <summary>The image's own fields from the agent; null when the form moved on to another image meanwhile, or the agent did not say (an older one has no such answer): the form is then as it always was.</summary>
    private async Task<ImageDefaults?> ImageDefaultsAsync(string image)
    {
        try
        {
            var defaults = await Api.GetImageDefaultsAsync(image);
            return _disposed || Form.Image != image ? null : defaults;
        }
        catch (Exception ex) when (ex is AgentApiException or HttpRequestException)
        {
            return null;
        }
    }

    private void Apply(ContainerLaunchRequest image)
    {
        Form.ApplyImageDefaults(image);
        _imageDefaults = image;
        _imageMissing = false;
        _imageNote = $"{image.Image} sets {image.Env.Count} variable(s){(image.Command.Length > 0 || image.Entrypoint.Length > 0 ? ", what it runs" : "")}"
            + $"{(image.Workdir.Length > 0 ? ", its working folder" : "")}{(image.User.Length > 0 ? ", its user" : "")}{(image.HealthCmd.Length > 0 ? ", its health check" : "")}: "
            + "shown in the fields the form left empty, to change before the container is made.";
    }

    /// <summary>The image cannot be read: the note says why and offers its pull.</summary>
    private Task MissingAsync(string image)
    {
        _imageMissing = true;
        _imageNote = $"{image} is not on this machine: what it sets (variables, command, user) shows here once it is pulled.";
        return ShowPullAsync(null);
    }

    /// <summary>The pull as it stands now, here and in the host that draws it.</summary>
    private async Task ShowPullAsync(ImagePullState? pull)
    {
        if (_pull == pull)
        {
            return;
        }

        _pull = pull;
        StateHasChanged();
        await OnPullChanged.InvokeAsync();
    }

    /// <summary>
    /// The pull the user agreed to, drawn in the form while it goes (the window
    /// covers the activity line), then the image's fields. One that failed
    /// keeps its ring, with its output and the cross that dismisses it; one
    /// cancelled goes back to the offer.
    /// </summary>
    private async Task PullForDefaultsAsync()
    {
        var image = Form.Image;
        _imageMissing = false;
        _imageNote = "";
        // The ring at the press: the agent takes a moment to say the pull has started.
        await ShowPullAsync(new ImagePullState(image, "running", 0, "Starting the pull…", ""));
        bool pulled;
        try
        {
            pulled = await Pulls.PullAsync(image, state =>
            {
                if (!_disposed && Form.Image == image)
                {
                    _ = InvokeAsync(() => ShowPullAsync(state));
                }
            });
        }
        catch (Exception ex) when (ex is AgentApiException or HttpRequestException)
        {
            await MissingAsync(image);
            Snackbar.Add($"Pull of {image}: {ex.Message}", Severity.Error);
            return;
        }

        if (_disposed || Form.Image != image)
        {
            return;
        }

        if (pulled)
        {
            await ShowPullAsync(null);
            if (await ImageDefaultsAsync(image) is { Local: true } defaults)
            {
                Apply(defaults.Form);
            }
        }
        else if (_pull is not { State: "error" })
        {
            await MissingAsync(image);
        }

        StateHasChanged();
    }

    /// <summary>The ring's tooltip: the step under way, or why the pull failed.</summary>
    public static string PullStatus(ImagePullState pull) => pull.State == "error" && pull.Error.Length > 0 ? pull.Error : pull.Status;

    /// <summary>What the ring in the title is about: a pull in a form is not the row of a list, which its name explains.</summary>
    private static string PullNote(ImagePullState pull) => pull.State == "running"
        ? $"Pulling {pull.Image}{(pull.Status.Length > 0 ? $": {pull.Status}" : "")}. What it sets (variables, command, user) shows in the fields when it ends. "
          + "The ring beside Close follows it: the lines open its output, the cross stops it."
        : $"Pull of {pull.Image} failed: {PullStatus(pull)}. Beside Close, the lines open its output and the cross dismisses it.";

    /// <summary>The ring's lines: the pull's console.</summary>
    public Task ShowPullLogAsync() =>
        _pull is { } pull ? PullFlow.ShowLogAsync(Dialogs, pull.Image, finished: pull.State != "running") : Task.CompletedTask;

    /// <summary>The ring's cross while the pull runs: asks, then stops it; the pull's own end takes the ring away.</summary>
    public Task CancelPullAsync() =>
        _pull is { } pull ? PullFlow.CancelAsync(Dialogs, Api, Snackbar, pull.Image) : Task.CompletedTask;

    /// <summary>The cross of a failed pull: the agent forgets it, and the form goes back to offering one.</summary>
    public async Task DismissPullAsync()
    {
        if (_pull is { } pull)
        {
            await PullFlow.DismissAsync(Api, Snackbar, pull.Image);
            await MissingAsync(Form.Image);
        }
    }

    /// <summary>A name typed by hand is known once its field is left: read then, without asking for a pull nobody asked for.</summary>
    private async Task OnImageBlurAsync()
    {
        if (Form.Image != _defaultsOf)
        {
            await LoadImageDefaultsAsync(replaced: false, ask: false);
        }
    }

    /// <summary>True while the fields hold something other than what the form was opened with.</summary>
    private bool Changed => JsonSerializer.Serialize(Form.ToRequest(), ExportJson) != _openedJson;

    /// <summary>
    /// Asks before leaving the form with edits in it and answers whether to go on;
    /// nothing changed, nothing to ask. The window's Close calls it, so no way out
    /// of the form drops what was typed in silence. While the agent is creating or
    /// recreating there is no leaving: closing would not stop it, only hide how it
    /// ended. A run or a create closes the form itself once the agent has it.
    /// </summary>
    public async Task<bool> ConfirmLeaveAsync()
    {
        if (_busy)
        {
            Snackbar.Add($"{_busyTitle} Wait for it to finish.", Severity.Info);
            return false;
        }

        return !Changed || await DialogFlow.ConfirmAsync(Dialogs, "Close",
            "The changes made in this form have not been saved. Close anyway?", "Close", destructive: true);
    }

    /// <summary>
    /// The rail's Cancel: it cancels the edits, not the window. After asking, the fields
    /// go back to what they held when the form opened and the form stays where it is.
    /// </summary>
    private async Task CancelAsync()
    {
        if (!Changed || !await DialogFlow.ConfirmAsync(Dialogs, "Cancel changes",
                "Put the fields back to what this form was opened with? The changes made here are lost.", "Discard changes", destructive: true))
        {
            return;
        }

        Form.CopyFrom(LaunchForm.From(_opened));
        ClearMessages();
        await LoadImageDefaultsAsync(replaced: true, ask: false);
        await OnImageChanged.InvokeAsync();
        await OnCancel.InvokeAsync();
    }

    /// <summary>
    /// A row with Reverse proxy ticked needs the container to share a
    /// user-defined network with the nginx container, and the agent never
    /// attaches it: the form checks here, before the verb asks anything. Sharing
    /// none, it offers the default network of Settings — a yes adds the row to
    /// Networks and goes on; a no stops with nothing touched. The agent refuses
    /// the same way should a request arrive otherwise.
    /// </summary>
    private async Task<bool> PublishableAsync()
    {
        if (Form.PublicNames.Count == 0)
        {
            return true;
        }

        PublishingSettings settings;
        IReadOnlyList<string> proxyNetworks;
        try
        {
            settings = await Api.GetPublishingSettingsAsync();
            var proxy = (await Api.GetContainersAsync(all: true)).Containers.FirstOrDefault(c => c.Name.Equals(settings.ProxyContainer, StringComparison.OrdinalIgnoreCase));
            if (proxy is null)
            {
                await DialogFlow.ExplainAsync(Dialogs, "Reverse proxy",
                    $"The nginx container '{settings.ProxyContainer}' is not on this machine.",
                    "Reverse proxy needs it running here: it is the container that reads the map and answers the public names. "
                    + "Settings → Publish names it; docs/developer/remote-access.md is how to set it up.");
                return false;
            }

            proxyNetworks = proxy.Networks.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        }
        catch (Exception ex) when (ex is AgentApiException or HttpRequestException)
        {
            Snackbar.Add($"Publishing: {ex.Message}", Severity.Error);
            return false;
        }

        var shared = Form.Networks.Select(n => n.Name.Trim())
            .Where(n => n.Length > 0 && !NetworkSummary.IsBuiltIn(n.ToLowerInvariant()))
            .Any(n => proxyNetworks.Contains(n, StringComparer.OrdinalIgnoreCase));
        if (shared)
        {
            return true;
        }

        var add = await DialogFlow.ConfirmAsync(Dialogs, "Reverse proxy",
            $"This container shares no user-defined network with the nginx container '{settings.ProxyContainer}', so the proxy cannot reach it by name "
            + $"(names resolve only on a user-defined network, never on the default bridge).\n\nAdd the network '{settings.Network}' to its Networks and go on?",
            $"Add {settings.Network}");
        if (!add)
        {
            return false;
        }

        Form.Networks.Add(new NetworkRow { Name = settings.Network });
        return true;
    }

    private string SaveTitle => Mode == LaunchMode.Edit
        ? "Save: remove the container and create it again with these settings, left stopped"
        : "Save: create the container with these settings, left stopped (the image is pulled first when it is not local)";

    private string RunTitle => Mode == LaunchMode.Edit
        ? "Save & start: remove the container, create it again with these settings and start it"
        : "Run: create the container and start it (the image is pulled first when it is not local)";

    private string Named => Form.Name.Length > 0 ? Form.Name : Mode == LaunchMode.Edit ? SourceId : "the container";

    /// <summary>View &amp; edit exports the inspect JSON unless Full variables asks for the form.</summary>
    private bool ExportsInspect => Mode == LaunchMode.Edit && !_fullVariables;

    private string ExportTitle => ExportsInspect ? "Export inspect JSON" : _fullVariables ? "Export the form as JSON, full variables" : "Export the form as JSON";

    private string ExportName => ExportsInspect
        ? $"{(Form.Name.Length > 0 ? Form.Name : SourceId)}-inspect.json"
        : $"{(Form.Name.Length > 0 ? Form.Name : "container")}.json";

    /// <summary>The form as the export writes it: the agent's own fields only with Full variables on.</summary>
    private string FormJson => JsonSerializer.Serialize(LaunchExport.Of(Form.ToRequest(), _fullVariables), ExportJson);

    /// <summary>View &amp; edit downloads the inspect JSON from the agent; the form is handed over as a data URL, no round trip.</summary>
    private string ExportHref => ExportsInspect
        ? Api.ContainerInspectJsonUrl(SourceId).ToString()
        : "data:application/json;charset=utf-8," + Uri.EscapeDataString(FormJson);

    private static readonly JsonSerializerOptions ExportJson = new(JsonSerializerDefaults.Web) { WriteIndented = true };

    /// <summary>The native clients' Export: the same document the link serves, written through the OS Save As.</summary>
    private Task SaveExportAsync() =>
        ClientFileSave.TextAsync(Files, Snackbar, ExportName, () => ExportsInspect
            ? Api.GetContainerInspectJsonAsync(SourceId)
            : Task.FromResult(FormJson));

    private async Task LoadJsonAsync(IBrowserFile? file)
    {
        if (file is null)
        {
            return;
        }

        try
        {
            using var reader = new StreamReader(file.OpenReadStream(maxAllowedSize: 4 * 1024 * 1024));
            var request = await Api.ParseLaunchFormAsync(await reader.ReadToEndAsync());
            Form.CopyFrom(LaunchForm.From(request));
            _fillStatus = $"Loaded {file.Name}";
            _fillFlagged = false;
            await OnImageChanged.InvokeAsync();
            Snackbar.Add($"Loaded {file.Name}", Severity.Success);
            // Last: a pull the user agrees to here takes minutes.
            await LoadImageDefaultsAsync(replaced: true, ask: true);
        }
        catch (Exception ex) when (ex is AgentApiException or HttpRequestException or IOException)
        {
            Snackbar.Add($"Load JSON failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task PickImageAsync()
    {
        var picked = await Pickers.ImageAsync(Dialogs, Api, Form.ImageRef);
        if (picked is not null)
        {
            Form.ImageRef = picked;
            await LoadImageDefaultsAsync(replaced: false, ask: false);
            await OnImageChanged.InvokeAsync();
        }
