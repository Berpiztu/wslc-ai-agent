    private async Task OnFillKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Fill();
        }
    }

    /// <summary>The pasted run line into the fields, then what its image sets; unsupported flags are named, never silently dropped.</summary>
    private async Task Fill()
    {
        var parse = RunCommandLine.Parse(_fill);
        _fillStatus = parse.Summary;
        _fillFlagged = parse.Request is null || parse.Unsupported.Count > 0;
        if (parse.Request is not null)
        {
            Form.CopyFrom(LaunchForm.From(parse.Request));
            await OnImageChanged.InvokeAsync();
            // Last: a pull the user agrees to here takes minutes.
            await LoadImageDefaultsAsync(replaced: true, ask: true);
        }
    }

    private bool Has(string field) => _fields.ContainsKey(field);

    private string? Error(string field) => _fields.GetValueOrDefault(field);

    private void ClearMessages()
    {
        _fields.Clear();
        _general.Clear();
    }

    /// <summary>Each finding into its field, or above the fields when it names none; warnings always above as well, since a field has no warning colour.</summary>
    private void Show(IEnumerable<LaunchFinding> findings, Severity severity)
    {
        foreach (var finding in findings)
        {
            if (severity == Severity.Error && finding.Field != LaunchFields.General)
            {
                _fields[finding.Field] = _fields.TryGetValue(finding.Field, out var already) ? $"{already} {finding.Message}" : finding.Message;
            }
            else
            {
                _general.Add((severity, finding.Message));
            }
        }
    }

    /// <summary>A failed launch: the fields it is about carry the reason; what is about none, or the whole message when it named no field, goes above.</summary>
    private void ShowFailure(string message, IReadOnlyDictionary<string, string> fields)
    {
        if (fields.Count == 0)
        {
            _general.Add((Severity.Error, message));
            return;
        }

        Show(fields.Select(f => new LaunchFinding(f.Key, f.Value)), Severity.Error);
    }

    /// <summary>
    /// Save or Run: the fields validated, the public names made possible, the
    /// agent's check (errors stop here, warnings are confirmed), the verb's own
    /// question, then the launch under the veil until the agent says the container
    /// is there. Whatever fails comes back into the form; the form never closes on
    /// a failure.
    /// </summary>
    private async Task SubmitAsync(bool start)
    {
        // The veil at the press, painted before anything is asked of the agent:
        // on a slower machine the checks take seconds, and a button that shows
        // nothing for that long looks as if it did nothing.
        Busy("Checking the settings…");
        await Task.Yield();
        if (await ReadyAsync(start) is not { } request)
        {
            Idle();
            return;
        }

        Busy(Mode == LaunchMode.Edit
            ? $"Recreating {Named}: the new settings are rehearsed first, then the container is replaced. This can take a minute."
            : start ? $"Starting {Named}…" : $"Creating {Named}…");
        try
        {
            if (Mode == LaunchMode.Edit)
            {
                var created = await Api.RecreateContainerAsync(SourceId, request);
                // Said on the title bar's activity line, which the form closing uncovers:
                // with what the recreate had to adjust, in the info tone so it is read.
                if (created.Notes.Count == 0)
                {
                    Activity.Done($"Recreated {Named}");
                }
                else
                {
                    Activity.Say($"Recreated {Named}. {string.Join(" ", created.Notes)}");
                }

                await OnDone.InvokeAsync(created.Id);
            }
            else
            {
                await Api.LaunchContainerAsync(request);
                Activity.Say($"{(start ? "Run" : "Create")} started — watch the Containers table");
                await OnDone.InvokeAsync("");
            }
        }
        catch (AgentApiException ex)
        {
            ShowFailure(ex.Message, ex.Fields);
        }
        catch (HttpRequestException ex)
        {
            _general.Add((Severity.Error, ex.Message));
        }
        finally
        {
            Idle();
        }
    }

    /// <summary>The request once the fields are valid, the public names possible, the agent's check passed and the verb confirmed; null when any of them stops it.</summary>
    private async Task<ContainerLaunchRequest?> ReadyAsync(bool start)
    {
        await _form.ValidateAsync();
        if (!_form.IsValid || !await PublishableAsync())
        {
            return null;
        }

        ClearMessages();
        var request = Form.ToRequest() with { Start = start };
        return await CheckedAsync(request, start) && await ConfirmVerbAsync(start) ? request : null;
    }

    /// <summary>The agent's check under the veil: errors go into the fields and stop; warnings are listed above the fields and asked about.</summary>
    private async Task<bool> CheckedAsync(ContainerLaunchRequest request, bool start)
    {
        Busy("Checking the settings…");
        LaunchCheck check;
        try
        {
            check = await Api.CheckContainerLaunchAsync(request, Mode == LaunchMode.Edit ? SourceId : "");
        }
        catch (Exception ex) when (ex is AgentApiException or HttpRequestException)
        {
            Snackbar.Add($"The settings could not be checked: {ex.Message}", Severity.Warning);
            Idle();
            return true;
        }

        Idle();
        Show(check.Errors, Severity.Error);
        Show(check.Warnings, Severity.Warning);
        if (!check.Ok)
        {
            return false;
        }

        if (check.Warnings.Count == 0)
        {
            return true;
        }

        var text = string.Join("\n\n", check.Warnings.Select(w => "• " + w.Message));
        return await DialogFlow.ConfirmAsync(Dialogs, "Worth a look",
            $"{text}\n\nThese do not stop the launch, and a product may well be right where the form looks wrong. Go on?",
            start ? "Run anyway" : "Save anyway");
    }

    /// <summary>The rail's verb asks before it acts, whichever verb it is.</summary>
    private Task<bool> ConfirmVerbAsync(bool start) => Mode switch
    {
        LaunchMode.Edit => DialogFlow.ConfirmAsync(Dialogs, "View & edit",
            $"This will REMOVE container {Named} and create a new one with the edited settings (ports, env, etc.), {(start ? "then start it" : "left stopped")}.\n\n"
            + "The new settings are tried first under a temporary name: if they cannot start, the container is left as it is.\n\n"
            + "Container filesystem data is lost unless volumes are remounted.\n\nContinue?", "Recreate", destructive: true),
        _ when start => DialogFlow.ConfirmAsync(Dialogs, "Run container",
            $"Run {Form.Image}{(Form.Name.Length > 0 ? $" as {Form.Name}" : "")}? It is pulled first if it is not on this machine.{UnreadNote}", "Run"),
        _ => DialogFlow.ConfirmAsync(Dialogs, "Create container",
            $"Create {(Form.Name.Length > 0 ? Form.Name : "a container")} from {Form.Image}, stopped? The image is pulled first if it is not on this machine.{UnreadNote}", "Save"),
    };

    /// <summary>
    /// Said by Save and Run when the image has not been read, because it is not
    /// on the machine yet or its pull is still on its way: the fields do not
    /// show what it sets. It is a notice, not a stop: the container takes the
    /// image's own settings whether the form showed them or not.
    /// </summary>
    private string UnreadNote => Mode != LaunchMode.Edit && _imageDefaults is null && (_imageMissing || _pull is not null)
        ? "\n\nThe image has not been pulled yet, so the fields do not show what it sets (its variables, command and user). "
          + "The container is made with the image's own all the same; View & edit shows them once it exists."
        : "";


    // Both paint at once: a click paints by itself only at its first wait and
    // at its end, and the veil goes up and down several times in between.
    private void Busy(string title)
    {
        _busy = true;
        _busyTitle = title;
        StateHasChanged();
    }

    private void Idle()
    {
        _busy = false;
        StateHasChanged();
    }
}
