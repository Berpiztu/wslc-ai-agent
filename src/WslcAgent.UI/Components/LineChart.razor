@* The chart panel, shared by Home's metrics and the container stats:
   the title and the latest value on one line at the left (with the zoom tools
   at the right when asked for: zoom in, zoom out, reset), the chart filling the
   panel (wslc-line-chart.js), the legend under it. *@
@implements IAsyncDisposable
@inject IJSRuntime Js

<div class="@(Compact ? "wslc-chart-panel wslc-chart-compact" : "wslc-chart-panel")">
    @if (!Compact)
    {
        <div class="wslc-chart-header">
            <div class="wslc-chart-title"><span>@Title</span> <span>@Value</span></div>
            @if (Zoom)
            {
                <div class="wslc-chart-tools" role="group" aria-label="@($"{Title} zoom")">
                    <MudIconButton Icon="@Icons.Material.Filled.ZoomIn" Size="Size.Small" title="Zoom in" aria-label="Zoom in" OnClick="@(() => CallAsync("zoomIn"))" />
                    <MudIconButton Icon="@Icons.Material.Filled.ZoomOut" Size="Size.Small" title="Zoom out" aria-label="Zoom out" OnClick="@(() => CallAsync("zoomOut"))" />
                    <MudIconButton Icon="@Icons.Material.Filled.SettingsBackupRestore" Size="Size.Small" title="Reset zoom" aria-label="Reset zoom" OnClick="@(() => CallAsync("zoomReset"))" />
                </div>
            }
        </div>
    }
    <div class="wslc-chart-canvas" @ref="_host"><canvas aria-label="@($"{Title} chart")"></canvas></div>
    @if (!Compact)
    {
        <ChartLegend Series="Series" Format="@Format" />
    }
</div>

@code {
    private ElementReference _host;
    private IJSObjectReference? _module;
    private IJSObjectReference? _chart;

    /// <summary>What the chart was last given: the number of samples, the last one's time, the series and the ceiling.</summary>
    private (int Count, long Last, int Series, double Ceiling)? _fed;

    /// <summary>A line and its legend entry; the second colour for the second line of a pair (write, TX).</summary>
    public sealed record Line(string Label, bool Secondary = false);

    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter] public string Value { get; set; } = "—";

    /// <summary><c>percent</c> or <c>bytes</c>: how the axis and the tooltip write a value.</summary>
    [Parameter, EditorRequired] public string Format { get; set; } = "percent";

    [Parameter, EditorRequired] public IReadOnlyList<Line> Series { get; set; } = [];

    /// <summary>Sample times, Unix milliseconds.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<long> Times { get; set; } = [];

    /// <summary>One array per series, as long as <see cref="Times"/>.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<double[]> Values { get; set; } = [];

    /// <summary>A ceiling kept only once the data comes near it (CPU: 100 %).</summary>
    [Parameter] public double? YMax { get; set; }

    /// <summary>A ceiling the axis grows to (a container's memory limit); zero for none.</summary>
    [Parameter] public double ForceYMax { get; set; }

    /// <summary>The zoom tools in the header, as the container stats have them.</summary>
    [Parameter] public bool Zoom { get; set; }

    /// <summary>A sparkline: the lines alone, filling the box they are given, for a dashboard chart whose title, value and legend are objects of their own (ChartLegend).</summary>
    [Parameter] public bool Compact { get; set; }

    /// <summary>
    /// The chart is created on the first render and fed when a sample is new. Both calls
    /// can arrive after the panel has gone — the app opens on Home and is sent to
    /// the sign-in screen while the module is still loading — and a chart with no
    /// place to draw is not a failure the user has to read about: `create` answers
    /// nothing and this page simply has no chart.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                _module = await Js.InvokeAsync<IJSObjectReference>("import", "./_content/WslcAgent.UI/wslc-line-chart.js");
                _chart = await _module.InvokeAsync<IJSObjectReference>("create", _host, new
                {
                    yMin = 0,
                    yMax = YMax,
                    format = Format,
                    series = Series.Select(s => new { label = s.Label, colour = s.Secondary ? "secondary" : "primary" }).ToArray(),
                });
            }

            // Only what is new is sent: the panel is drawn again for many reasons
            // — a tap, a selection — and each sent the whole history and redrew
            // the canvas with the same lines.
            // A sample is new when the count or the last time moved; the same
            // times always carry the same values.
            var fed = (Times.Count, Times.Count > 0 ? Times[^1] : 0, Values.Count, ForceYMax);
            if (_chart is not null && fed != _fed)
            {
                _fed = fed;
                await _chart.InvokeVoidAsync("update", Times, Values, ForceYMax);
            }
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException)
        {
            // The panel left while this was in flight.
        }
    }

    private async Task CallAsync(string verb)
    {
        if (_chart is not null)
        {
            await _chart.InvokeVoidAsync(verb);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_chart is not null)
            {
                await _chart.InvokeVoidAsync("dispose");
                await _chart.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException)
        {
            // The page is going away.
        }
    }
}
