@* The logs' tab of a project's window (ProjectPanesDialog), in the view a
   container's logs are read in (LogsView), with its rail (search, wrap,
   autorefresh, refresh, jump to end, copy). All: the project's logs as one,
   what each container wrote in the order it was written, each line said by
   its container, the names in a column; the agent puts them together (GET
   /projects/{name}/logs), so the lines of several are in order in time and
   not one container's after another's; the project's backups and restores,
   and its containers', among them in the order they were written (two keys
   of the rail show either alone). A container: its own logs, with its own
   backups and restores, as its Logs opens them; while the agent carries
   something out on it, that work's log instead (MemberWork): the pull's console, the patch's build log. *@
@inherits ProjectPaneTab
@inject WslcAgentApi Api

@if (Chosen is { } chosen)
{
    <MemberWork Member="chosen">
        <LogsView @key="chosen.Id" Container="@chosen.Id" Backups="@(() => BackupLogLines.OfContainerAsync(Api, chosen.Name))" />
    </MemberWork>
}
else
{
    <LogsView @key="Project" Read="ReadAllAsync" ReadTimed="ReadAllTimedAsync"
              Backups="@(() => BackupLogLines.OfProjectAsync(Api, Project, [.. Members.Select(member => member.Name)]))" />
}

@code {
    /// <summary>The lines of each container All begins with: the view's own default for a container, for each of the project's.</summary>
    private const int Tail = 200;

    /// <summary>What All shows with the backups among it: each line of the project's logs by the time wslc stamped it, and its container.</summary>
    private async Task<IReadOnlyList<TimedLine>> ReadAllTimedAsync() =>
        [.. (await Api.GetProjectLogsAsync(Project, Tail)).Lines.Select(line =>
            new TimedLine(DateTimeOffset.TryParse(line.Time, out var at) ? at : DateTimeOffset.MinValue, line.Container, LogLines.Output, line.Text))];

    /// <summary>What All shows: the project's logs as they are now, a line each, said by its container.</summary>
    private async Task<string> ReadAllAsync()
    {
        var lines = (await Api.GetProjectLogsAsync(Project, Tail)).Lines;
        var width = lines.Select(line => line.Container.Length).DefaultIfEmpty(0).Max();
        return string.Join('\n', lines.Select(line => $"{line.Container.PadRight(width)} | {line.Text}"));
    }
}
