@* The one password field in the application. Two things it does that a plain
   MudTextField does not, and both were found the hard way on a phone:

   The keyboard never capitalises or corrects it. A phone shifts the first
   letter of a field by itself, so a password typed with its own capital came
   out with that capital undone — the sign-in was refused while the very same
   password pasted from the clipboard went through.

   And the eye inside it shows what was typed, because on a phone that is the
   only way to be sure of what went in. The button lives inside the field, as
   docs/RULES.md says every field's button does. *@

<MudTextField T="string" Value="@Value" ValueChanged="@ValueChanged" Label="@Label"
              InputType="@(_shown ? InputType.Text : InputType.Password)"
              Variant="Variant.Filled" Margin="Margin.Dense" Immediate="true"
              Disabled="@Disabled" Class="@Class" Error="@Error" ErrorText="@ErrorText"
              Adornment="Adornment.End"
              AdornmentIcon="@(_shown ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
              AdornmentAriaLabel="@(_shown ? "Hide the password" : "Show the password")"
              OnAdornmentClick="Toggle"
              autocomplete="@Autocomplete" autocapitalize="none" autocorrect="off" spellcheck="false" />

@code {
    private bool _shown;

    [Parameter] public string Value { get; set; } = "";

    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    [Parameter] public string Label { get; set; } = "Password";

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public string Class { get; set; } = "";

    /// <summary><c>current-password</c> to sign in, <c>new-password</c> to set one.</summary>
    [Parameter] public string Autocomplete { get; set; } = "current-password";

    [Parameter] public bool Error { get; set; }

    [Parameter] public string? ErrorText { get; set; }

    private void Toggle() => _shown = !_shown;
}
