@* The application's checkbox: MudBlazor's small dense checkbox with the Sharp
   glyphs, square corners like every button and field box. Anything else — title, aria-label — passes through. *@
<MudCheckBox T="bool" Value="Value" ValueChanged="ValueChanged" Label="@Label" Disabled="Disabled" Dense="true" Size="Size.Small"
             UncheckedIcon="@(Partly ? Icons.Material.Sharp.IndeterminateCheckBox : Icons.Material.Sharp.CheckBoxOutlineBlank)" CheckedIcon="@Icons.Material.Sharp.CheckBox"
             IndeterminateIcon="@Icons.Material.Sharp.IndeterminateCheckBox" @attributes="Attributes" />

@code {
    [Parameter] public bool Value { get; set; }

    [Parameter] public EventCallback<bool> ValueChanged { get; set; }

    [Parameter] public string? Label { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// A box that stands for several things, only some of which are ticked (an
    /// All box): unticked, it draws the dash rather than the empty square, so
    /// "some" is not read as "none". Ticking it ticks them all.
    /// </summary>
    [Parameter] public bool Partly { get; set; }

    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }
}
