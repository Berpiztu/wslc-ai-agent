@* Container state as a coloured chip (cards); the table uses StateDot. One whose
   image has known vulnerabilities says CVE after its state, in the yellow of a
   moderate one or the red of a high or a critical one (CardTone.Alarm), whatever
   its state, so whoever sees it goes to its logs, which end with what they are;
   a recreate says only that, until it is over. Any other warning (a name it
   holds, a project with a service missing) wears the yellow without the word. *@
<MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@(Paint is null ? StateColors.For(State) : Color.Default)"
         Style="@Paint" title="@(HasCve ? $"CVE: {Cve} vulnerabilities — see Logs" : null)">@(HasCve ? $"{State} · CVE" : State)</MudChip>

@code {
    [Parameter, EditorRequired] public string State { get; set; } = "";

    /// <summary>Something to mend that stops nothing (<see cref="ContainerSummary.IsWarned"/>).</summary>
    [Parameter] public bool Warned { get; set; }

    /// <summary>The worst severity its image's vulnerabilities reach (<see cref="ContainerSummary.ImageWorst"/>); empty for none.</summary>
    [Parameter] public string Cve { get; set; } = "";

    private bool HasCve => Cve.Length > 0 && State != ContainerSummary.Recreating;

    private string? Paint =>
        HasCve ? CardTone.Alarm(ImageSecurityFlow.SeverityTone(Cve))
        : Warned ? CardTone.Alarm(Color.Warning)
        : null;
}
