@* Moving a container to another version of its image, in its Update image
   window (UpdateImageDialog) and in a project's (UpdateImageTab),
   inside the form of either, whose verb starts it (StartAsync): the
   repository it runs and the version to go to. The agent pulls it, then
   recreates the container with everything else it has; the container's row
   shows the pull. Zaindari's Patch…, beside the Version (PatchOffer), says,
   once it has asked, whether the image named carries what pulling it again
   does not mend; its Patch… opens the patch window (PatchImageDialog), with
   this container ticked: the patch is built and moves it (Patched). A
   container that runs a patch is offered its original, as published. *@
@inject WslcAgentApi Api
@inject IDialogService Dialogs

<MudTextField T="string" Value="Current" Label="Current image" ReadOnly="true" Variant="Variant.Filled" Margin="Margin.Dense" />
<MudTextField T="string" Value="_repository" ValueChanged="@(text => _repository = ImageReference.Normalize(text ?? ""))" Label="Repository" Immediate="true" OnBlur="CheckPatchAsync"
              Required="true" RequiredError="A repository is required"
              autocapitalize="none" autocorrect="off" spellcheck="false"
              Variant="Variant.Filled" Margin="Margin.Dense" Class="mt-2" />
@* Zaindari's Patch… and its note beside the Version, the image the update goes to. *@
<div class="wslc-field-beside mt-2">
    <MudTextField T="string" @bind-Value="_version" Label="Version" Placeholder="1.5" Immediate="true" OnBlur="CheckPatchAsync"
                  Required="true" RequiredError="A version is required"
                  autocapitalize="none" autocorrect="off" spellcheck="false"
                  Variant="Variant.Filled" Margin="Margin.Dense" />
    <PatchOffer Image="@Target" Checking="_checking" Report="_report" OnPatch="PatchAsync" />
</div>
<MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">
    The image is pulled, then the container is recreated with its ports, mounts, environment and name. If the new version does not start, the previous container stays as it was.
    Leave latest for the version published last, or type one (1.4) to go to that one, or back to it.
</MudText>
@if (ImageReference.IsPatched(Current))
{
    <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">@Current is a patch built on this machine: Update goes to the image as published; Patch… patches it again.</MudText>
}

@code {
    private string _repository = "";
    /// <summary>latest unless another is typed: the version published last, which is what an update usually wants.</summary>
    private string _version = ImageReference.Latest;

    /// <summary>The container, by id.</summary>
    [Parameter, EditorRequired] public string Container { get; set; } = "";

    /// <summary>The image the container runs now.</summary>
    [Parameter, EditorRequired] public string Current { get; set; } = "";

    /// <summary>Told when Zaindari starts or stops being asked about the image named: the window's verb waits meanwhile.</summary>
    [Parameter] public EventCallback<bool> CheckingChanged { get; set; }

    /// <summary>Told once a patch begun from Patch… has started: it moves the container.</summary>
    [Parameter] public EventCallback Patched { get; set; }

    /// <summary>What Zaindari found on the image named, when it is on the machine.</summary>
    private ImageVulnerabilities? _report;

    /// <summary>Zaindari is being asked about the image named: the wheel turns and the verb waits.</summary>
    private bool _checking;

    private string Target => $"{_repository}:{_version.Trim()}";

    protected override async Task OnInitializedAsync()
    {
        _repository = ImageReference.RepositoryOf(ImageReference.Normalize(Current));
        await CheckPatchAsync();
    }

    /// <summary>Asks Zaindari about the image named once a field is left.</summary>
    private async Task CheckPatchAsync()
    {
        if (_report?.Image == Target)
        {
            return;
        }

        await CheckingAsync(true);
        try
        {
            _report = await Api.GetImageVulnerabilitiesAsync(Target);
        }
        catch (Exception ex) when (ex is AgentApiException or HttpRequestException)
        {
            _report = null;
        }
        finally
        {
            await CheckingAsync(false);
        }
    }

    private async Task CheckingAsync(bool checking)
    {
        _checking = checking;
        await CheckingChanged.InvokeAsync(checking);
    }

    /// <summary>The patch window, this container ticked; once the patch has started, it moves the container.</summary>
    private async Task PatchAsync()
    {
        if (_report is { Found: true } report && await ImageSecurityFlow.ShowPatchAsync(Dialogs, report, [Container]))
        {
            await Patched.InvokeAsync();
        }
    }

    /// <summary>Starts the update; the image being pulled. An <see cref="AgentApiException"/> is the window's to show.</summary>
    public async Task<string> StartAsync() => (await Api.UpdateContainerImageAsync(Container, Target)).Image;
}
