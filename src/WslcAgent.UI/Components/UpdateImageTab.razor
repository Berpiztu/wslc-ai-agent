@* Update image's tab of a project's window (ProjectPanesDialog): the update
   of the container chosen, the very one its own Update image opens
   (UpdateImageEditor), so the project's window does what going container by
   container does, and nothing else. Update starts it: the agent pulls the
   image and recreates the container, whose tab then shows the pull's console
   (MemberWork) until it is done; the window stays, for the next container. *@
@inherits ProjectPaneTab
@inject ActivityLine Activity

@if (Chosen is { } chosen)
{
    <MemberWork Member="chosen">
        @* In a main column, as Zaindari's steps: the window keeps one frame. *@
        <div class="wslc-action-body">
            <div class="wslc-action-main">
                <div class="wslc-fill-scroll wslc-member-step">
                    @if (Verb.Error is { } error)
                    {
                        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">@error</MudAlert>
                    }
                    <MudForm @ref="_form">
                        <UpdateImageEditor @key="@($"{chosen.Id} {chosen.Image}")" @ref="_editor" Container="@chosen.Id" Current="@chosen.Image"
                                           CheckingChanged="CheckingChanged" Patched="ReadAgain" />
                    </MudForm>
                </div>
            </div>
        </div>
    </MemberWork>
}

@code {
    private MudForm? _form;
    private UpdateImageEditor? _editor;

    /// <summary>Zaindari is being asked about the image named: Update waits, as the container's own window does.</summary>
    private bool _checking;

    /// <summary>The container chosen is at rest (as its own Update image asks) and Zaindari has answered.</summary>
    private bool CanUpdate => Chosen is { } chosen && ProjectMemberPanes.AtRest(chosen) && !_checking;

    public override string BusyText => "Starting the update…";

    public override RenderFragment Verbs =>
        @<MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(Verb.Busy || !CanUpdate)" OnClick="UpdateAsync">@(RunningHere ? "Starting…" : "Update")</MudButton>;

    private void CheckingChanged(bool checking)
    {
        _checking = checking;
        Repaint();
    }

    /// <summary>Started, the agent pulls and recreates it, and the menu says so; the title bar's activity line too, as a container's own update does.</summary>
    private async Task UpdateAsync()
    {
        if (_form is not { } form || _editor is not { } editor || Chosen is not { } chosen)
        {
            return;
        }

        // The veil stays until the menu has the container under way: its tab then shows the pull, and Update is never pressable in between.
        await Verb.RunAsync(chosen.Id, async () =>
        {
            await form.ValidateAsync();
            if (!form.IsValid)
            {
                return false;
            }

            var pulling = await editor.StartAsync();
            Activity.Say($"{chosen.Name}: updating to {pulling}. The container is recreated once the pull ends.");
            await ReadAgain();
            return true;
        });
    }
}
