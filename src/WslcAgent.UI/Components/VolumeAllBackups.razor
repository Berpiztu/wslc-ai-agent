@* All's Backups tab in the window of volume backups (VolumeBackupsDialog):
   every volume's backups, a table as every list is (ListGrid), its volume,
   when, size and file, the newest first, each row with Restore (into its
   volume) and Delete. A backup or restore under way stands above them, as a
   row on its way does on a list page: its bar in the Volume cell, with its
   log and its cancel; one that failed stays there, saying why, until it is
   dismissed. *@
@inject WslcAgentApi Api
@inject IDialogService Dialogs

<ListGrid TItem="VolumeBackupRow" Items="Rows" EmptyText="No backup of any volume yet.">
    <Columns>
        <PropertyColumn T="VolumeBackupRow" TProperty="string" Property="r => r.Volume" Title="Volume" StickyLeft="true" HeaderClass="@GridColumn.Width(24)" CellClass="@GridColumn.Width(24)">
            <CellTemplate>
                @if (context.Item.Job is { } job)
                {
                    <VolumeBackupRing Job="job" Row="true" Changed="Changed" />
                }
                else
                {
                    @context.Item.Volume
                }
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn T="VolumeBackupRow" TProperty="DateTimeOffset" Property="r => r.When" Title="When" HeaderClass="@GridColumn.Width(16)" CellClass="@GridColumn.Width(16)">
            <CellTemplate>@context.Item.When.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</CellTemplate>
        </PropertyColumn>
        <PropertyColumn T="VolumeBackupRow" TProperty="long" Property="r => r.Backup == null ? 0 : r.Backup.Bytes" Title="Size" HeaderClass="@GridColumn.Number(8)" CellClass="@GridColumn.Number(8)">
            <CellTemplate>@(context.Item.Backup is { } backup ? ChartBytes.Compact(backup.Bytes) : "")</CellTemplate>
        </PropertyColumn>
        @* A file moved or deleted since says so before its path, in the error colour, and cannot be restored. *@
        <PropertyColumn T="VolumeBackupRow" TProperty="string" Property="r => r.Backup == null ? r.Job!.File : r.Backup.Path" Title="File" HeaderClass="@GridColumn.Stretch(40)" CellClass="@($"{GridColumn.Stretch(40)} wslc-mono")">
            <CellTemplate>
                @if (context.Item.Backup is { Exists: false })
                {
                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Size="Size.Small" title="No longer there" />
                }
                @(context.Item.Backup?.Path ?? context.Item.Job?.File)
            </CellTemplate>
        </PropertyColumn>
    </Columns>
    <Actions>
        <TemplateColumn T="VolumeBackupRow" Title="Actions" Sortable="false" Resizable="false" DragAndDropEnabled="false" StickyRight="true" HeaderClass="@GridColumn.Actions" CellClass="@GridColumn.Actions">
            <CellTemplate>
                @if (context.Item.Backup is { } backup)
                {
                    <MudStack Row="true" Spacing="0" AlignItems="AlignItems.Center">
                        <MudIconButton Icon="@Icons.Material.Filled.CloudDownload" Size="Size.Small" Color="Color.Warning" title="@($"Restore into {backup.Volume}")"
                                       Disabled="@(!backup.Exists || Running(backup.Volume))" OnClick="@(() => RestoreAsync(backup))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" title="Delete this backup"
                                       Disabled="@(Running(backup.Volume))" OnClick="@(() => DeleteAsync(backup))" />
                    </MudStack>
                }
            </CellTemplate>
        </TemplateColumn>
    </Actions>
</ListGrid>

@code {
    /// <summary>The jobs and the history, as the window last read them.</summary>
    [Parameter, EditorRequired] public VolumeBackupList List { get; set; } = new([], []);

    /// <summary>A restore started, a backup deleted, a job cancelled or dismissed: the window reads everything again.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    private IReadOnlyList<VolumeBackupRow> Rows => VolumeBackupRow.Of(List);

    private bool Running(string volume) => VolumeBackupFlow.For(List.Jobs, volume) is { Running: true };

    private async Task RestoreAsync(VolumeBackup backup)
    {
        if (await VolumeBackupFlow.RestoreIntoAsync(Dialogs, Api, backup.Volume, backup.Path))
        {
            await Changed.InvokeAsync();
        }
    }

    private async Task DeleteAsync(VolumeBackup backup)
    {
        if (await VolumeBackupFlow.DeleteAsync(Dialogs, Api, backup))
        {
            await Changed.InvokeAsync();
        }
    }
}
