@* A volume's Backups tab in the window of volume backups
   (VolumeBackupsDialog): its backups, a table as every list is (ListGrid),
   when, size and file, the newest first, each row with Restore and Delete;
   the table takes the height left and only its rows scroll. Its backup or
   restore under way stands above them, as a row on its way does in a list
   page's table: the bar in its When cell, with its log and its cancel; one
   that failed stays there, saying why, until it is dismissed. Back up and
   Restore from a file are the window's verbs, in its title row. *@
@inject WslcAgentApi Api
@inject IDialogService Dialogs

<ListGrid TItem="VolumeBackupRow" Items="Rows" EmptyText="@($"No backup of {Volume} yet.")">
    <Columns>
        <PropertyColumn T="VolumeBackupRow" TProperty="DateTimeOffset" Property="r => r.When" Title="When" StickyLeft="true" HeaderClass="@GridColumn.Width(16)" CellClass="@GridColumn.Width(16)">
            <CellTemplate>
                @if (context.Item.Job is { } job)
                {
                    <VolumeBackupRing Job="job" Row="true" Name="@VolumeBackupFlow.Said(job.Kind)" Changed="Changed" />
                }
                else
                {
                    @context.Item.When.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                }
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn T="VolumeBackupRow" TProperty="long" Property="r => r.Backup == null ? 0 : r.Backup.Bytes" Title="Size" HeaderClass="@GridColumn.Number(8)" CellClass="@GridColumn.Number(8)">
            <CellTemplate>@(context.Item.Backup is { } backup ? ChartBytes.Compact(backup.Bytes) : "")</CellTemplate>
        </PropertyColumn>
        @* A file moved or deleted since says so before its path, in the error colour, and cannot be restored. *@
        <PropertyColumn T="VolumeBackupRow" TProperty="string" Property="r => r.Backup == null ? r.Job!.File : r.Backup.Path" Title="File" HeaderClass="@GridColumn.Stretch(40)" CellClass="@($"{GridColumn.Stretch(40)} wslc-mono")">
            <CellTemplate>
                @if (context.Item.Backup is { Exists: false })
                {
                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Size="Size.Small" title="No longer there" />
                }
                @(context.Item.Backup?.Path ?? context.Item.Job?.File)
            </CellTemplate>
        </PropertyColumn>
    </Columns>
    <Actions>
        <TemplateColumn T="VolumeBackupRow" Title="Actions" Sortable="false" Resizable="false" DragAndDropEnabled="false" StickyRight="true" HeaderClass="@GridColumn.Actions" CellClass="@GridColumn.Actions">
            <CellTemplate>
                @if (context.Item.Backup is { } backup)
                {
                    <MudStack Row="true" Spacing="0" AlignItems="AlignItems.Center">
                        <MudIconButton Icon="@Icons.Material.Filled.CloudDownload" Size="Size.Small" Color="Color.Warning" title="@($"Restore into {Volume}")"
                                       Disabled="@(!backup.Exists || Running)" OnClick="@(() => RestoreAsync(backup))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" title="Delete this backup"
                                       Disabled="Running" OnClick="@(() => DeleteAsync(backup))" />
                    </MudStack>
                }
            </CellTemplate>
        </TemplateColumn>
    </Actions>
</ListGrid>
<MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
    @* The same words for every volume: a note that names it would take another line for a longer name and move the table. *@
    Back up writes &lt;volume&gt;-&lt;date&gt;.tar.gz in the backup folder. Restore replaces what the volume holds with the
    backup's contents, its containers stopped first; Delete removes the file.
</MudText>

@code {
    [Parameter, EditorRequired] public string Volume { get; set; } = "";

    /// <summary>Its backup or restore under way, or failed and not dismissed; null for none.</summary>
    [Parameter] public VolumeBackupJob? Job { get; set; }

    /// <summary>Its backups, the newest first.</summary>
    [Parameter] public IReadOnlyList<VolumeBackup> Backups { get; set; } = [];

    /// <summary>A restore started, a backup deleted, a job cancelled or dismissed: the window reads everything again.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    /// <summary>Its job under way first, then its backups.</summary>
    private IReadOnlyList<VolumeBackupRow> Rows => VolumeBackupRow.Of(new[] { Job }.OfType<VolumeBackupJob>(), Backups);

    /// <summary>A backup or restore under way: nothing of its list can be restored or deleted meanwhile.</summary>
    private bool Running => Job is { Running: true };

    private async Task RestoreAsync(VolumeBackup backup)
    {
        if (await VolumeBackupFlow.RestoreIntoAsync(Dialogs, Api, Volume, backup.Path))
        {
            await Changed.InvokeAsync();
        }
    }

    private async Task DeleteAsync(VolumeBackup backup)
    {
        if (await VolumeBackupFlow.DeleteAsync(Dialogs, Api, backup))
        {
            await Changed.InvokeAsync();
        }
    }
}
