@* The Volumes page's verbs in the round button: Create, Backup & restore and
   Prune. Backup & restore is the one window of every volume's backups and
   restores, each volume's own screen beside the list, a restore into a volume
   not there yet (a new machine) included. Drawn by the page, and by the
   dashboard while a volume's card is selected. *@
@inherits PageVerbsBase

<VerbFab StartIcon="@Icons.Material.Filled.Add" Label="Create" Color="Color.Primary" OnClick="@(() => OpenAsync<CreateVolumeDialog>("Create volume"))" Title="Create a volume" />
<VerbFab StartIcon="@Icons.Material.Filled.Backup" Label="Backup &amp; restore" Color="Color.Primary" OnClick="BackupsAsync" Title="Every volume's backups and restores" />
<VerbFab StartIcon="@Icons.Material.Filled.DeleteSweep" Label="Prune" Color="Color.Error" OnClick="PruneAsync" Title="Remove every volume no container uses" />

@code {
    /// <summary>The window; the page reads its list again after, for what was started or created there.</summary>
    private async Task BackupsAsync()
    {
        await BackupFlow.ShowAllAsync(Dialogs, BackupKind.Volume);
        await Changed.InvokeAsync();
    }

    private Task PruneAsync() =>
        ConfirmAndRunAsync("Prune volumes", "Remove every volume no container uses? Their data is lost.", "Prune", "volumes", Api.PruneVolumesAsync);
}
