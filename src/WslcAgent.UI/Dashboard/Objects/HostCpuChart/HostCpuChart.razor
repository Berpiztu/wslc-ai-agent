@* CPU over the last two minutes: the containers' aggregate, or one
   container's, as its Stats tab draws it. Its
   subject — the host, or a container — is its property (ChartObject). *@
@namespace WslcAgent.UI.Dashboard.Objects
@using Berpiztu.Dashboard.Catalogue
@inherits ChartObject
@attribute [DashboardObject("wslc.host-cpu-chart", "CPU chart", Group = "Charts", Icon = Icons.Material.Filled.ShowChart, Source = SubjectSourceFamily.FamilyKey, DefaultSource = SubjectSourceFamily.Host, Columns = 16, Rows = 6, Fills = true, CardOnly = true)]
@attribute [DashboardObjectAlarm(DashboardMeasures.Cpu, "CPU", On = true)]

@if (Data is { } data)
{
    <HostChart Data="data" Class="@TypeClass" />
}

@code {
    protected override string Chart => HostCharts.Cpu;
}
