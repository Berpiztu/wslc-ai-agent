@* How many volumes there are: one of
   the host's counts, over the overview they share (HostOverviewRead). *@
@namespace WslcAgent.UI.Dashboard.Objects
@using Berpiztu.Dashboard.Catalogue
@inherits WslcObject
@attribute [DashboardObject("wslc.host-volumes", "Volumes count", Group = "Host readings", Subgroup = "System", Icon = Icons.Material.Filled.Storage, Columns = 8, Rows = 4)]
@attribute [DashboardObjectPart("label", "Label")]
@attribute [DashboardObjectPart("value", "Value", Bold = true)]
@attribute [DashboardObjectPart("hint", "Hint")]
@inject HostOverviewRead Overview
@inject NavigationManager Navigation

<div class="@ReadingClass">
    <ReadingSummary Label="Volumes" Value="@(Volumes is { } v ? $"{v.Count}" : "—")"
                    Hint="@ReadingHint(Volumes is not null, Volumes?.Error == true, "volumes")" Error="@(Volumes?.Error == true)" />
</div>

@code {
    private HomeCount? Volumes => Overview.Value?.Volumes;

    protected override void OnInitialized() => Follow(Overview);

    /// <summary>A count opens its page.</summary>
    public override bool Opens => true;

    public override Task OpenAsync()
    {
        Navigation.NavigateTo("volumes");
        return Task.CompletedTask;
    }
}
