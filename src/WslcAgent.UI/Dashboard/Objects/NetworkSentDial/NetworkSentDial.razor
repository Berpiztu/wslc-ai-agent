@* What the containers on a network have sent, as its share of what every
   container has: the Sent dial of the Networks list's card, standing alone.
   The share's whole comes with the network list (NetworkRows). *@
@namespace WslcAgent.UI.Dashboard.Objects
@using Berpiztu.Dashboard.Catalogue
@inherits NetworkObject
@attribute [DashboardObject("wslc.network-sent", "Network sent", Group = "Network", Subgroup = "User", Icon = Icons.Material.Filled.CallMade, Source = NetworkSourceFamily.FamilyKey, Columns = 6, Rows = 6, Anchor = Berpiztu.Dashboard.Model.HorizontalAnchor.Right, CardOnly = true)]
@attribute [DashboardObjectPart("ring", "Ring", Text = false, Line = true)]
@attribute [DashboardObjectPart("figure", "Figure")]
@attribute [DashboardObjectPart("label", "Label")]

@if (Network is { } n)
{
    <div class="@TypeClass">
        <NetworkDial Network="n" Sent="true" Total="@(List?.NetSentBytes ?? 0)" />
    </div>
}
