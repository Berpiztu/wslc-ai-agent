@* A Compose project's shortcuts: its Compose file and the logs of its
   containers as one, the group its card in the Containers list leads its
   actions row with, standing alone; its own verbs are another object
   (ProjectOwnVerbs), so the user places each. It fills its cells with the
   row's tone and stands at the left, until another alignment is chosen. In
   design the canvas makes it inert. *@
@namespace WslcAgent.UI.Dashboard.Objects
@using Berpiztu.Dashboard.Catalogue
@using Berpiztu.Dashboard.Model
@inherits ProjectObject
@attribute [DashboardObject("wslc.project-shortcuts", "Project shortcuts", Group = "Project", Subgroup = "User", Icon = Icons.Material.Filled.Apps, Source = ProjectSourceFamily.FamilyKey, Columns = 10, Rows = 2, Fills = true, Background = ThemeColor.PrimaryTint, Horizontal = HorizontalAlign.Left, Anchor = Berpiztu.Dashboard.Model.HorizontalAnchor.Left, CardOnly = true)]

@if (Head is { } head)
{
    <div class="@($"{SectionClass()} {WaitingClass}")">
        <EntityCardPart>
            <MudCardActions Class="py-1" Style="@CardTone.Style(CardTone.Of(head))">
                <VerbTaps>
                    <ProjectActions Project="@head.Name" RowKey="@head.Id" Containers="MemberNames" Running="head.IsRunning" ShortcutsAlone="true"
                                    Changed="@(() => Containers.RefreshAsync())" />
                </VerbTaps>
            </MudCardActions>
        </EntityCardPart>
    </div>
}
