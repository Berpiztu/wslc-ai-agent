@* A volume's details: what the Volumes list's card says about it in words —
   Mountpoint, Scope, Labels — as one object; its
   Read and Written dials are objects of their own. It fills its cells as the
   card's body does, and its type size scales it. *@
@namespace WslcAgent.UI.Dashboard.Objects
@using Berpiztu.Dashboard.Catalogue
@using Berpiztu.Dashboard.Model
@inherits VolumeObject
@attribute [DashboardObject("wslc.volume-details", "Volume details", Group = "Volume", Subgroup = "User", Icon = Icons.Material.Filled.Article, Source = VolumeSourceFamily.FamilyKey, Columns = 12, Rows = 6, Fills = true, Horizontal = HorizontalAlign.Left, Vertical = VerticalAlign.Top, Anchor = Berpiztu.Dashboard.Model.HorizontalAnchor.Both, CardOnly = true)]

@if (Volume is { } v)
{
    <div class="@SectionClass("wslc-card-part-details")">
        <EntityCardPart>
            <MudCardContent>
                <VolumeCardTexts Volume="v" />
            </MudCardContent>
        </EntityCardPart>
    </div>
}
