@* The title bar's second line while a verb has something to say (ActivityLine),
   and never more than that one line: the verb running, in the tertiary colour,
   with a spinner; else what one came to a moment ago, in its button's colour;
   else the newest failure, in red, with Copy and a cross, its whole text in a
   dialog on a click. When the line holds more than one thing — verbs running
   side by side, failures not closed — a count and an arrow open its list over
   the page, as the session selector opens its own: one row each, the newest
   first, a box of fixed height that scrolls, and Close all at its foot. *@
@implements IDisposable
@inject ActivityLine Line
@inject IDialogService Dialogs
@inject IJSRuntime Js

<div class="wslc-activity">
    @if (Line.Running is { } work)
    {
        <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Tertiary" Class="wslc-activity-spinner" />
        <MudText Typo="Typo.h6" Color="Color.Tertiary" Class="wslc-activity-text" title="@work.Text">@work.Text…</MudText>
    }
    else if (Line.Shown is { } note)
    {
        @if (note.Stays)
        {
            @Failure(note, Typo.h6)
        }
        else
        {
            <MudText Typo="Typo.h6" Color="note.Tone" Class="wslc-activity-text" title="@note.Text">@note.Text</MudText>
        }
    }
    @if (Line.Listed > 1)
    {
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="wslc-activity-more" PopoverClass="wslc-activity-popover">
            <ActivatorContent>
                @* MudBlazor 9 hands the activator a MenuContext and opens nothing on a click by itself. *@
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="@CountColor"
                           EndIcon="@Icons.Material.Filled.ArrowDropDown" title="Show everything the line holds"
                           OnClick="@(() => context.ToggleAsync(EventArgs.Empty))">@CountText</MudButton>
            </ActivatorContent>
            <ChildContent>
                <div class="wslc-activity-list">
                    @foreach (var running in Line.AllRunning)
                    {
                        <div class="wslc-activity-row">
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Tertiary" Class="wslc-activity-spinner" />
                            <MudText Typo="Typo.body2" Color="Color.Tertiary" Class="wslc-activity-text" title="@running.Text">@running.Text…</MudText>
                        </div>
                    }
                    @foreach (var failure in Line.Kept)
                    {
                        <div class="wslc-activity-row">@Failure(failure, Typo.body2)</div>
                    }
                </div>
                @if (Line.Kept.Count > 0)
                {
                    <div class="wslc-activity-list-foot">
                        <MudButton Size="Size.Small" Color="Color.Error" OnClick="Line.DismissAll">Close all</MudButton>
                    </div>
                }
            </ChildContent>
        </MudMenu>
    }
</div>

@code {
    protected override void OnInitialized() => Line.Changed += OnChanged;

    private int Errors => Line.Kept.Count(note => note.Tone == Color.Error);

    private int Warnings => Line.Kept.Count - Errors;

    /// <summary>What the count says: the failures and warnings, which wait for the user, before the verbs running.</summary>
    private string CountText => (Errors, Warnings) switch
    {
        (0, 0) => $"{Line.Listed} running",
        (var errors, 0) => Counted(errors, "error"),
        (0, var warnings) => Counted(warnings, "warning"),
        var (errors, warnings) => $"{Counted(errors, "error")}, {Counted(warnings, "warning")}",
    };

    private Color CountColor => Errors > 0 ? Color.Error : Warnings > 0 ? Color.Warning : Color.Tertiary;

    private static string Counted(int count, string noun) => count == 1 ? $"1 {noun}" : $"{count} {noun}s";

    /// <summary>A failure or a warning, on the line or in its list, in its own tone: the text that opens whole on a click, Copy and the cross.</summary>
    private RenderFragment Failure(ActivityNote note, Typo typo) =>
        @<text>
            <div class="wslc-activity-failure" title="Show the whole message" @onclick="@(() => ShowWholeAsync(note))">
                <MudText Typo="typo" Color="note.Tone" Class="wslc-activity-text">@note.Text</MudText>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Color="note.Tone" title="Copy" aria-label="Copy" OnClick="@(() => CopyAsync(note.Text))" />
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="note.Tone" title="Close" aria-label="Close" OnClick="@(() => Line.Dismiss(note))" />
        </text>;

    private Task ShowWholeAsync(ActivityNote note) =>
        DialogFlow.ExplainAsync(Dialogs, note.Tone == Color.Error ? "Failed" : "Warning", note.Text, "");

    private async Task CopyAsync(string text)
    {
        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", text);
        }
        catch (JSException)
        {
            // The browser refused the clipboard: the text is still on the line and in its dialog.
        }
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Line.Changed -= OnChanged;
}
