@page "/containers"
@using System.Globalization
@using WslcAgent.UI.Components.Launch
@inherits ListPageBase<ContainerSummary>
@inject OpenDetails Open
@inject FileTransfers Transfers
@inject ProjectGroups Groups
@inject ProjectVerbs Verbs
@inject BusyRows Working

<PageShell Title="Containers" RequiresSession="true">
    <TopbarSearch>
        <SearchBox @bind-Value="Search" />
    </TopbarSearch>
    <TopbarNav>
        <BulkBar Count="Selected.Count">
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success" OnClick="@(() => BulkAsync("start", (c, ct) => Api.StartContainerAsync(c.Id, ct)))">Start</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => BulkAsync("stop", (c, ct) => Api.StopContainerAsync(c.Id, ct)))">Stop</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" OnClick="@(() => BulkRemoveAsync("container", (c, ct) => Api.RemoveContainerAsync(c.Id, force: true, ct)))">Remove</MudButton>
        </BulkBar>
    </TopbarNav>
    <Verbs>
        <ContainersVerbs Changed="RefreshAsync" />
    </Verbs>
    <ChildContent>
        @* The two colours a project's ring is drawn in while a verb goes through its
           containers (the stylesheet points the ring's stroke here): the success colour
           into the primary, the two its line has. It takes no room. *@
        <svg class="wslc-progress-mix-defs" aria-hidden="true" focusable="false">
            <defs>
                <linearGradient id="wslc-progress-mix" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0.3" style="stop-color: var(--mud-palette-success)" />
                    <stop offset="0.7" style="stop-color: var(--mud-palette-primary)" />
                </linearGradient>
            </defs>
        </svg>
        <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.NoWrap" Spacing="2" Class="wslc-toolbar mb-1 flex-shrink-0">
            <PageStats>
                <PageStat Label="CPU" Value="@CpuText" />
                <PageStat Label="Memory" Value="@Bytes.Humanize(_aggregate.MemoryUsedBytes)" />
            </PageStats>
            @* Both filters stay at every width: when the bar is tight the word gives
               way to its initial (R, T) and the tooltip, which they already carry,
               says the whole of it. Two switches nobody can read are worse than
               two letters with a tooltip, and losing a filter is worse than both. *@
            <span class="wslc-filter-switch" data-short="R" title="Show running containers only">
                <MudSwitch T="bool" Value="_runningOnly" ValueChanged="OnRunningOnlyChanged" Label="Running" LabelPlacement="Placement.Start" Color="Color.Warning" Size="Size.Small" title="Show running containers only" />
            </span>
            <span class="wslc-filter-switch" data-short="T" title="Also show the agent's temporary Files helper containers, normally hidden">
                <MudSwitch T="bool" Value="_helpers" ValueChanged="OnHelpersChanged" Label="Temporary" LabelPlacement="Placement.Start" Color="Color.Warning" Size="Size.Small" title="Also show the agent's temporary Files helper containers, normally hidden" />
            </span>
            <ViewModeToggle @bind-Value="View" />
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="RefreshAsync" Disabled="Loading" title="Refresh" />
        </MudStack>

        @if (Error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-2 flex-shrink-0">@Error</MudAlert>
        }

        @if (View == ViewMode.Table)
        {
            <ListGrid TItem="ListRow<ContainerSummary>" Items="Rows" Loading="Loading" Page="Page" PageChanged="p => Page = p" SortChanged="SortChanged" EmptyText="@EmptyText"
                      MultiSelection="true" @bind-SelectedItems="Selected">
                <Columns>
                    <SelectColumn T="ListRow<ContainerSummary>" Size="Size.Small" StickyLeft="true" HeaderClass="@GridColumn.Select" CellClass="@GridColumn.Select" />
                    @* The dot sorts the list by state: running first, then everything stopped. *@
                    <TemplateColumn T="ListRow<ContainerSummary>" Title="" Sortable="true" SortBy="@(r => r.Value.IsRunning ? 0 : 1)"
                                    Resizable="false" StickyLeft="true" HeaderClass="@GridColumn.Bullet" CellClass="@GridColumn.Bullet">
                        <CellTemplate>
                            <StateDot Active="context.Item.Value.IsRunning" Title="running" Key="@context.Item.Value.Id"
                                      Working="@(IsGroup(context.Item.Value) && IsWorking(context.Item.Value.Name))" />
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn T="ListRow<ContainerSummary>" TProperty="string" Property="c => c.Value.Name" Title="Name" StickyLeft="true" HeaderClass="@GridColumn.Width(18)" CellClass="@GridColumn.Width(18)">
                        <CellTemplate>
                            @* A project's row is its group's head: its +/− opens its containers'
                               rows under it, which carry a mark before their names. *@
                            @if (IsGroup(context.Item.Value))
                            {
                                @GroupName(context.Item.Value)
                            }
                            else if (LaunchOf(context.Item.Value) is { } launch)
                            {
                                <ProgressCell Lead="@Mark(context.Item.Value)" Name="@launch.Name" Pct="launch.Pct" Status="@launch.Status" Failed="@(!launch.Active && !launch.Done)" Done="launch.Done" LogAfterFailure="@launch.IsProject"
                                              LogTitle="@($"View {KindOf(launch)} progress")" CancelTitle="@($"Cancel {KindOf(launch)}")" DismissTitle="@($"Dismiss {KindOf(launch)}")"
                                              OnLog="@(() => ShowLaunchLogAsync(launch))" OnCancel="@(() => CancelLaunchAsync(launch))"
                                              OnDismiss="@(() => DismissLaunchAsync(launch))" />
                            }
                            else if (UpdateOf(context.Item.Value) is { } update)
                            {
                                @* Its image update pulling the new image: the pull's bar on
                                   the container that was asked to update, not only on the
                                   image. *@
                                <ProgressCell Lead="@Mark(context.Item.Value)" Name="@context.Item.Value.Name" Pct="update.Pct" Status="@UpdateStatus(update)" Failed="@(update.State is "error" or "cancelled")" Done="@(update.State == "success")"
                                              LogTitle="View the update's pull" CancelTitle="Cancel the update" DismissTitle="Dismiss"
                                              OnLog="@(() => PullFlow.ShowLogAsync(Dialogs, update.Image, finished: update.State != "running"))"
                                              OnCancel="@(() => CancelUpdateAsync(update.Image))" OnDismiss="RefreshAsync" />
                            }
                            else if (TransfersOf(context.Item.Value) is { Count: > 0 } moving)
                            {
                                @* Files on the move, in or out: the same bar as a run, on
                                   the container they are travelling to or from, and one
                                   bar for all of them however many there are. There is no
                                   console to open — a transfer is bytes, not output — so
                                   the row has its percentage and its cross and nothing
                                   else. *@
                                <ProgressCell Lead="@Mark(context.Item.Value)" Name="@context.Item.Value.Name" Pct="@TransferFlow.Pct(moving)" Status="@TransferFlow.Status(moving)"
                                              Failed="@TransferFlow.Failed(moving)" LogTitle="View the transfers" CancelTitle="@CancelTitle(moving)" DismissTitle="Dismiss"
                                              OnLog="@(() => TransferFlow.ShowAsync(Dialogs, context.Item.Value.Id, context.Item.Value.Name))"
                                              OnCancel="@(() => CancelTransfersAsync(moving))" OnDismiss="@(() => DismissTransfersAsync(moving))" />
                            }
                            else
                            {
                                @Named(context.Item.Value)
                            }
                        </CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn T="ListRow<ContainerSummary>" TProperty="string" Property="c => c.Value.Image" Title="Image" HeaderClass="@GridColumn.Width(24)" CellClass="@GridColumn.Width(24)" />
                    <TemplateColumn T="ListRow<ContainerSummary>" Title="Ports" Sortable="false" Resizable="true" DragAndDropEnabled="true"
                                    HeaderClass="@GridColumn.Number(14)" CellClass="@GridColumn.Number(14)">
                        <CellTemplate>
                            <PortsLink Ports="context.Item.Value.Ports" Container="@context.Item.Value.Id" Publications="context.Item.Value.Published" />
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn T="ListRow<ContainerSummary>" TProperty="string" Property="c => c.Value.CpuPercent" Title="CPU" HeaderClass="@GridColumn.Number(5)" CellClass="@GridColumn.Number(5)">
                        <CellTemplate>@Dash(context.Item.Value.CpuPercent)</CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn T="ListRow<ContainerSummary>" TProperty="string" Property="c => c.Value.MemPercent" Title="Mem%" HeaderClass="@GridColumn.Number(5)" CellClass="@GridColumn.Number(5)">
                        <CellTemplate>@Dash(context.Item.Value.MemPercent)</CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn T="ListRow<ContainerSummary>" TProperty="string" Property="c => c.Value.MemUsage" Title="Memory" HeaderClass="@GridColumn.Number(8)" CellClass="@GridColumn.Number(8)">
                        <CellTemplate>
                            <span title="@context.Item.Value.MemUsage">@Dash(MemoryUsed(context.Item.Value.MemUsage))</span>
                        </CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn T="ListRow<ContainerSummary>" TProperty="string" Property="c => c.Value.DiskIo" Title="Disk" HeaderClass="@GridColumn.Number(12)" CellClass="@GridColumn.Number(12)">
                        <CellTemplate>@Dash(context.Item.Value.DiskIo)</CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn T="ListRow<ContainerSummary>" TProperty="string" Property="c => c.Value.Id" Title="ID" HeaderClass="@GridColumn.Width(13)" CellClass="@($"{GridColumn.Width(13)} mud-text-secondary")">
                        <CellTemplate>@(IsGroup(context.Item.Value) ? "project" : LaunchOf(context.Item.Value) is null ? context.Item.Value.Id : "pending")</CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn T="ListRow<ContainerSummary>" TProperty="string" Property="c => c.Value.RestartPolicy" Title="Restart" HeaderClass="@GridColumn.Stretch(5)" CellClass="@GridColumn.Stretch(5)">
                        <CellTemplate>@Dash(context.Item.Value.RestartPolicy)</CellTemplate>
                    </PropertyColumn>
                </Columns>
                <Actions>
                    <TemplateColumn T="ListRow<ContainerSummary>" Title="Actions" Sortable="false" Resizable="false" DragAndDropEnabled="false" StickyRight="true" HeaderClass="@GridColumn.Actions" CellClass="@GridColumn.Actions">
                        <CellTemplate>
                            @if (IsGroup(context.Item.Value))
                            {
                                @GroupActions(context.Item.Value)
                            }
                            else if (LaunchOf(context.Item.Value) is { Phase: "error", IsProject: false } launch)
                            {
                                @EditLaunchButton(launch)
                            }
                            else
                            {
                                <ContainerActions Container="context.Item.Value" Launching="@(LaunchOf(context.Item.Value) is not null)" Changed="RefreshAsync" />
                            }
                        </CellTemplate>
                    </TemplateColumn>
                </Actions>
            </ListGrid>
        }
        else
        {
            @* A project's cards stand among the others, each in its own cell: its own card
               first, then its containers', and a line runs round them as one (Bracket). *@
            var cards = Visible;
            var closing = Closing(cards);
            var tones = cards.Where(IsGroup).ToDictionary(head => head.Name, head => ToneOf(head.Name), StringComparer.Ordinal);
            <CardsGrid TItem="ContainerSummary" Items="cards" Loading="Loading" EmptyText="@EmptyText">
                <ItemTemplate Context="c">
                    @if (Bracket(c, closing, tones) is { Length: > 0 } bracket)
                    {
                        <div class="@bracket">
                            @(IsGroup(c) ? GroupCard(c) : ContainerCard(c))
                        </div>
                    }
                    else
                    {
                        @ContainerCard(c)
                    }
                </ItemTemplate>
            </CardsGrid>
        }
    </ChildContent>
</PageShell>

@code {
    private ContainerAggregate _aggregate = new(0, 1, 0);
    private bool _runningOnly;
    private bool _helpers;

    private string EmptyText => _runningOnly ? "No running containers." : "No containers.";

    /// <summary>used% / total% (N CPUs).</summary>
    private string CpuText => $"{_aggregate.CpuUsedPercent:0.##}% / {_aggregate.CpuCount * 100}% ({_aggregate.CpuCount} CPUs)";

    /// <summary>
    /// The used side of <c>899.5MiB / 30.98GiB</c>: the total is the machine's,
    /// the same in every row, so the column shows what changes and the whole
    /// reading stays in the cell's tooltip.
    /// </summary>
    private static string MemoryUsed(string usage) => usage.Split('/')[0].Trim();

    private const string LaunchPrefix = "launch:";

    /// <summary>The row that stands for a project, the head of its group: no container of its own, its name the project's.</summary>
    private const string GroupPrefix = ProjectVerbs.RowPrefix;

    /// <summary>Where each row of a group stands in the list (see <see cref="Grouped"/>); a row not here stands by its own number.</summary>
    private readonly Dictionary<string, double> _ages = new(StringComparer.Ordinal);
    private static readonly TimeSpan JobsEvery = TimeSpan.FromSeconds(1);

    private IReadOnlyList<ContainerLaunch> _launches = [];
    private IReadOnlyList<ContainerTransfer> _transfers = [];

    /// <summary>The agent's pulls, read only while a container's image update is pulling.</summary>
    private IReadOnlyList<ImagePullState> _pulls = [];
    private readonly HashSet<string> _reportedLaunches = [];

    /// <summary>Runs still on their way first, as a temporary row each; then every project as a group, and the containers on their own.</summary>
    protected override async Task<IReadOnlyList<ContainerSummary>> LoadAsync()
    {
        var response = await Api.GetContainersAsync(all: !_runningOnly, helpers: _helpers);
        _aggregate = response.Aggregate;
        _launches = await Api.GetContainerLaunchesAsync();
        _transfers = await Api.GetContainerTransfersAsync();
        _pulls = response.Containers.Any(row => row.IsUpdating) ? await Api.GetImagePullsAsync() : [];
        ReportFinishedLaunches();
        var runs = _launches.Where(l => !l.IsProject && !l.Done)
            .Select(l => new ContainerSummary(LaunchPrefix + l.Id, l.Name, l.Image, l.Active ? "created" : "error", l.Status, "", "", "", [], "", "", "", "", Project: l.Group))
            .ToList();
        return Grouped(runs, response.Containers);
    }

    /// <summary>
    /// The list as it is held: the runs on their own first, then each project
    /// as its head row followed by its containers and the runs it has under
    /// way, then the containers on their own. A project stands where its
    /// oldest container does, so it keeps its place as the rows do; one with no
    /// container yet (its first save) stands after the runs. Every row of a
    /// group is given a place between two of the agent's numbers, in order,
    /// which is how the list keeps them together (<see cref="AgeOf"/>).
    /// </summary>
    private IReadOnlyList<ContainerSummary> Grouped(IReadOnlyList<ContainerSummary> runs, IReadOnlyList<ContainerSummary> containers)
    {
        _ages.Clear();
        var rows = new List<ContainerSummary>();
        void Place(IReadOnlyList<ContainerSummary> block, double from, double room)
        {
            for (var index = 0; index < block.Count; index++)
            {
                _ages[block[index].Id] = from + (room * index / block.Count);
            }

            rows.AddRange(block);
        }

        // Under 1, the first number the agent gives: before every container.
        Place(runs.Where(run => run.Project.Length == 0).ToList(), 0.1, 0.4);

        var projects = containers.Select(container => container.Project)
            .Concat(_launches.Where(launch => launch.Group.Length > 0 && !launch.Done).Select(launch => launch.Group))
            .Where(name => name.Length > 0)
            .Distinct(StringComparer.Ordinal)
            .ToList();
        for (var index = 0; index < projects.Count; index++)
        {
            var name = projects[index];
            var members = containers.Where(container => container.Project == name).OrderBy(container => container.Uid).ToList();
            List<ContainerSummary> ofProject = [GroupRow(name, members), .. members, .. runs.Where(run => run.Project == name)];
            var oldest = members.Where(member => member.Uid > 0).Select(member => member.Uid).DefaultIfEmpty(0).Min();

            // From a quarter before its oldest container to short of the next number: no other row has a place in there.
            if (oldest > 0)
            {
                Place(ofProject, oldest - 0.25, 0.9);
            }
            else
            {
                Place(ofProject, 0.6 + (0.3 * index / projects.Count), 0.25 / projects.Count);
            }
        }

        rows.AddRange(containers.Where(container => container.Project.Length == 0));
        return rows;
    }

    /// <summary>A project's head row: how many of its containers run, and their CPU and memory share added up.</summary>
    private ContainerSummary GroupRow(string name, IReadOnlyList<ContainerSummary> members)
    {
        var running = members.Count(member => member.IsRunning);
        var measured = members.Where(member => member.CpuPercent.Length > 0).ToList();
        return new ContainerSummary(GroupPrefix + name, name,
            _runningOnly ? $"{running} running" : $"{running} of {members.Count} running",
            running > 0 ? "running" : "exited", "", "", "", "", [], "", "", "", "",
            CpuPercent: measured.Count > 0 ? Sum(measured, member => member.CpuPercent) : "",
            MemPercent: measured.Count > 0 ? Sum(measured, member => member.MemPercent) : "",
            Project: name);
    }

    /// <summary>Percentages as <c>wslc stats</c> prints them, added up and written the same way.</summary>
    private static string Sum(IEnumerable<ContainerSummary> rows, Func<ContainerSummary, string> reading) =>
        rows.Sum(row => Percents.Parse(reading(row))).ToString("0.00", CultureInfo.InvariantCulture) + "%";

    private static bool IsGroup(ContainerSummary row) => row.Id.StartsWith(GroupPrefix, StringComparison.Ordinal);

    /// <summary>A project's containers and the runs it has under way, as the list holds them.</summary>
    private List<ContainerSummary> MembersOf(string project) => Items.Where(row => row.Project == project && !IsGroup(row)).ToList();

    private IReadOnlyList<string> NamesOf(string project) => MembersOf(project).Select(member => member.Name).ToList();

    /// <summary>The project's save, while the agent lists it: under way, just ended, or failed and not dismissed.</summary>
    private ContainerLaunch? SavingOf(string project) => _launches.FirstOrDefault(launch => launch.IsProject && launch.Group == project);

    /// <summary>
    /// A group shows its containers when the user opened it, and without
    /// being asked while a search is on (what it found is inside), while the
    /// project is being saved or its save failed, and while a verb goes
    /// through its containers: what is being done to each container is the
    /// thing to see then.
    /// </summary>
    private bool IsOpen(string project) =>
        Search.Length > 0 || Groups.IsOpen(project) || SavingOf(project) is { Done: false } || Verbs.Of(project) is not null;

    /// <summary>
    /// A container of a project is shown after its project's row, or card,
    /// while that group is open. Sorted by a column, the list is every
    /// container in that order and no group: a head row has no value of its
    /// own to be sorted by.
    /// </summary>
    protected override bool IsShown(ContainerSummary row)
    {
        if (Sorted)
        {
            return !IsGroup(row);
        }

        return IsGroup(row) || row.Project.Length == 0 || IsOpen(row.Project);
    }

    protected override string Folding =>
        $"{Sorted}|{string.Join(',', Items.Where(IsGroup).Where(head => IsOpen(head.Name)).Select(head => head.Name))}";

    /// <summary>The last card each project has among the ones shown: where the line round its cards closes.</summary>
    private static Dictionary<string, string> Closing(IReadOnlyList<ContainerSummary> cards) =>
        cards.Where(card => card.Project.Length > 0)
            .GroupBy(card => card.Project, StringComparer.Ordinal)
            .ToDictionary(project => project.Key, project => project.Last().Id, StringComparer.Ordinal);

    /// <summary>
    /// Something is being done to the project: its save, a verb going through
    /// its containers, its own down, or anything at all on one of its
    /// containers (a start, a stop, a restart, a removal, a run on its way, a
    /// recreate, an image update). What is done to a container of a project
    /// is done to the project, which shows it as its own work.
    /// </summary>
    private bool IsWorking(string project) =>
        Verbs.Of(project) is not null
        || SavingOf(project) is { Active: true }
        || Working.IsBusy(GroupPrefix + project)
        || MembersOf(project).Any(member => Working.IsBusy(member.Id) || member.IsRecreating || member.IsUpdating || LaunchOf(member) is { Active: true });

    /// <summary>
    /// How a project is, as the class its cards' line is coloured by: every
    /// container running, none, or some. A run still on its way is no
    /// container yet, and is not counted. While something is being done to
    /// it (<see cref="IsWorking"/>) it is on its way from one to the other,
    /// and is drawn as some.
    /// </summary>
    private string ToneOf(string project)
    {
        if (IsWorking(project))
        {
            return "wslc-bracket-partial";
        }

        var containers = MembersOf(project).Where(member => LaunchOf(member) is null).ToList();
        var running = containers.Count(container => container.IsRunning);
        return running == 0 ? "wslc-bracket-stopped" : running == containers.Count ? "wslc-bracket-running" : "wslc-bracket-partial";
    }

    /// <summary>
    /// The classes of the cell of a card that is a project's (the stylesheet
    /// draws the line): over and under every one, down the left of the
    /// project's own card, which is the first, and down the right of the last,
    /// in the colour of how the project is. A card that is between two
    /// states is marked as waiting, which sets its header going from the
    /// stopped tone to the running one and back: the project's own while
    /// anything is being done to it, and a container's while a verb going
    /// through the project has not got to it yet. The one whose turn it is
    /// turns its ring instead, and then keeps the tone its turn left it in.
    /// Empty for a container on its own, and in a sorted list, which has no
    /// groups.
    /// </summary>
    private string Bracket(ContainerSummary card, Dictionary<string, string> closing, Dictionary<string, string> tones) =>
        Sorted || card.Project.Length == 0
            ? ""
            : $"wslc-card-bracket {tones.GetValueOrDefault(card.Project, "wslc-bracket-stopped")}"
              + $"{(IsGroup(card) ? " wslc-bracket-start" : "")}{(closing.GetValueOrDefault(card.Project) == card.Id ? " wslc-bracket-end" : "")}"
              + $"{((IsGroup(card) && IsWorking(card.Project)) || Verbs.IsWaiting(card.Id) ? " wslc-bracket-waiting" : "")}";

    /// <summary>What stands before a row's name: a project's +/−, the mark of a container under its project; nothing for a container on its own, or in a sorted list, which has no groups.</summary>
    private RenderFragment? Mark(ContainerSummary row)
    {
        if (Sorted || row.Project.Length == 0)
        {
            return null;
        }

        if (!IsGroup(row))
        {
            return @<MudIcon Icon="@Icons.Material.Filled.SubdirectoryArrowRight" Size="Size.Small" Class="mud-text-secondary flex-shrink-0" />;
        }

        var open = IsOpen(row.Name);
        return @<MudIconButton Icon="@(open ? Icons.Material.Filled.Remove : Icons.Material.Filled.Add)" Size="Size.Small"
                               title="@(open ? "Hide the project's containers" : "Show the project's containers")" OnClick="@(() => Groups.Toggle(row.Name))" />;
    }

    /// <summary>A row's name, after its mark when it has one.</summary>
    private RenderFragment Named(ContainerSummary row)
    {
        if (Mark(row) is not { } mark)
        {
            return @<text>@row.Name</text>;
        }

        return @<div class="wslc-progress-cell">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.NoWrap">
                @mark
                <span class="wslc-progress-name">@row.Name</span>
            </MudStack>
        </div>;
    }

    /// <summary>A project's name in its row: while the agent lists its save, the row is that save's, with its progress, its log and its cancel.</summary>
    private RenderFragment GroupName(ContainerSummary head)
    {
        if (SavingOf(head.Name) is not { } saving)
        {
            return GoingName(head);
        }

        return @<ProgressCell Lead="@Mark(head)" Name="@head.Name" Pct="saving.Pct" Status="@saving.Status" Failed="@(!saving.Active && !saving.Done)" Done="saving.Done"
                              LogTitle="View project progress" CancelTitle="Cancel project" DismissTitle="Dismiss project"
                              OnLog="@(() => ShowLaunchLogAsync(saving))" OnCancel="@(() => CancelLaunchAsync(saving))" OnDismiss="@(() => DismissLaunchAsync(saving))" />;
    }

    /// <summary>A project's name while a verb goes through its containers: how far it has got, and the cross that stops it there.</summary>
    private RenderFragment GoingName(ContainerSummary head)
    {
        if (Verbs.Of(head.Name) is not { } going)
        {
            return Named(head);
        }

        return @<ProgressCell Lead="@Mark(head)" Name="@head.Name" Pct="going.Pct" Status="@going.Step" Mixed="true"
                              CancelTitle="Stop after this container" OnCancel="@(() => Verbs.Cancel(head.Name))" />;
    }

    private RenderFragment GroupActions(ContainerSummary head) =>
        @<ProjectActions Project="@head.Name" RowKey="@head.Id" Containers="@NamesOf(head.Name)" Running="head.IsRunning"
                         Saving="@(SavingOf(head.Name) is { Active: true })" Changed="RefreshAsync" />;

    /// <summary>
    /// A project's own card, a card as any other: its name, how many of its
    /// containers run, the +/− that shows their cards after it, the project's
    /// verbs, and its containers named in its body. While something is being
    /// done to it its avatar is a ring in its two colours: its save's, a
    /// verb's going through its containers with how far it has got, or one
    /// that only turns for a verb on one container.
    /// </summary>
    private RenderFragment GroupCard(ContainerSummary head) =>
        @<EntityCard Title="@head.Name" Subtitle="@head.Image" AvatarColor="@StateColors.For(head.State)" Tone="@CardTone.Of(head)">
                <HeaderActions>
                    <StateChip State="@head.State" />
                    @Mark(head)
                </HeaderActions>
                <Avatar>
                    @if (SavingOf(head.Name) is { } saving)
                    {
                        <ProgressRing Pct="saving.Pct" Status="@saving.Status" Failed="@(!saving.Active && !saving.Done)" Done="saving.Done"
                                      LogTitle="View project progress" CancelTitle="Cancel project" DismissTitle="Dismiss project"
                                      OnLog="@(() => ShowLaunchLogAsync(saving))" OnCancel="@(() => CancelLaunchAsync(saving))" OnDismiss="@(() => DismissLaunchAsync(saving))" />
                    }
                    else if (Verbs.Of(head.Name) is { } going)
                    {
                        <ProgressRing Pct="going.Pct" Status="@going.Step" Mixed="true" CancelTitle="Stop after this container" OnCancel="@(() => Verbs.Cancel(head.Name))" />
                    }
                    else if (IsWorking(head.Name))
                    {
                        @* Anything being done to one of its containers, or its own down: the ring turns
                           where the avatar is, as any card's does, in the project's two colours. The
                           card is given no key, so the header's own ring leaves this one its place. *@
                        <div class="wslc-progress-ring wslc-progress-mixed" title="Working…">
                            <MudProgressCircular Class="wslc-progress-ring-dial" Color="Color.Info" Indeterminate="true" />
                        </div>
                    }
                    else
                    {
                        <MudAvatar Color="@StateColors.For(head.State)" Variant="Variant.Filled">@(head.Name[..1].ToUpperInvariant())</MudAvatar>
                    }
                </Avatar>
                <ChildContent>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@(string.Join(", ", NamesOf(head.Name)))</MudText>
                </ChildContent>
                <Actions>
                    @GroupActions(head)
                </Actions>
            </EntityCard>;

    /// <summary>A container's card, the same on its own and after its project's card.</summary>
    private RenderFragment ContainerCard(ContainerSummary c) =>
        @<EntityCard Title="@c.Name" Subtitle="@c.Image" AvatarColor="@StateColors.For(c.State)" Key="@c.Id" Tone="@CardTone.Of(c)">
                        <HeaderActions>
                            <StateChip State="@c.State" />
                        </HeaderActions>
                        <Avatar>
                            @if (LaunchOf(c) is { } launch)
                            {
                                <ProgressRing Pct="launch.Pct" Status="@launch.Status" Failed="@(!launch.Active && !launch.Done)" Done="launch.Done" LogAfterFailure="@launch.IsProject"
                                              LogTitle="@($"View {KindOf(launch)} progress")" CancelTitle="@($"Cancel {KindOf(launch)}")" DismissTitle="@($"Dismiss {KindOf(launch)}")"
                                              OnLog="@(() => ShowLaunchLogAsync(launch))" OnCancel="@(() => CancelLaunchAsync(launch))"
                                              OnDismiss="@(() => DismissLaunchAsync(launch))" />
                            }
                            else if (UpdateOf(c) is { } update)
                            {
                                <ProgressRing Pct="update.Pct" Status="@UpdateStatus(update)" Failed="@(update.State is "error" or "cancelled")" Done="@(update.State == "success")"
                                              LogTitle="View the update's pull" CancelTitle="Cancel the update" DismissTitle="Dismiss"
                                              OnLog="@(() => PullFlow.ShowLogAsync(Dialogs, update.Image, finished: update.State != "running"))"
                                              OnCancel="@(() => CancelUpdateAsync(update.Image))" OnDismiss="RefreshAsync" />
                            }
                            else if (TransfersOf(c) is { Count: > 0 } moving)
                            {
                                <ProgressRing Pct="@TransferFlow.Pct(moving)" Status="@TransferFlow.Status(moving)" Failed="@TransferFlow.Failed(moving)"
                                              LogTitle="View the transfers" CancelTitle="@CancelTitle(moving)" DismissTitle="Dismiss"
                                              OnLog="@(() => TransferFlow.ShowAsync(Dialogs, c.Id, c.Name))"
                                              OnCancel="@(() => CancelTransfersAsync(moving))" OnDismiss="@(() => DismissTransfersAsync(moving))" />
                            }
                            else
                            {
                                <MudAvatar Color="@StateColors.For(c.State)" Variant="Variant.Filled">@(c.Name is { Length: > 0 } name ? name[..1].ToUpperInvariant() : "?")</MudAvatar>
                            }
                        </Avatar>
                        <ChildContent>
                            <ContainerCardBody Container="c" />
                        </ChildContent>
                        <Actions>
                            @if (LaunchOf(c) is { Phase: "error", IsProject: false } launch)
                            {
                                @EditLaunchButton(launch)
                            }
                            else
                            {
                                <ContainerActions Container="c" Launching="@(LaunchOf(c) is not null)" Changed="RefreshAsync" Shortcuts="true" />
                            }
                        </Actions>
                    </EntityCard>;

    /// <summary>Which groups this device left open, read with the view before the list is first drawn.</summary>
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await Groups.ReadyAsync();
    }

    protected override void OnInitialized()
    {
        // The section is the list again, however the user arrived: the sidebar's
        // Containers entry stops pointing at a details page: its memory is
        // cleared whenever the list itself is showing.
        Open.ClearContainers();
        base.OnInitialized();
        _ = FollowJobsAsync(PageClosing);
        // The queue is this client's, not the agent's, so no poll hears about
        // it: a file chosen or let go changes a row this second, not next one.
        // So is a verb going through a project's containers.
        Transfers.QueueChanged += OnQueueChanged;
        Verbs.Changed += OnQueueChanged;
        Verbs.ReadList = ReadForVerbsAsync;
        Working.Changed += OnQueueChanged;
        PageClosing.Register(() =>
        {
            Transfers.QueueChanged -= OnQueueChanged;
            Verbs.Changed -= OnQueueChanged;
            Verbs.ReadList = null;
            Working.Changed -= OnQueueChanged;
        });
    }

    private void OnQueueChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>
    /// A project's verb has gone through one container and waits for the
    /// list to be read: that container then shows as it is (running and
    /// green, or stopped and no longer so) before the verb goes on to the
    /// next, and the project is not through before its last one shows it.
    /// </summary>
    private Task ReadForVerbsAsync() => InvokeAsync(async () =>
    {
        await RefreshAsync();
        StateHasChanged();
    });

    /// <summary>The pull this container's image update waits for, while it does; one not listed yet is about to start.</summary>
    private ImagePullState? UpdateOf(ContainerSummary row) =>
        row.UpdatingTo is { } image
            ? _pulls.FirstOrDefault(pull => pull.Image == image) ?? new ImagePullState(image, "running", 0, "Starting the pull…", "")
            : null;

    /// <summary>What the update's bar says: the image it moves to, and the pull's step or why it failed.</summary>
    private static string UpdateStatus(ImagePullState pull) =>
        $"Updating to {pull.Image}: {(pull.State == "running" ? pull.Status : pull.Error.Length > 0 ? pull.Error : pull.State)}";

    private async Task CancelUpdateAsync(string image)
    {
        if (await PullFlow.CancelAsync(Dialogs, Api, Snackbar, image))
        {
            await RefreshAsync();
        }
    }

    private ContainerLaunch? LaunchOf(ContainerSummary row) =>
        row.Id.StartsWith(LaunchPrefix, StringComparison.Ordinal) ? _launches.FirstOrDefault(l => LaunchPrefix + l.Id == row.Id) : null;

    /// <summary>What a row on its way is, in its buttons' words: a project being saved from its Compose file, or a container's run.</summary>
    private static string KindOf(ContainerLaunch launch) => launch.IsProject ? "project" : "run";

    /// <summary>The console a row on its way opens: a project's own log, kept once it failed since it says why, or the pull its run waits on.</summary>
    private Task ShowLaunchLogAsync(ContainerLaunch launch) =>
        launch.IsProject ? ProjectFlow.ShowLogAsync(Dialogs, launch) : PullFlow.ShowLogAsync(Dialogs, launch.Image);

    /// <summary>
    /// What this container's row has to show: files on the move, either way
    /// and whoever started them, the ones waiting their turn in the agent's
    /// queue, and the ones that ended badly. The waiting ones are the row's
    /// too — only one travels at a time, so without them a row where sixteen
    /// files were announced says it has one and the rest look lost — and a
    /// container whose files are all still queued behind another's shows the
    /// ring just the same.
    /// </summary>
    private IReadOnlyList<ContainerTransfer> TransfersOf(ContainerSummary row) =>
        TransferFlow.Showing(TransferFlow.For(_transfers, row.Id, row.Name));

    private static string CancelTitle(IReadOnlyList<ContainerTransfer> transfers) =>
        TransferFlow.Active(transfers) is { Count: > 1 } several ? $"Cancel {several.Count} transfers" : "Cancel transfer";

    /// <summary>A run, an upload or an image update's pull under way is followed every second; when one ends the list refreshes so the real row replaces it.</summary>
    private async Task FollowJobsAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(JobsEvery);
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                var updating = Items.Any(row => row.IsUpdating);
                // One that ended well is followed until the agent lets go of it: its row says so until then.
                if (!_launches.Any(l => l.Active || l.Done) && !_transfers.Any(t => t.Active) && !updating)
                {
                    continue;
                }

                var launches = _launches;
                var transfers = _transfers;
                var pulls = _pulls;
                try
                {
                    _launches = await Api.GetContainerLaunchesAsync(cancellationToken);
                    _transfers = await Api.GetContainerTransfersAsync(cancellationToken);
                    if (updating)
                    {
                        _pulls = await Api.GetImagePullsAsync(cancellationToken);
                    }
                }
                catch (Exception ex) when (ex is AgentApiException or HttpRequestException)
                {
                    // The agent did not answer this tick (the layout says so); the next asks again.
                    continue;
                }

                // An update's pull that ended: the row goes on to its recreate, which the list shows.
                // A run that appeared (a project's save starts one a container) has no row until the list is read.
                if (Ended(launches, _launches, l => l.Id, l => l.Active) || Ended(transfers, _transfers, t => t.Id, t => t.Active)
                    || Ended(pulls, _pulls, p => p.Image, p => p.State == "running")
                    || Ended(launches, _launches, l => l.Id, l => l.Done)
                    || _launches.Any(now => launches.All(before => before.Id != now.Id)))
                {
                    await InvokeAsync(RefreshAsync);
                }
                else
                {
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException)
        {
            // The page closed.
        }
    }

    /// <summary>Whether something that was on its way is not any more, whichever kind of job it is: the list has a real row to show in its place.</summary>
    private static bool Ended<T>(IReadOnlyList<T> before, IReadOnlyList<T> now, Func<T, string> id, Func<T, bool> active) =>
        before.Where(active).Any(job => !now.Any(fresh => id(fresh) == id(job) && active(fresh)));

    /// <summary>What a finished run had to adjust (the notes the form showed when it waited), and a failure, once each, on the activity line. A project's end is said by whoever asked for it (<see cref="ProjectActivity"/>).</summary>
    private void ReportFinishedLaunches()
    {
        foreach (var launch in _launches.Where(l => !l.Active && !l.IsProject && _reportedLaunches.Add(l.Id)))
        {
            if (launch.Phase == "error")
            {
                Activity.Fail(string.Join("\n", launch.Notes.Prepend($"{launch.Name}: run failed. {launch.Error}")));
            }
            else if (launch.Notes.Count > 0)
            {
                Activity.Say($"{launch.Name}: {string.Join(" ", launch.Notes)}");
            }
        }
    }

    private async Task CancelLaunchAsync(ContainerLaunch launch)
    {
        if (launch.IsProject)
        {
            await ProjectFlow.CancelAsync(Dialogs, Api, Snackbar, launch.Id);
            await RefreshAsync();
            return;
        }

        if (!await DialogFlow.ConfirmAsync(Dialogs, "Cancel run", "Cancel this run?", "Cancel run", destructive: true))
        {
            return;
        }

        try
        {
            await Api.CancelContainerLaunchAsync(launch.Id);
        }
        catch (Exception ex) when (ex is AgentApiException or HttpRequestException)
        {
            // The refresh shows the agent's state either way.
        }

        await RefreshAsync();
    }

    /// <summary>
    /// The cross of files on the move: the requests are abandoned where they
    /// are and the bytes already travelled are thrown away. It asks once,
    /// however many there are — what was sent is sent again from the start or
    /// not at all.
    /// </summary>
    /// <summary>The ring's cross: everything this container is carrying, asked batch by batch — eight files sent as one act are undone as one.</summary>
    private async Task CancelTransfersAsync(IReadOnlyList<ContainerTransfer> transfers)
    {
        await TransferFlow.StopAsync(Dialogs, Api, Snackbar, Transfers, transfers);
        await RefreshAsync();
    }

    /// <summary>The cross of transfers that failed or were cancelled: the agent forgets them and the ring goes, for every client.</summary>
    private async Task DismissTransfersAsync(IReadOnlyList<ContainerTransfer> transfers)
    {
        await TransferFlow.DismissAsync(Api, Snackbar, Transfers, transfers);
        await RefreshAsync();
    }

    /// <summary>A failed run keeps its settings on the agent: its row's one action opens them in the Run form, to fix and run again.</summary>
    private RenderFragment EditLaunchButton(ContainerLaunch launch) =>
        @<MudIconButton Icon="@Icons.Material.Filled.EditNote" Size="Size.Small" title="Edit &amp; run again" OnClick="@(() => EditLaunchAsync(launch))" />;

    /// <summary>The Run form on what the failed run was started with; a run started from it replaces the failed row.</summary>
    private async Task EditLaunchAsync(ContainerLaunch launch)
    {
        ContainerLaunchRequest request;
        try
        {
            request = await Api.GetContainerLaunchRequestAsync(launch.Id);
        }
        catch (Exception ex) when (ex is AgentApiException or HttpRequestException)
        {
            Activity.Fail($"{launch.Name}: {ex.Message}");
            return;
        }

        var parameters = new DialogParameters<ContainerFormDialog>
        {
            { d => d.Mode, LaunchMode.Run },
            { d => d.Form, LaunchForm.From(request) },
        };
        if (await DialogFlow.ShowAsync<ContainerFormDialog>(Dialogs, $"Edit & run again — {launch.Name}", parameters, large: true))
        {
            await DismissLaunchAsync(launch);
        }
    }

    /// <summary>The cross of a failed run: the agent forgets it and the row goes, for every client. Nothing to confirm, nothing is lost.</summary>
    private async Task DismissLaunchAsync(ContainerLaunch launch)
    {
        try
        {
            await Api.DismissContainerLaunchAsync(launch.Id);
        }
        catch (Exception ex) when (ex is AgentApiException or HttpRequestException)
        {
            Activity.Fail(ex.Message);
        }

        await RefreshAsync();
    }

    /// <summary>A project's row matches by its name, or by any of its containers: what was found is shown under it.</summary>
    protected override bool Matches(ContainerSummary c, string search) =>
        Has(c.Name, search) || Has(c.Image, search) || Has(c.Id, search) || (IsGroup(c) && MembersOf(c.Name).Any(member => Matches(member, search)));

    protected override string KeyOf(ContainerSummary c) => c.Id;

    /// <summary>A change to a container recreates it under a new id; its number in the agent's registry is what stays, and so does its place.</summary>
    protected override string PlaceOf(ContainerSummary c) => c.Uid > 0 ? $"uid:{c.Uid}" : c.Id;

    protected override double AgeOf(ContainerSummary c, IReadOnlyList<ContainerSummary> rows) => _ages.GetValueOrDefault(c.Id, c.Uid);

    /// <summary>A container being recreated is left out of Start, Stop and Remove on the selection, as its own verbs are greyed; a project's row is no container, and has its own verbs.</summary>
    protected override bool CanAct(ContainerSummary c) => !c.IsRecreating && !IsGroup(c);

    protected override string NameOf(ContainerSummary c) => c.Name;

    private async Task OnRunningOnlyChanged(bool value)
    {
        _runningOnly = value;
        await RefreshAsync();
    }

    private async Task OnHelpersChanged(bool value)
    {
        _helpers = value;
        await RefreshAsync();
    }

    /// <summary>Run and Create are the same form; Create starts only when its Start toggle is on.</summary>
}
