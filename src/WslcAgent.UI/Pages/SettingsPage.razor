                <MudButton Size="Size.Small" Variant="Variant.Filled" OnClick="ExportStyleAsync" Class="mt-2 mr-2"
                           title="The whole look as a file, to carry to another machine or into wslc-style.json">Export</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="CopyStyleAsync" Class="mt-2 mr-2"
                           title="The whole look as JSON, for src/WslcAgent.UI/wwwroot/wslc-style.json — what the application ships with">Copy as JSON</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Filled" OnClick="ResetAsync" Class="mt-2"
                           title="Back to the look the application ships with — applied, not saved, so it can be tried first">Back to defaults</MudButton>
            </div>
        </MudTabPanel>
    </MudTabs>
</PageShell>

@code {
    /// <summary>The tabs, in their order; the query names one.</summary>
    private static readonly string[] Tabs = ["security", "publish", "mcp", "update", "notifications", "user", "layout"];

    private int _tab;

    /// <summary><c>?tab=security|publish|mcp|update|notifications|user|layout</c>: the tab is part of the address, so Back returns to the one left.</summary>
    [SupplyParameterFromQuery] public string? Tab { get; set; }

    protected override void OnParametersSet() => _tab = Math.Max(0, Array.IndexOf(Tabs, Tab ?? Tabs[0]));

    private void OnTabChanged(int index)
    {
        // MudTabs reports the index it settles on after every render; only a
        // real change deserves a navigation, or the page would reload in a loop.
        if (index == _tab || index < 0 || index >= Tabs.Length)
        {
            return;
        }

        _tab = index;
        // A pushed entry, not a replaced one: Back walks the tabs the user opened.
        Navigation.NavigateTo($"settings?tab={Tabs[index]}");
    }

    /// <summary>The Layout tab's field sample; it is a real search box, so it is what a bar holds.</summary>
    private string _sample = "";

    /// <summary>The Layout tab's select and view-toggle samples: real controls, as the bars hold them.</summary>
    private string _samplePick = "no";

    private ViewMode _sampleView = ViewMode.Table;

    /// <summary>Three rows of something, so a list sample reads like a list.</summary>
    private static readonly (string Name, string Image)[] SampleRows =
    [
        ("web", "nginx:1.27"),
        ("db", "postgres:16"),
        ("batch", "alpine:3.20"),
    ];

    /// <summary>The draft as CSS variables, for the samples: a row at the height it would have, before the application is put at it.</summary>
    private string DraftVars =>
        $"--wslc-btn-h: {Style.Draft.ButtonHeight}px; "
        + $"--wslc-btn-radius: {Style.Draft.ButtonRadius}px; "
        + $"--wslc-field-h: {Style.Draft.FieldHeight}px; "
        + $"--wslc-form-pad-top: {Style.Draft.FormPadTop}px; "
        + $"--wslc-form-pad-bottom: {Style.Draft.FormPadBottom}px; "
        + $"--wslc-btn-font: {Style.Draft.ButtonFontSize}px; "
        + $"--wslc-btn-pad: {Style.Draft.ButtonPadding}px; "
        + $"--wslc-row-pad-start: {Style.Draft.RowPadStart}px; "
        + $"--wslc-row-pad-end: {Style.Draft.RowPadEnd}px; "
        + $"--wslc-action-icon: {Style.Draft.ActionIconSize}px; "
        + $"--wslc-action-pad: {Style.Draft.ActionPadding}px; "
        + $"--wslc-form-radius: {Style.Draft.FormFieldRadius}px; "
        + $"--wslc-check: {Style.Draft.CheckSize}px; "
        + $"--wslc-bar-icon: {Style.Draft.BarIconSize}px; "
        + $"--wslc-bar-gap: {Style.Draft.BarGap}px; "
        + $"--wslc-tab-h: {Style.Draft.TabHeight}px; "
        + $"--wslc-head-shadow: {(Style.Draft.GridHeadElevation > 0 ? $"var(--mud-elevation-{Style.Draft.GridHeadElevation})" : "none")}; "
        + DraftColorVar("--wslc-grid-head", Style.Draft.GridHeadColor, "var(--wslc-header-tone)")
        + DraftColorVar("--wslc-grid-head-text", Style.Draft.GridHeadTextColor, "var(--mud-palette-text-primary)")
        + DraftColorVar("--wslc-tabs-bar", Style.Draft.TabsBarColor, "var(--wslc-header-tone)")
        + DraftColorVar("--wslc-tabs-text", Style.Draft.TabsTextColor, "var(--mud-palette-text-secondary)")
        + DraftTypeVars;

    /// <summary>
    /// A colour for the samples. Default is written out as the stylesheet's own
    /// value: the sample has to show it even while the screens carry another.
    /// </summary>
    private static string DraftColorVar(string name, Color color, string stylesheetOwn) =>
        $"{name}: {UiStyle.PaletteColor(color) ?? stylesheetOwn}; ";

    /// <summary>
    /// The four roles as CSS, for the samples: each role's own MudBlazor
    /// variables pointed at the standard chosen for it. A role left at its own
    /// typo writes nothing — a variable defined as itself is a cycle.
    /// </summary>
    private string DraftTypeVars => string.Concat(
        new (string Role, Typo Takes)[]
        {
            ("h6", Style.Draft.TitleTypo),
            ("body1", Style.Draft.DefaultTypo),
            ("body2", Style.Draft.TableTypo),
            ("caption", Style.Draft.SecondaryTypo),
            ("subtitle2", Style.Draft.SecondaryTypo),
            ("overline", Style.Draft.OverlineTypo),
        }
        .Where(role => role.Takes.ToString() != role.Role)
        .SelectMany(role => new[] { "size", "weight", "lineheight", "letterspacing" }
            .Select(metric => $"--mud-typography-{role.Role}-{metric}: var(--mud-typography-{role.Takes}-{metric}); ")));

    /// <summary>Where the look stands, in one line, so nobody has to guess what Apply did.</summary>
    private string StyleState => Style switch
    {
        { HasPending: true } => "Changed here, not on the screens yet. Apply shows it everywhere without writing it down; Save keeps it on this device.",
        { HasUnsaved: true } => "Applied to every screen. Walk through the application and come back — nothing is lost. Save keeps it on this device.",
        _ => "What you see is what this device opens with.",
    };

    /// <summary>
    /// Each control's own defaults, taken from what the application ships with
    /// (wslc-style.json): one place says it, and these only copy the few values
    /// each row edits.
    /// </summary>
    private UiStyleValues Ships => Style.Shipped;

    private void ResetText()
    {
        Style.Draft.TitleTypo = Ships.TitleTypo;
        Style.Draft.DefaultTypo = Ships.DefaultTypo;
        Style.Draft.TableTypo = Ships.TableTypo;
        Style.Draft.SecondaryTypo = Ships.SecondaryTypo;
        Style.Draft.OverlineTypo = Ships.OverlineTypo;
    }

    private void ResetRows()
    {
        Style.Draft.GridDense = Ships.GridDense;
        Style.Draft.GridStriped = Ships.GridStriped;
        Style.Draft.GridBordered = Ships.GridBordered;
        Style.Draft.GridHover = Ships.GridHover;
        Style.Draft.GridOutlined = Ships.GridOutlined;
        Style.Draft.GridFixedHeader = Ships.GridFixedHeader;
        Style.Draft.GridElevation = Ships.GridElevation;
        Style.Draft.RowPadStart = Ships.RowPadStart;
        Style.Draft.RowPadEnd = Ships.RowPadEnd;
        Style.Draft.ActionIconSize = Ships.ActionIconSize;
        Style.Draft.ActionPadding = Ships.ActionPadding;
    }

    private void ResetHeader()
    {
        Style.Draft.GridHeadColor = Ships.GridHeadColor;
        Style.Draft.GridHeadTextColor = Ships.GridHeadTextColor;
        Style.Draft.GridHeadElevation = Ships.GridHeadElevation;
    }

    private void ResetButtons()
    {
        Style.Draft.ButtonHeight = Ships.ButtonHeight;
        Style.Draft.ButtonRadius = Ships.ButtonRadius;
        Style.Draft.ButtonFontSize = Ships.ButtonFontSize;
        Style.Draft.ButtonPadding = Ships.ButtonPadding;
    }

    private void ResetBarFields() => Style.Draft.FieldHeight = Ships.FieldHeight;

    private void ResetFormFields()
    {
        Style.Draft.FormPadTop = Ships.FormPadTop;
        Style.Draft.FormPadBottom = Ships.FormPadBottom;
        Style.Draft.FormFieldRadius = Ships.FormFieldRadius;
    }

    private void ResetChecks() => Style.Draft.CheckSize = Ships.CheckSize;

    private void ResetBars()
    {
        Style.Draft.BarGap = Ships.BarGap;
        Style.Draft.BarIconSize = Ships.BarIconSize;
    }

    private void ResetTabs()
    {
        Style.Draft.TabHeight = Ships.TabHeight;
        Style.Draft.TabsBarColor = Ships.TabsBarColor;
        Style.Draft.TabsTextColor = Ships.TabsTextColor;
        Style.Draft.TabsRounded = Ships.TabsRounded;
        Style.Draft.TabsBorder = Ships.TabsBorder;
        Style.Draft.TabsCentered = Ships.TabsCentered;
        Style.Draft.TabsElevation = Ships.TabsElevation;
        Style.Draft.TabsMinWidth = Ships.TabsMinWidth;
    }

    private void ResetToggle()
    {
        Style.Draft.ToggleSize = Ships.ToggleSize;
        Style.Draft.ToggleColor = Ships.ToggleColor;
        Style.Draft.ToggleOutlined = Ships.ToggleOutlined;
        Style.Draft.ToggleDelimiters = Ships.ToggleDelimiters;
        Style.Draft.ToggleRounded = Ships.ToggleRounded;
        Style.Draft.ToggleCheckMark = Ships.ToggleCheckMark;
    }

    private void ResetCards()
    {
        Style.Draft.CardElevation = Ships.CardElevation;
        Style.Draft.CardOutlined = Ships.CardOutlined;
        Style.Draft.CardSquare = Ships.CardSquare;
    }

    /// <summary>
    /// The draft as the file wants it. Pasted into wslc-style.json it stops
    /// being this device's look and becomes the application's.
    /// </summary>
    /// <summary>The look as a file: the browser downloads it, a native client writes it through its own picker.</summary>
    private async Task ExportStyleAsync()
    {
        var json = StyleJson();
        try
        {
            if (Files.Supported)
            {
                if (await Files.SaveTextAsync("wslc-style.json", "application/json", json) is { } where)
                {
                    Snackbar.Add($"Look written to {where}", Severity.Success);
                }

                return;
            }

            await Js.InvokeVoidAsync("wslcAgent.download", "wslc-style.json", json, "application/json");
            Snackbar.Add("Look exported as wslc-style.json", Severity.Success);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or IOException)
        {
            Snackbar.Add($"The look could not be written: {ex.Message}", Severity.Error);
        }
    }

    /// <summary>
    /// A look read from a file lands in the fields, not on the screens: it is a
    /// draft like any other, so it is looked at and tried with Apply before it
    /// becomes what the application shows.
    /// </summary>
    private async Task ImportStyleAsync(IBrowserFile? file)
    {
        if (file is null)
        {
            return;
        }

        try
        {
            using var reader = new StreamReader(file.OpenReadStream(64 * 1024));
            var json = await reader.ReadToEndAsync();
            if (System.Text.Json.JsonSerializer.Deserialize<UiStyleValues>(json) is { } values)
            {
                Style.Use(values);
                Snackbar.Add($"{file.Name} read — Apply to see it, Save to keep it", Severity.Success);
                StateHasChanged();
                return;
            }

            Snackbar.Add($"{file.Name} holds no look", Severity.Warning);
        }
        catch (Exception ex) when (ex is System.Text.Json.JsonException or IOException)
        {
            Snackbar.Add($"{file.Name} could not be read: {ex.Message}", Severity.Error);
        }
    }

    private string StyleJson() =>
        System.Text.Json.JsonSerializer.Serialize(
            Style.Draft,
            new System.Text.Json.JsonSerializerOptions { WriteIndented = true });

    private async Task CopyStyleAsync()
    {
        var json = StyleJson();
        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", json);
            Snackbar.Add("The look is on the clipboard, for wslc-style.json", Severity.Success);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException)
        {
            // No clipboard (an insecure origin, a locked-down web view): the
            // values are still readable in the fields themselves.
            Snackbar.Add("This browser would not give the clipboard", Severity.Warning);
        }
    }

    private async Task ResetAsync()
    {
        await Style.ResetAsync();
        StateHasChanged();
    }
    private LoginStatus? _status;
    private string _username = "";
    private string _password = "";
    private string _confirm = "";
    private string? _newToken;
    private bool _busy;
    private McpStatus? _mcp;
    private bool _mcpBusy;
    private AgentUpdateStatus? _update;
    private bool _updateBusy;
    private string _skillClient = "Hermes";
    private string _hermesProfile = "";
    private bool _skillRemote;
    private string _skillSsh = "";
    private SkillInstallResult? _skillRun;

    private bool Mismatch => _confirm.Length > 0 && _confirm != _password;

    /// <summary>What a client would find at that URL right now, in one line.</summary>
    private string McpStateText => _mcp switch
    {
        null => "",
        { Settings.Enabled: false } => "not served — clients are told it is switched off",
        { Settings.AllowDestructiveTools: false } => $"serving {_mcp.Tools} tools, the destructive ones hidden",
        _ => $"serving {_mcp.Tools} tools, the destructive ones included",
    };

    protected override async Task OnInitializedAsync()
    {
        Changes.Changed += OnAgentChanged;
        Changes.Start();
        await LoadAsync();
        await ReadUpdateAsync();
        await AskTheMachineAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _status = await Api.GetLoginStatusAsync();
            _username = _status.Username;
        }
        catch (Exception ex) when (ex is AgentApiException or HttpRequestException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }

        try
        {
            // The address this page was opened at is one that reaches the agent
            // from outside it, which the agent's own loopback is not: a client's
            // installer refuses a 127.0.0.1 URL (Hermes blocks it as unsafe), so
            // the lines are written with the address you are reading this from.
            _mcp = await Api.GetMcpSettingsAsync(PageAddress());

            // Start on a client this machine actually has, so the common case is
            // one press; the rest are a choice away.
            if (_mcp.SkillTargets.FirstOrDefault(target => target.ClientFound) is { } found
                && _mcp.SkillCommands.Any(command => found.Client.StartsWith(command.Client, StringComparison.Ordinal)))
            {
                _skillClient = _mcp.SkillCommands.First(command => found.Client.StartsWith(command.Client, StringComparison.Ordinal)).Client;
            }
        }
        catch (Exception ex) when (ex is AgentApiException or HttpRequestException)
        {
            Snackbar.Add($"MCP server: {ex.Message}", Severity.Error);
        }
    }

    private async Task SaveLoginAsync()
    {
        _busy = true;
        try
        {
            await Api.SetLoginCredentialsAsync(_username.Trim(), _password);
            Snackbar.Add($"Internet login saved for {_username.Trim()}", Severity.Success);
            _password = "";
            _confirm = "";
            await LoadAsync();
        }
        catch (Exception ex) when (ex is AgentApiException or HttpRequestException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RenewTokenAsync()
    {
        _busy = true;
        try
        {
            _newToken = (await Api.RenewApiTokenAsync()).Token;
            await LoadAsync();
        }
        catch (Exception ex) when (ex is AgentApiException or HttpRequestException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Saved on the agent at once, so it stays as left across reloads and restarts.</summary>
    private async Task SimulateRemoteAsync(bool on)
    {
        try
        {
            Simulated.Enabled = (await Api.SetTestingSettingsAsync(new TestingSettings(on))).SimulateRemote;
            Snackbar.Add(on ? "Simulating remote access" : "Remote access simulation off", Severity.Success);
        }
        catch (Exception ex) when (ex is AgentApiException or HttpRequestException)
        {
            Snackbar.Add($"Testing: {ex.Message}", Severity.Error);
        }
    }

    /// <summary>Saved on the agent and in force at once: the next call a client makes already obeys it.</summary>
    private async Task SaveMcpAsync(McpSettings settings)
    {
        _mcpBusy = true;
        try
        {
            _mcp = await Api.SetMcpSettingsAsync(settings);
            Snackbar.Add(Saved(_mcp.Settings), Severity.Success);
        }
        catch (Exception ex) when (ex is AgentApiException or HttpRequestException)
        {
            Snackbar.Add($"MCP server: {ex.Message}", Severity.Error);
        }
        finally
        {
            _mcpBusy = false;
        }

        static string Saved(McpSettings settings) => settings switch
        {
            { Enabled: false } => "MCP server off",
            { AllowDestructiveTools: true } => "Destructive tools offered, each one still asking for your approval",
            _ => "Destructive tools hidden",
        };
    }

    /// <summary>What the Update tab says the agent is at, and what it will do.</summary>
    private string UpdateStateText => _update switch
    {
        null => "",
        { Installed: false } => $"{_update.Version}, a development build: no installer replaces it",
        { AvailableVersion.Length: 0 } => $"{_update.Version}; there is no agent installer in {_update.PackageFolder}: put a newer wslc-ai-agent.msi there to update",
        { Newer: false } => $"{_update.Version}, up to date (the installer there is {_update.AvailableVersion})",
        { State: AgentUpdateState.Waiting } => $"{_update.Version}; {_update.AvailableVersion} waits for {_update.InFlight} transfer{(_update.InFlight == 1 ? "" : "s")} to finish",
        { State: AgentUpdateState.Announced } => $"{_update.Version}; {_update.AvailableVersion} is about to install, and every client can cancel it",
        { State: AgentUpdateState.Installing } => $"updating to {_update.AvailableVersion}",
        { Settings.AutoUpdate: true } => $"{_update.Version}; {_update.AvailableVersion} is there and installs on its own",
        _ => $"{_update.Version}; {_update.AvailableVersion} is there, waiting for Update now",
    };

    /// <summary>The agent says when its update changes state, from whichever client: the tab follows.</summary>
    private void OnAgentChanged(ChangeNotice notice)
    {
        if (notice.Touches(ChangeNotice.AgentUpdate))
        {
            _ = InvokeAsync(ReadUpdateAsync);
        }
    }

    private Task ReadUpdateAsync() => AskUpdateAsync(() => Api.GetAgentUpdateAsync(), done: null);

    private Task SaveUpdateAsync(bool on) =>
        AskUpdateAsync(() => Api.SetAgentUpdateSettingsAsync(_update!.Settings with { AutoUpdate = on }), on ? "Auto update on" : "Auto update off: only Update now installs");

    /// <summary>The package folder as typed, apart from the one saved, so a refresh from the agent does not overwrite what is being typed.</summary>
    private string _packageFolder = "";

    private bool PackageFolderChanged => _update is not null && _packageFolder.Trim() != (_update.Settings.PackageFolder ?? "");

    private async Task PickPackageFolderAsync()
    {
        if (await Pickers.HostFolderAsync(Dialogs, _packageFolder.Length > 0 ? _packageFolder : _update?.PackageFolder ?? "") is { } folder)
        {
            _packageFolder = folder;
        }
    }

    private Task SavePackageFolderAsync() =>
        AskUpdateAsync(() => Api.SetAgentUpdateSettingsAsync(_update!.Settings with { PackageFolder = _packageFolder.Trim() }),
            _packageFolder.Trim().Length > 0 ? $"Package folder: {_packageFolder.Trim()}" : "Package folder: the one the agent was installed with");

    private Task UpdateNowAsync() =>
        AskUpdateAsync(() => Api.UpdateAgentAsync(), "The agent updates itself as soon as nothing is being transferred");

    private Task CancelUpdateAsync() =>
        AskUpdateAsync(() => Api.CancelAgentUpdateAsync(), "Update cancelled");

    /// <summary>One call to the agent's update, its answer shown, its failure said; <paramref name="done"/> is what a success says, or null to say nothing.</summary>
    private async Task AskUpdateAsync(Func<Task<AgentUpdateStatus>> call, string? done)
    {
        _updateBusy = true;
        try
        {
            var typing = PackageFolderChanged;
            _update = await call();
            if (!typing)
            {
                _packageFolder = _update.Settings.PackageFolder ?? "";
            }
            if (done is not null)
            {
                Snackbar.Add(done, Severity.Success);
            }
        }
        catch (Exception ex) when (ex is AgentApiException or HttpRequestException)
        {
            Snackbar.Add($"Agent update: {ex.Message}", Severity.Error);
        }
        finally
        {
            _updateBusy = false;
            StateHasChanged();
        }
    }

    public void Dispose() => Changes.Changed -= OnAgentChanged;

    /// <summary>The clients that machine has, once it has been asked.</summary>
    private IReadOnlyList<SkillClient> _clients = [];

    /// <summary>The profiles of the chosen client on the chosen machine, if it reported any.</summary>
    private IReadOnlyList<string>? Profiles =>
        _clients.FirstOrDefault(client => client.Client == _skillClient)?.Profiles;

    /// <summary>Says in the list which clients that machine actually has.</summary>
    private string Found(string client) =>
        _clients.Count == 0 ? "" : _clients.Any(found => found.Client == client && found.Found) ? "" : " — not there";

    private async Task MachineChangedAsync(bool remote)
    {
        _skillRemote = remote;

        // A destination the machine already knows, so picking "another machine"
        // is one press and not a connection to remember.
        if (remote && _skillSsh.Length == 0 && _mcp?.SshHosts.FirstOrDefault() is { } known)
        {
            _skillSsh = known;
        }

        await AskTheMachineAsync();
    }

    private async Task SshChangedAsync(string destination)
    {
        _skillSsh = destination;
        await AskTheMachineAsync();
    }

    /// <summary>
    /// Asks the machine that will run the install what it has: the same client
    /// lives here and on the VPS, and only that machine knows its profiles.
    /// </summary>
    private async Task AskTheMachineAsync()
    {
        if (_skillRemote && _skillSsh.Trim().Length == 0)
        {
            _clients = [];
            return;
        }

        try
        {
            _clients = await Api.GetSkillClientsAsync(_skillRemote ? _skillSsh.Trim() : "");
            if (_clients.FirstOrDefault(client => client.Found) is { } first && !Has(_skillClient))
            {
                _skillClient = first.Client;
            }

            if (Profiles is { } profiles && _hermesProfile.Length > 0 && !profiles.Contains(_hermesProfile))
            {
                _hermesProfile = "";
            }
        }
        catch (Exception ex) when (ex is AgentApiException or HttpRequestException)
        {
            _clients = [];
            Snackbar.Add($"Skill: {ex.Message}", Severity.Error);
        }

        bool Has(string client) => _clients.Any(found => found.Client == client && found.Found);
    }

    /// <summary>
    /// The origin this page was served from, when it is not the agent's own
    /// loopback: opened through the public name, that name is an address other
    /// machines can fetch the skill from. Opened at 127.0.0.1 it says nothing,
    /// and the agent's own address stands.
    /// </summary>
    private string PageAddress()
    {
        var origin = new Uri(Navigation.BaseUri).GetLeftPart(UriPartial.Authority);
        return new Uri(origin).IsLoopback ? "" : origin;
    }

    /// <summary>The agent writes the lines, so a different address means asking it again.</summary>
    private async Task AddressChangedAsync(string address)
    {
        try
        {
            _mcp = await Api.GetMcpSettingsAsync(address.Trim());
        }
        catch (Exception ex) when (ex is AgentApiException or HttpRequestException)
        {
            Snackbar.Add($"MCP server: {ex.Message}", Severity.Error);
        }
    }

    /// <summary>
    /// A Hermes profile is its own command (<c>alex skills install …</c> installs
    /// into alex), so naming one only swaps the first word of the line.
    /// </summary>
    private string ProfileCommand(string command) =>
        _skillClient == "Hermes" && _hermesProfile.Trim() is { Length: > 0 } profile
            ? profile + command["hermes".Length..]
            : command;

    /// <summary>
    /// Runs that client's own installer and shows what it answered. Nothing is
    /// copied: the client records the skill the way it records any other.
    /// </summary>
    private async Task InstallSkillAsync()
    {
        _mcpBusy = true;
        _skillRun = null;
        try
        {
            _skillRun = await Api.InstallMcpSkillAsync(new SkillInstallRequest(
                _skillClient, _mcp?.SkillAddress ?? "", _hermesProfile.Trim(), _skillRemote ? _skillSsh.Trim() : ""));
            Snackbar.Add(
                _skillRun.Ok ? $"{_skillClient}: skill installed" : $"{_skillClient}: it did not install — read what it answered",
                _skillRun.Ok ? Severity.Success : Severity.Error);
            _mcp = await Api.GetMcpSettingsAsync(_mcp?.SkillAddress ?? "");
        }
        catch (Exception ex) when (ex is AgentApiException or HttpRequestException)
        {
            Snackbar.Add($"Skill: {ex.Message}", Severity.Error);
        }
        finally
        {
            _mcpBusy = false;
        }
    }

    /// <summary>The agent hands out its own copy, so the file is never older than the tools.</summary>
    private void DownloadSkill() => Navigation.NavigateTo(Api.McpSkillDownloadUrl().ToString(), forceLoad: true);

    private Task CopyMcpUrlAsync() => CopyAsync(_mcp?.LocalUrl ?? "", "MCP URL copied");

    private Task CopyTokenAsync() => CopyAsync(_newToken ?? "", "API token copied");

    /// <summary>One clipboard for every copy on this page, each saying what it did.</summary>
    private async Task CopyAsync(string text, string said)
    {
        await Js.InvokeVoidAsync("navigator.clipboard.writeText", text);
        Snackbar.Add(said, Severity.Success);
    }
}
