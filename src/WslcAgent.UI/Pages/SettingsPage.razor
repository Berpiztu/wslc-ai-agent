                <LayoutRow Title="Cards" Fixed="A row in cards view, on every list page (EntityCard)" Changed="StateHasChanged" Reset="ResetCards">
                    <Properties>
                        <PropNumber Label="Elevation" Min="0" Max="24" @bind-Value="Style.Draft.CardElevation" />
                        <PropToggle Label="Outlined" @bind-Value="Style.Draft.CardOutlined" />
