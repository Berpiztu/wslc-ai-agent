@page "/settings"
@inject WslcAgentApi Api
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@using Microsoft.JSInterop
@inject IJSRuntime Js
@inject SimulatedRemote Simulated
@inject NavigationManager Navigation
@inject WslcAgent.UI.Components.Styles.UiStyle Style
@inject WslcAgent.UI.Files.IClientFiles Files
@inject AgentChanges Changes
@implements IDisposable
@using WslcAgent.UI.Components.Styles

@* Settings, beginning with the Internet login card: the username and
   password asked by the sign-in screen of anyone outside the agent's machine
   (the native clients sign in with the same pair), and the API token for
   scripts and AI agents. A native client also finds its "This client" card here, the
   agents it can talk to. Saved logins keeps the logins the host browser pane offers, and Testing can
   make this client behave as a remote one. *@
<PageShell Title="Settings">
    @* Six subjects, six tabs: who may reach the agent
       (Security), a container port on a public name (Publish), the MCP server and
       its skill (MCP), the agent updating itself (Update), what the person's own devices keep — the agents a client
       knows, the saved logins, the testing switch (User) — and what the
       application looks like (Layout). What is chosen in Layout is not a
       sample, it is the application; Apply puts it on every screen without writing it down, so the
       person can walk through the app, see it in place and come back here to
       carry on; Save is what makes this device open that way tomorrow. The tab
       is in the address, so Back returns to the one left. *@
    <MudTabs Elevation="Style.Applied.TabsElevation" Rounded="Style.Applied.TabsRounded" Border="Style.Applied.TabsBorder"
             Centered="Style.Applied.TabsCentered"
             MinimumTabWidth="@($"{Style.Applied.TabsMinWidth}px")"
             TabPanelsClass="wslc-tab-panels" Class="wslc-fill" ActivePanelIndex="_tab" ActivePanelIndexChanged="OnTabChanged">
        <MudTabPanel Text="Security">
            <div class="wslc-fill-scroll">
        @if (_status is null)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else if (!_status.Configured)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3">
                <b>Internet login not set.</b> The public address will not sign in until this agent has a username and password.
                On the agent's machine this page opens without a login.
            </MudAlert>
        }
        @* Every card is a subject of its own, so they stand side by side while the
           window has room for them — the login beside its token, saved logins
           beside testing, the MCP server beside its skill — and fall into one
           column on a phone. The pairs are the order they are written in. *@
        <div class="wslc-settings-grid">
            @if (_status is not null)
            {
            <MudPaper Outlined="true" Class="pa-4">
                <MudText Typo="Typo.h6">Internet login</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
                    Username and password asked by the sign-in screen when the agent is opened from anywhere but its own machine,
                    through the public address or the LAN. The native clients sign in with the same pair. Saved in the agent's data
                    folder (the password only as a hash) and active immediately; changing the password signs everyone out.
                </MudText>
                <MudText Typo="Typo.body2" Class="mb-2">Now: <b>@(_status.Configured ? $"{_status.Username} (configured)" : "not set")</b></MudText>
                <MudTextField T="string" @bind-Value="_username" Label="Username" Variant="Variant.Filled" Margin="Margin.Dense" Immediate="true"
                              HelperTextOnFocus="true" HelperText="Example: admin" autocomplete="off" autocapitalize="none" autocorrect="off" spellcheck="false" />
                <PasswordField @bind-Value="_password" Autocomplete="new-password" Class="mt-2" />
                <PasswordField @bind-Value="_confirm" Label="Confirm password" Autocomplete="new-password" Class="mt-2" Error="@Mismatch" ErrorText="The passwords do not match" />
                <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Save" Class="mt-3"
                           Disabled="@(_busy || _username.Trim().Length == 0 || _password.Length == 0 || Mismatch)" OnClick="SaveLoginAsync">Save login</MudButton>
            </MudPaper>
            <MudPaper Outlined="true" Class="pa-4">
                <MudText Typo="Typo.h6">API token</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
                    For scripts and AI agents that reach the API or the MCP endpoint from another machine: send it as
                    <span class="wslc-mono">Authorization: Bearer &lt;token&gt;</span>. It is shown once; a new one replaces the old.
                </MudText>
                <MudText Typo="Typo.body2" Class="mb-2">Now: <b>@(_status.ApiToken ? "configured" : "not set — only this machine and signed-in clients can connect")</b></MudText>
                @if (_newToken is not null)
                {
                    <div class="wslc-field-pick">
                        <MudTextField T="string" Value="_newToken" Label="New API token" ReadOnly="true" Variant="Variant.Filled" Margin="Margin.Dense" Class="wslc-mono" />
                        <MudFab Color="Color.Info" StartIcon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" title="Copy the token" OnClick="CopyTokenAsync" />
                    </div>
                }
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Key" Class="mt-3" Disabled="_busy" OnClick="RenewTokenAsync">
                    @(_status.ApiToken ? "Replace token" : "Create token")
                </MudButton>
            </MudPaper>
            }
        </div>
            </div>
        </MudTabPanel>
        <MudTabPanel Text="Publish">
            @* One frame over the whole tab: the published names take the height the fields leave. *@
            <div class="wslc-fill-scroll wslc-frame-page">
                <PublishingCard />
            </div>
        </MudTabPanel>
        <MudTabPanel Text="MCP">
            <div class="wslc-fill-scroll">
        <div class="wslc-settings-grid">
        @* MCP server: the URL a client
           registers, what it would find there, and the two switches the operator
           has. Both are saved on the agent and in force on the next call — no
           restart; a client that caches its tool list sees the change on its
           next session. *@
        <MudPaper Outlined="true" Class="pa-4">
            <MudText Typo="Typo.h6">MCP server</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
                The agent serves MCP itself for AI clients (Claude Code, Hermes, OpenClaw): they register the URL below and
                copy the skill, nothing else is installed. On this machine the URL needs no credentials; from anywhere else a
                client sends <span class="wslc-mono">Authorization: Bearer &lt;token&gt;</span>, the API token above.
                Skill and client setup: <span class="wslc-mono">mcp-skill/skills/wslc/INSTALL.md</span>.
            </MudText>
            @if (_mcp is null)
            {
                <MudProgressLinear Indeterminate="true" />
            }
            else
            {
                <div class="wslc-field-pick mb-2">
                    <MudTextField T="string" Value="_mcp.LocalUrl" Label="Local URL" ReadOnly="true" Variant="Variant.Filled" Margin="Margin.Dense" Class="wslc-mono" />
                    <MudFab Color="Color.Info" StartIcon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" title="Copy the URL" OnClick="CopyMcpUrlAsync" />
                </div>
                <MudText Typo="Typo.body2" Class="mb-2">
                    Now: <b>@McpStateText</b>
                </MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Off, the endpoint answers every client that it is switched off and offers no tool at all.
                </MudText>
                <MudSwitch T="bool" Value="_mcp.Settings.Enabled" ValueChanged="@(on => SaveMcpAsync(_mcp.Settings with { Enabled = on }))"
                           Label="Serve MCP" LabelPlacement="Placement.Start" Color="Color.Primary" Disabled="_mcpBusy" />
                <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">
                    <b>remove_container</b>, <b>kill_container</b>, <b>exec_in_container</b>, <b>stop_session</b>, the remove and prune tools and <b>publish_container_port</b>
                    (@_mcp.DestructiveTools of the @(_mcp.Tools + (_mcp.Settings is { Enabled: true, AllowDestructiveTools: false } ? _mcp.DestructiveTools : 0)) tools).
                    Off, they are not even listed, so no assistant can offer them. On, each one still needs your approval twice:
                    the first call only describes what it would do and the assistant has to ask you before calling again.
                </MudText>
                <MudSwitch T="bool" Value="_mcp.Settings.AllowDestructiveTools" ValueChanged="@(on => SaveMcpAsync(_mcp.Settings with { AllowDestructiveTools = on }))"
                           Label="Offer the destructive tools" LabelPlacement="Placement.Start" Color="Color.Warning" Disabled="@(_mcpBusy || !_mcp.Settings.Enabled)" />
            }
        </MudPaper>
        @* The skill: the file a client has to hold to know how to use these tools.
           It travels inside the agent, so what this card installs always matches
           the tools this agent serves — and it installs it by running that
           client's own command, here or where the client is. *@
        <MudPaper Outlined="true" Class="pa-4">
            <MudText Typo="Typo.h6">Skill</MudText>
            @if (_mcp is null)
            {
                <MudProgressLinear Indeterminate="true" />
            }
            else
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
                    An AI client needs this file (<span class="wslc-mono">SKILL.md</span>) to know which tool to use for what, how to
                    resolve names, and that a destructive action is never taken without asking you. The agent carries its own copy, so
                    what you install here always matches the tools this agent serves. Use the client's own installer where there is
                    one — it scans and records the skill the way that client expects.
                </MudText>
                @if (_mcp.SkillCommands.FirstOrDefault(c => c.Client == _skillClient) is { } command)
                {
                    <div class="wslc-field-pick">
                        <MudTextField T="string" Value="@ProfileCommand(command.Command)" Label="@($"Run on the machine where {_skillClient} is")" ReadOnly="true"
                                      Variant="Variant.Filled" Margin="Margin.Dense" Class="wslc-mono" />
                        <MudFab Color="Color.Info" StartIcon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" title="Copy the command"
                                OnClick="@(() => CopyAsync(ProfileCommand(command.Command), "Install command copied"))" />
                    </div>
                }
@* One line: which client, which of its profiles, and the address that machine
                   reaches this agent by — the same client can be here and on the VPS, and
                   there this agent is not 127.0.0.1. *@
                <div class="wslc-skill-row mt-2">
                    <MudSelect T="bool" Value="_skillRemote" ValueChanged="MachineChangedAsync" Label="Machine"
                               Variant="Variant.Filled" Margin="Margin.Dense" Dense="true" Class="wslc-skill-pick">
                        <MudSelectItem T="bool" Value="false">This one</MudSelectItem>
                        <MudSelectItem T="bool" Value="true">Another, over SSH</MudSelectItem>
                    </MudSelect>
                    @if (_skillRemote)
                    {
                        @* Filled with a machine this one already knows how to reach —
                           its SSH config has the user, the port and any jump — and the
                           menu holds the rest. Typed only when it is somewhere new. *@
                        <div class="wslc-field-pick wslc-skill-wide">
                            <MudTextField T="string" Value="@_skillSsh" ValueChanged="SshChangedAsync" Label="SSH destination"
                                          Variant="Variant.Filled" Margin="Margin.Dense" Class="wslc-mono"
                                          HelperTextOnFocus="true" HelperText="A host of this machine's SSH config, or user@host"
                                          autocomplete="off" autocapitalize="none" autocorrect="off" spellcheck="false" />
                            <MudMenu Icon="@Icons.Material.Filled.Dns" Size="Size.Small" Dense="true" title="Machines this one can reach"
                                     Color="Color.Info" Variant="Variant.Filled" Disabled="@(_mcp.SshHosts.Count == 0)">
                                @foreach (var host in _mcp.SshHosts)
                                {
                                    <MudMenuItem OnClick="@(() => SshChangedAsync(host))">@host</MudMenuItem>
                                }
                            </MudMenu>
                        </div>
                    }
                    <MudTextField T="string" Value="@_mcp.SkillAddress" ValueChanged="AddressChangedAsync" Label="Agent address from there"
                                  Variant="Variant.Filled" Margin="Margin.Dense" Class="wslc-mono wslc-skill-wide"
                                  HelperTextOnFocus="true" HelperText="As that machine reaches it"
                                  autocomplete="off" autocapitalize="none" autocorrect="off" spellcheck="false" />
                </div>
                @* Which client, and which of its profiles: what that machine
                   answered it has, not what this one holds. *@
                <div class="wslc-skill-row mt-2">
                    <MudSelect T="string" Value="_skillClient" ValueChanged="@(client => _skillClient = client)" Label="Client"
                               Variant="Variant.Filled" Margin="Margin.Dense" Dense="true" Class="wslc-skill-pick">
                        @foreach (var client in _mcp.SkillCommands)
                        {
                            <MudSelectItem T="string" Value="@client.Client">@(client.Client + Found(client.Client))</MudSelectItem>
                        }
                    </MudSelect>
                    @if (Profiles is { Count: > 0 } profiles)
                    {
                        <MudSelect T="string" Value="_hermesProfile" ValueChanged="@(profile => _hermesProfile = profile)" Label="Profile"
                                   Variant="Variant.Filled" Margin="Margin.Dense" Dense="true" Class="wslc-skill-pick">
                            <MudSelectItem T="string" Value="@("")">default</MudSelectItem>
                            @foreach (var profile in profiles)
                            {
                                <MudSelectItem T="string" Value="@profile">@profile</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    else if (_skillClient == "Hermes")
                    {
                        <MudTextField @bind-Value="_hermesProfile" Label="Profile" Variant="Variant.Filled" Margin="Margin.Dense" Immediate="true"
                                      Class="wslc-skill-word" HelperTextOnFocus="true" HelperText="Its own command"
                                      autocomplete="off" autocapitalize="none" autocorrect="off" spellcheck="false" />
                    }
                </div>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">
                    @(_mcp.SkillCommands.FirstOrDefault(c => c.Client == _skillClient)?.Note)
                </MudText>
                @* The same client can be here and elsewhere: Hermes runs on this
                   machine and on the VPS. Either way the agent runs that client's
                   own installer — on this machine through its shell, on another
                   over ssh with the keys of the account the agent runs as. *@

                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mt-3">
                    <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Terminal"
                               Disabled="@(_mcpBusy || (_skillRemote && _skillSsh.Trim().Length == 0))" OnClick="InstallSkillAsync">Run the install</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download" OnClick="DownloadSkill">Download SKILL.md</MudButton>
                </MudStack>
                @if (_skillRun is { } run)
                {
                    <MudAlert Severity="@(run.Ok ? Severity.Success : Severity.Error)" Class="mt-3" Dense="true">
                        <div class="wslc-mono">@run.Command</div>
                        <div class="wslc-mono">@run.Output</div>
                    </MudAlert>
                }
            }
        </MudPaper>
        </div>
            </div>
        </MudTabPanel>
        <MudTabPanel Text="Update">
            <div class="wslc-fill-scroll">
        <div class="wslc-settings-grid">
            @* The agent updating itself: the switch
               and the button live here, and the countdown an automatic update
               announces is on every client (AgentUpdateWatcher). *@
            <MudPaper Outlined="true" Class="pa-4">
                <MudText Typo="Typo.h6">Agent update</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
                    The agent updates itself from its installer, <span class="wslc-mono">wslc-ai-agent.msi</span>, in the folder the
                    clients' installers are served from: copying a newer one there is the whole deployment. It waits for file transfers
                    and backups to finish, since it would cut them, and stops for a moment while the installer runs. With Auto update on,
                    every client is told a minute before — and every device that gets notifications, with Cancel update on the
                    notification itself — and any of them can cancel it.
                </MudText>
                @if (_update is null)
                {
                    <MudProgressLinear Indeterminate="true" />
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="mb-2">Now: <b>@UpdateStateText</b></MudText>
                    <MudSwitch T="bool" Value="_update.Settings.AutoUpdate" ValueChanged="SaveUpdateAsync"
                               Label="Auto update" LabelPlacement="Placement.Start" Color="Color.Primary" Disabled="_updateBusy" />
                    @* Empty is the folder the agent was installed with, shown as the placeholder. *@
                    <div class="wslc-field-pick has-note mt-3">
                        <MudTextField T="string" @bind-Value="_packageFolder" Label="Package folder" Placeholder="@_update.AutomaticPackageFolder"
                                      Immediate="true" Variant="Variant.Filled" Margin="Margin.Dense" Class="wslc-mono" Disabled="_updateBusy"
                                      HelperTextOnFocus="true" HelperText="Where newer installers of the agent and its clients are put; empty for the folder it was installed with. Created if missing."
                                      autocapitalize="none" autocorrect="off" spellcheck="false" />
                        <MudFab Color="Color.Success" StartIcon="@Icons.Material.Filled.MoreVert" Size="Size.Small" title="Pick a folder" OnClick="PickPackageFolderAsync" Disabled="_updateBusy" />
                    </div>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Save" Class="mt-2"
                               Disabled="@(_updateBusy || !PackageFolderChanged)" OnClick="SavePackageFolderAsync">Save folder</MudButton>
                    <MudStack Row="true" Spacing="2" Class="mt-3">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.SystemUpdateAlt"
                                   Disabled="@(_updateBusy || !_update.Installed || !_update.Newer || _update.State == AgentUpdateState.Installing)"
                                   OnClick="UpdateNowAsync">Update now</MudButton>
                        @if (_update.State is AgentUpdateState.Announced or AgentUpdateState.Waiting)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="_updateBusy" OnClick="CancelUpdateAsync">Cancel</MudButton>
                        }
                    </MudStack>
                    @if (_update.LastResult.Length > 0)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">Last update: @_update.LastResult</MudText>
                    }
                }
            </MudPaper>
        </div>
            </div>
        </MudTabPanel>
        <MudTabPanel Text="Notifications">
            <div class="wslc-fill-scroll">
        <div class="wslc-settings-grid">
            <NotificationsCard />
        </div>
            </div>
        </MudTabPanel>
        <MudTabPanel Text="User">
            <div class="wslc-fill-scroll">
        <div class="wslc-settings-grid">
            <ClientServersCard />
            <SavedLoginsCard />
            <MudPaper Outlined="true" Class="pa-4">
                <MudText Typo="Typo.h6">Testing</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
                    Try what a client on another machine gets without leaving this one: Open with browser opens the host browser
                    window (with its bar and the saved logins) instead of a new tab. Kept on the agent: it stays on until you
                    switch it off.
                </MudText>
                <MudSwitch T="bool" Value="Simulated.Enabled" ValueChanged="SimulateRemoteAsync" Label="Simulate remote access" LabelPlacement="Placement.Start" Color="Color.Warning" />
            </MudPaper>
        </div>
            </div>
        </MudTabPanel>
        <MudTabPanel Text="Layout">
            <div class="wslc-fill-scroll pa-2">
                <MudAlert Severity="@(Style.HasUnsaved ? Severity.Warning : Severity.Normal)" Dense="true" Class="mb-2">
                    @StyleState
                </MudAlert>

<LayoutRow Title="Text" Fixed="The four the application uses: titles, default, secondary and overline (docs/RULES.md)" Changed="StateHasChanged" Reset="ResetText">
                    <Properties>
                        <PropSelect T="Typo" Label="Titles (h6)" @bind-Value="Style.Draft.TitleTypo" />
                        <PropSelect T="Typo" Label="Default text (body1)" @bind-Value="Style.Draft.DefaultTypo" />
                        <PropSelect T="Typo" Label="Table rows (body2)" @bind-Value="Style.Draft.TableTypo" />
                        <PropSelect T="Typo" Label="Secondary (caption, subtitle2)" @bind-Value="Style.Draft.SecondaryTypo" />
                        <PropSelect T="Typo" Label="Overline" @bind-Value="Style.Draft.OverlineTypo" />
                    </Properties>
                    <Control>
                        @* Each line is the role itself, drawn with the standard it has
                           been given: the size, the weight, the line and the letter
                           spacing travel together. *@
                        <div style="@DraftVars">
                            <MudText Typo="Typo.h6">A page title</MudText>
                            <MudText Typo="Typo.body1">The default text a screen is written in</MudText>
                            <MudText Typo="Typo.body2">A table row: web · nginx:1.27 · running</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Secondary text, under a value</MudText>
                            <MudText Typo="Typo.overline">OVERLINE</MudText>
                        </div>
                    </Control>
                </LayoutRow>

                <LayoutRow Title="Table rows" Fixed="Every list page at once: containers, images, volumes, networks" Changed="StateHasChanged" Reset="ResetRows">
                    <Properties>
                        <PropToggle Label="Dense" @bind-Value="Style.Draft.GridDense" />
                        <PropToggle Label="Striped" @bind-Value="Style.Draft.GridStriped" />
                        <PropToggle Label="Bordered" @bind-Value="Style.Draft.GridBordered" />
                        <PropToggle Label="Hover" @bind-Value="Style.Draft.GridHover" />
                        <PropToggle Label="Outlined" @bind-Value="Style.Draft.GridOutlined" />
                        <PropToggle Label="Fixed header" @bind-Value="Style.Draft.GridFixedHeader" />
                        <PropNumber Label="Elevation" Min="0" Max="24" @bind-Value="Style.Draft.GridElevation" />
                        <PropNumber Label="Left of a cell (px)" Min="0" Max="40" @bind-Value="Style.Draft.RowPadStart" />
                        <PropNumber Label="Right of a cell (px)" Min="0" Max="40" @bind-Value="Style.Draft.RowPadEnd" />
                        <PropNumber Label="Action glyphs (px)" Min="10" Max="32" @bind-Value="Style.Draft.ActionIconSize" />
                        <PropNumber Label="Room around each action (px)" Min="0" Max="12" @bind-Value="Style.Draft.ActionPadding" />
                    </Properties>
                    <Control>
                        @* The sample carries the draft in its own variables, so a row
                           is seen at the height it would have before the whole
                           application is put at it. *@
                        @* Written as a list is written, or the row rules would not
                           reach it: they name a table inside .wslc-fill, and the
                           actions are what the glyph and the room around it are for. *@
                        <div class="wslc-fill" style="@DraftVars">
                            <MudSimpleTable Dense="Style.Draft.GridDense" Striped="Style.Draft.GridStriped" Bordered="Style.Draft.GridBordered" Hover="Style.Draft.GridHover" Outlined="Style.Draft.GridOutlined" Elevation="Style.Draft.GridElevation" Class="mud-table">
                                <thead>
                                    <tr class="mud-table-row"><th class="mud-table-cell"></th><th class="mud-table-cell">Name</th><th class="mud-table-cell">Image</th><th class="mud-table-cell">Actions</th></tr>
                                </thead>
                                <tbody class="mud-table-body">
                                    @foreach (var row in SampleRows)
                                    {
                                        <tr class="mud-table-row">
                                            <td class="mud-table-cell"><MudCheckBox T="bool" Value="false" Size="Size.Small" Dense="true" /></td>
                                            <td class="mud-table-cell">@row.Name</td>
                                            <td class="mud-table-cell">@row.Image</td>
                                            <td class="mud-table-cell">
                                                <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" Color="Color.Success" title="Start" />
                                                <MudIconButton Icon="@Icons.Material.Filled.RestartAlt" Size="Size.Small" Color="Color.Warning" title="Restart" />
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" title="Remove" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        </div>
                    </Control>
                </LayoutRow>

                <LayoutRow Title="Table header row" Fixed="The column titles of every list page at once" Changed="StateHasChanged" Reset="ResetHeader">
                    <Properties>
                        <PropSelect T="Color" Label="Background colour" @bind-Value="Style.Draft.GridHeadColor" />
                        <PropSelect T="Color" Label="Text colour" @bind-Value="Style.Draft.GridHeadTextColor" />
                        <PropNumber Label="Elevation" Min="0" Max="24" @bind-Value="Style.Draft.GridHeadElevation" />
                    </Properties>
                    <Control>
                        <div class="wslc-fill" style="@DraftVars">
                            <MudSimpleTable Dense="Style.Draft.GridDense" Striped="Style.Draft.GridStriped" Bordered="Style.Draft.GridBordered" Outlined="Style.Draft.GridOutlined" Elevation="0" Class="mud-table">
                                <thead class="mud-table-head">
                                    <tr class="mud-table-row"><th class="mud-table-cell">Name</th><th class="mud-table-cell">Image</th></tr>
                                </thead>
