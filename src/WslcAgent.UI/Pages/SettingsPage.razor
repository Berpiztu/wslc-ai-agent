                                            Delimiters="Style.Draft.ToggleDelimiters" Class="@(Style.Draft.ToggleRounded ? "rounded-pill" : null)" CheckMark="Style.Draft.ToggleCheckMark">
                                <MudToggleItem Value="ViewMode.Table"><MudIcon Icon="@Icons.Material.Filled.TableRows" Size="Size.Small" /></MudToggleItem>
                                <MudToggleItem Value="ViewMode.Cards"><MudIcon Icon="@Icons.Material.Filled.GridView" Size="Size.Small" /></MudToggleItem>
