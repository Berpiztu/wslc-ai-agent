                @* What the screen is for, in the end: the look that has been tried
                   goes into wslc-style.json, and from there into every client. *@
                <MudFileUpload T="IBrowserFile" FilesChanged="ImportStyleAsync" Class="ma-0 mt-2 mr-2 d-inline-flex flex-grow-0">
                    <CustomContent>
