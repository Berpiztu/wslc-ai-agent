      },
      {
        "id": "gate",
        "label": "Destructive tools",
        "focus": [
          "tools",
          "gate",
          "clients"
        ],
        "note": "remove, kill, exec, stop session: the client shows a yes/no prompt; without one, a two-call token. Nothing the model passes counts."
      },
      {
        "id": "switches",
        "label": "The operator's switches",
        "focus": [
          "settings",
          "switches",
          "mcp"
        ],
        "note": "Settings → MCP: serve at all, and offer the destructive tools. Read on every request, so a change needs no restart."
      },
      {
        "id": "remote",
        "label": "A client elsewhere",
        "focus": [
          "clients",
          "mcp"
        ],
        "note": "From another machine, a client reaches /api/v1/mcp through a public host's forward (main diagram); at loopback no login is asked."
      }
