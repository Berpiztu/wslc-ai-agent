        "note": "xterm.js in the UI, one WebSocket per shell, a process behind a ConPTY on the agent: the host shell, or wslc exec into a container."
      },
      {
        "id": "protocol",
        "label": "The exec protocol",
        "focus": [
          "clients",
          "exec"
        ],
        "note": "Client → start, stdin, resize, pong, close. Agent → ready (backend, pty), stdout, ping, warning, exit, error."
      },
      {
        "id": "pty",
        "label": "ConPTY or pipes",
        "focus": [
          "exec",
          "conpty",
          "pipes"
        ],
        "note": "Behind a ConPTY the shell sees a terminal: it echoes, draws its prompt, answers a resize. Without one: pipes and a client line editor."
      },
      {
        "id": "sessions",
        "label": "Sessions outlive the page",
        "focus": [
          "registry",
          "clients"
        ],
        "note": "Leaving a page detaches the surface and keeps the shell; the page that comes back takes it over. Close, Log out or the tab closing end it."
      },
      {
        "id": "native",
        "label": "At the agent's machine",
        "focus": [
          "clients",
          "native",
          "process"
        ],
        "note": "Open in terminal starts Windows Terminal, or a console, on the agent's desktop. A remote client is refused and gets the in-app one."
      }
    ]
